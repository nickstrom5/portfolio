---
/**
 * A tour poster generated from the show record. Original artwork — this site
 * reproduces no press photography — drawn deterministically so each date has
 * its own plate that is stable across builds.
 */
import { parts, type Show } from '@/data/tour';
import { legsById } from '@/data/tour';

interface Props {
  show: Show;
  accent: string;
}

const { show, accent } = Astro.props;
const p = parts(show.date);
const leg = legsById[show.leg];
const uid = show.slug;

/** Stable hash of the slug, for the bits of the plate that vary. */
let h = 0;
for (const ch of show.slug) h = (h * 31 + ch.charCodeAt(0)) >>> 0;

const R = 128;
const CX = 300;
const CY = 372;
const tilt = 0.18 + (h % 6) * 0.03;
const meridianCount = 7 + (h % 5);
const ringDash = 2 + (h % 4);

const meridians = Array.from({ length: meridianCount }, (_, i) => {
  const phase = (i / meridianCount) * Math.PI;
  return Math.abs(Math.cos(phase)) * R;
});

const lats = [-60, -40, -20, 0, 20, 40, 60].map((deg) => {
  const a = (deg * Math.PI) / 180;
  return { y: CY - R * Math.sin(a) * 0.88, rx: R * Math.cos(a) };
});

const city = show.city.toUpperCase();
const cityWidth = city.length > 11 ? 500 : 456;
const statusWord =
  show.status === 'cancelled' ? 'CANCELLED' : show.status === 'upcoming' ? 'UPCOMING' : 'PERFORMED';

const DISPLAY = "Archivo, 'Arial Narrow', 'Helvetica Neue', Helvetica, Arial, sans-serif";
const MONO = "'JetBrains Mono', ui-monospace, Menlo, Consolas, monospace";
---

<svg
  viewBox="0 0 600 840"
  role="img"
  aria-label={`Tour plate for ${show.city}, ${p.d} ${p.month} ${p.y} at ${show.venue}`}
>
  <defs>
    <radialGradient id={`pg-${uid}`} cx="50%" cy="42%" r="62%">
      <stop offset="0%" stop-color={accent} stop-opacity="0.18" />
      <stop offset="60%" stop-color={accent} stop-opacity="0.03" />
      <stop offset="100%" stop-color="#000" stop-opacity="0" />
    </radialGradient>
    <linearGradient id={`pb-${uid}`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#101418" />
      <stop offset="55%" stop-color="#0a0c0e" />
      <stop offset="100%" stop-color="#050607" />
    </linearGradient>
    <filter id={`pn-${uid}`} x="0" y="0" width="100%" height="100%">
      <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="3" stitchTiles="stitch" />
      <feColorMatrix type="saturate" values="0" />
    </filter>
  </defs>

  <rect width="600" height="840" fill={`url(#pb-${uid})`} />
  <rect width="600" height="840" fill={`url(#pg-${uid})`} />

  <!-- frame -->
  <rect x="22" y="22" width="556" height="796" fill="none" stroke={accent} stroke-opacity="0.22" />

  <!-- head -->
  <text x="46" y="84" font-family={DISPLAY} font-weight="900" font-size="46" letter-spacing="6" fill="#efece4">YE</text>
  <text x="554" y="74" text-anchor="end" font-family={MONO} font-size="14" letter-spacing="3" fill={accent} fill-opacity="0.85">
    N{'°'} {String(show.n).padStart(2, '0')}
  </text>
  <text x="554" y="96" text-anchor="end" font-family={MONO} font-size="11" letter-spacing="2.4" fill="#767d85">
    LEG {leg?.n} {'—'} {leg?.name.toUpperCase()}
  </text>
  <path d="M46 112 H554" stroke={accent} stroke-opacity="0.3" />
  <text x="46" y="136" font-family={MONO} font-size="11.5" letter-spacing="5.4" fill="#a7aeb6">
    LIVE CONCERT TOUR 2O26 {'·'} BULLY
  </text>

  <!-- globe -->
  <g fill="none" stroke={accent} stroke-width="1">
    <circle cx={CX} cy={CY} r={R} stroke-width="1.8" stroke-opacity="0.9" />
    {lats.map((l) => <ellipse cx={CX} cy={l.y} rx={l.rx} ry={Math.max(l.rx * tilt, 0.6)} stroke-opacity="0.42" />)}
    {meridians.map((rx) => <ellipse cx={CX} cy={CY} rx={Math.max(rx, 0.6)} ry={R} stroke-opacity="0.42" />)}
    <ellipse cx={CX} cy={CY} rx={R + 40} ry={(R + 40) * tilt} stroke-opacity="0.3" />
    <circle cx={CX} cy={CY} r={R + 22} stroke-opacity="0.2" stroke-dasharray={`${ringDash} 12`} />
    <path d={`M46 ${CY} H${CX - R - 58}`} stroke-opacity="0.3" />
    <path d={`M${CX + R + 58} ${CY} H554`} stroke-opacity="0.3" />
  </g>

  {
    show.status === 'cancelled' && (
      <g>
        <path d={`M${CX - R} ${CY - R} L${CX + R} ${CY + R}`} stroke="#6a7178" stroke-width="2" />
        <path d={`M${CX + R} ${CY - R} L${CX - R} ${CY + R}`} stroke="#6a7178" stroke-width="2" />
      </g>
    )
  }

  <!-- date -->
  <text x="300" y="566" text-anchor="middle" font-family={MONO} font-size="15" letter-spacing="7" fill={accent}>
    {p.dd}.{p.mm}.{p.y}
  </text>

  <!-- city -->
  <text
    x="300"
    y="662"
    text-anchor="middle"
    font-family={DISPLAY}
    font-weight="900"
    font-size="86"
    letter-spacing="-2"
    fill="#f4f1ea"
    textLength={cityWidth}
    lengthAdjust="spacingAndGlyphs">{city}</text
  >

  <text x="300" y="694" text-anchor="middle" font-family={MONO} font-size="12.5" letter-spacing="5" fill="#a7aeb6">
    {(show.area ? `${show.area} · ` : '') + show.country.toUpperCase()}
  </text>

  <path d="M46 726 H554" stroke={accent} stroke-opacity="0.3" />

  <text x="46" y="754" font-family={DISPLAY} font-weight="700" font-size="20" fill="#efece4">{show.venue}</text>
  <text x="46" y="782" font-family={MONO} font-size="11.5" letter-spacing="3" fill="#767d85">
    {statusWord} {'·'} {p.day.toUpperCase()} {'·'} {show.capacity ? `CAP ${show.capacity.toLocaleString('en-US')}` : 'CAPACITY N/A'}
  </text>

  <rect width="600" height="840" filter={`url(#pn-${uid})`} opacity="0.045" style="mix-blend-mode:screen" />
</svg>

<style>
  svg {
    width: 100%;
    height: auto;
  }
</style>
