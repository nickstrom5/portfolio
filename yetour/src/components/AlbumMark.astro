---
/**
 * An original square mark for a record. Not the sleeve — this archive does not
 * reproduce cover art — but a generated figure drawn from the record's own
 * palette, one motif per album so the wall of squares reads as a set.
 * No <defs>/ids: sixteen of these share a page.
 */
import type { Record_ } from '@/data/discography';

interface Props {
  record: Record_;
}

const { record } = Astro.props;
const { accent, ink, panel } = record.palette;
const m = record.motif;

let h = 0;
for (const c of record.id) h = (h * 31 + c.charCodeAt(0)) >>> 0;
let s = h || 7;
const rnd = () => {
  s ^= s << 13;
  s ^= s >>> 17;
  s ^= s << 5;
  return ((s >>> 0) % 10000) / 10000;
};

const S = 400;
const bars = Array.from({ length: 9 }, (_, i) => ({ x: 24 + i * 40, w: 8 + rnd() * 24, o: 0.25 + rnd() * 0.75 }));
const dots = Array.from({ length: 240 }, () => ({ x: rnd() * S, y: rnd() * S, r: 0.8 + rnd() * 2.2, o: 0.1 + rnd() * 0.7 }));
const rays = Array.from({ length: 18 }, (_, i) => i * 20 + rnd() * 6);
const ridges = Array.from({ length: 7 }, (_, i) => 150 + i * 34);
const halftone = Array.from({ length: 11 }, (_, i) => 18 + i * 17);
---

<svg viewBox={`0 0 ${S} ${S}`} class="mark" role="img" aria-label={`Generated mark for ${record.title}`}>
  <rect width={S} height={S} fill={panel} />

  {m === 'orb' && (
    <g>
      <circle cx="200" cy="200" r="118" fill={accent} fill-opacity="0.9" />
      <circle cx="200" cy="200" r="150" fill="none" stroke={accent} stroke-opacity="0.35" />
      <circle cx="200" cy="200" r="176" fill="none" stroke={accent} stroke-opacity="0.18" />
      <circle cx="166" cy="168" r="30" fill={panel} fill-opacity="0.85" />
      <path d="M50 330 H350" stroke={ink} stroke-width="6" />
    </g>
  )}

  {m === 'bars' && (
    <g>
      {bars.map((b) => <rect x={b.x} y="40" width={b.w} height="320" fill={accent} fill-opacity={b.o} />)}
      <rect x="0" y="182" width={S} height="36" fill={panel} />
      <rect x="0" y="182" width={S} height="36" fill={ink} fill-opacity="0.35" />
    </g>
  )}

  {m === 'split' && (
    <g>
      <path d={`M0 0 H${S} V${S} Z`} fill={accent} fill-opacity="0.85" />
      <path d={`M0 0 H${S} L0 ${S} Z`} fill={ink} fill-opacity="0.5" />
      <circle cx="200" cy="200" r="66" fill="none" stroke={panel} stroke-width="8" />
    </g>
  )}

  {m === 'grid' && (
    <g>
      {Array.from({ length: 12 }, (_, r) =>
        Array.from({ length: 12 }, (_, c) => (
          <rect x={20 + c * 32} y={20 + r * 32} width="12" height="12" fill={accent} fill-opacity={0.1 + ((r * 12 + c) % 7) * 0.12} />
        )),
      )}
      <rect x="20" y="20" width={S - 40} height={S - 40} fill="none" stroke={accent} stroke-opacity="0.4" />
    </g>
  )}

  {m === 'rays' && (
    <g>
      {rays.map((a) => {
        const rad = (a * Math.PI) / 180;
        return <path d={`M200 200 L${200 + Math.cos(rad) * 260} ${200 + Math.sin(rad) * 260}`} stroke={accent} stroke-opacity="0.35" stroke-width="10" />;
      })}
      <circle cx="200" cy="200" r="74" fill={accent} />
      <circle cx="200" cy="200" r="102" fill="none" stroke={panel} stroke-width="10" />
    </g>
  )}

  {m === 'twin' && (
    <g>
      <circle cx="150" cy="180" r="96" fill={accent} fill-opacity="0.9" />
      <circle cx="252" cy="222" r="96" fill={ink} fill-opacity="0.75" />
      <path d="M40 350 H360" stroke={accent} stroke-width="5" stroke-opacity="0.6" />
      <path d="M40 366 H240" stroke={accent} stroke-width="5" stroke-opacity="0.3" />
    </g>
  )}

  {m === 'scatter' && (
    <g>
      {dots.map((d) => <circle cx={d.x} cy={d.y} r={d.r} fill={accent} fill-opacity={d.o} />)}
      <rect x="86" y="86" width="228" height="228" fill="none" stroke={accent} stroke-opacity="0.55" stroke-width="2" />
      <path d="M86 200 H314 M200 86 V314" stroke={ink} stroke-opacity="0.5" />
    </g>
  )}

  {m === 'frame' && (
    <g>
      {[0, 1, 2, 3, 4].map((i) => (
        <rect x={26 + i * 34} y={26 + i * 34} width={S - 52 - i * 68} height={S - 52 - i * 68} fill="none" stroke={accent} stroke-opacity={0.9 - i * 0.16} stroke-width={3} />
      ))}
      <rect x="180" y="180" width="40" height="40" fill={accent} />
    </g>
  )}

  {m === 'ridge' && (
    <g>
      <rect width={S} height={S} fill={ink} fill-opacity="0.22" />
      {ridges.map((y, i) => (
        <path d={`M-10 ${y} Q100 ${y - 60 - i * 6} 200 ${y} T410 ${y}`} fill="none" stroke={accent} stroke-opacity={0.9 - i * 0.11} stroke-width="3" />
      ))}
      <circle cx="300" cy="96" r="34" fill={accent} fill-opacity="0.85" />
    </g>
  )}

  {m === 'cross' && (
    <g>
      <circle cx="200" cy="200" r="140" fill={ink} fill-opacity="0.45" />
      <path d="M60 60 L340 340 M340 60 L60 340" stroke={accent} stroke-width="14" stroke-linecap="square" />
      <circle cx="200" cy="200" r="52" fill={panel} />
      <circle cx="200" cy="200" r="52" fill="none" stroke={accent} stroke-width="3" />
    </g>
  )}

  {m === 'halftone' && (
    <g>
      {halftone.map((r, i) => <circle cx="200" cy="200" r={r * 1.6} fill="none" stroke={accent} stroke-opacity={0.9 - i * 0.07} stroke-width={1 + i * 0.55} />)}
      <path d="M0 200 H400" stroke={panel} stroke-width="16" />
      <path d="M0 200 H400" stroke={ink} stroke-width="4" />
    </g>
  )}

  {m === 'prism' && (
    <g>
      <path d="M200 52 L344 330 H56 Z" fill={accent} fill-opacity="0.9" />
      <path d="M200 120 L286 296 H114 Z" fill={panel} />
      <path d="M200 176 L246 276 H154 Z" fill={ink} fill-opacity="0.8" />
      <path d="M40 356 H360" stroke={accent} stroke-width="6" />
    </g>
  )}
</svg>

<style>
  .mark {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
