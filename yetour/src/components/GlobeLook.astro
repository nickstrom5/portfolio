---
/**
 * One state of the sphere, drawn. These stand in for the photographs this
 * archive will not reproduce: original vector renderings of the looks the
 * globe actually cycles through across a set.
 */
import type { Look } from '@/data/globe';

interface Props {
  look: Look;
}

const { look } = Astro.props;
const { mode, accent, id } = look;

const R = 138;
const C = 200;

let s = [...id].reduce((a, c) => (a * 31 + c.charCodeAt(0)) >>> 0, 11) || 11;
const rnd = () => {
  s ^= s << 13;
  s ^= s >>> 17;
  s ^= s << 5;
  return ((s >>> 0) % 10000) / 10000;
};

const craters = Array.from({ length: 22 }, () => {
  const a = rnd() * Math.PI * 2;
  const d = Math.sqrt(rnd()) * (R - 16);
  return { x: C + Math.cos(a) * d, y: C + Math.sin(a) * d, r: 3 + rnd() * 13 };
});

const continents = Array.from({ length: 9 }, () => {
  const a = rnd() * Math.PI * 2;
  const d = Math.sqrt(rnd()) * (R - 26);
  return { x: C + Math.cos(a) * d, y: C + Math.sin(a) * d, rx: 16 + rnd() * 40, ry: 10 + rnd() * 26, rot: rnd() * 180 };
});

const lats = [-62, -44, -26, 0, 26, 44, 62].map((deg) => {
  const a = (deg * Math.PI) / 180;
  return { y: C - R * Math.sin(a) * 0.9, rx: R * Math.cos(a) };
});
const mers = Array.from({ length: 9 }, (_, i) => Math.abs(Math.cos((i / 9) * Math.PI)) * R);
const scans = Array.from({ length: 13 }, (_, i) => C - R + 8 + i * ((R * 2 - 16) / 12));
---

<svg viewBox="0 0 400 400" role="img" aria-label={`The globe stage in its "${look.title}" state`}>
  <defs>
    <radialGradient id={`gl-lit-${id}`} cx="34%" cy="28%" r="76%">
      <stop offset="0%" stop-color={accent} stop-opacity="0.95" />
      <stop offset="58%" stop-color={accent} stop-opacity="0.32" />
      <stop offset="100%" stop-color="#000" stop-opacity="0.92" />
    </radialGradient>
    <radialGradient id={`gl-glow-${id}`} cx="50%" cy="50%" r="50%">
      <stop offset="58%" stop-color={accent} stop-opacity="0" />
      <stop offset="84%" stop-color={accent} stop-opacity="0.22" />
      <stop offset="100%" stop-color={accent} stop-opacity="0" />
    </radialGradient>
    <linearGradient id={`gl-term-${id}`} x1="0" y1="0" x2="1" y2="0.3">
      <stop offset="0%" stop-color={accent} stop-opacity="0.95" />
      <stop offset="46%" stop-color={accent} stop-opacity="0.5" />
      <stop offset="58%" stop-color="#05070a" stop-opacity="0.96" />
      <stop offset="100%" stop-color="#020406" stop-opacity="1" />
    </linearGradient>
    <clipPath id={`gl-clip-${id}`}>
      <circle cx={C} cy={C} r={R} />
    </clipPath>
  </defs>

  <rect width="400" height="400" fill="#07080a" />
  <circle cx={C} cy={C} r={R * 1.55} fill={`url(#gl-glow-${id})`} />

  <g clip-path={`url(#gl-clip-${id})`}>
    {mode === 'earth' && (
      <g>
        <circle cx={C} cy={C} r={R} fill={`url(#gl-lit-${id})`} />
        {continents.map((c) => (
          <ellipse cx={c.x} cy={c.y} rx={c.rx} ry={c.ry} fill="#04121f" fill-opacity="0.65" transform={`rotate(${c.rot} ${c.x} ${c.y})`} />
        ))}
        {lats.map((l) => <ellipse cx={C} cy={l.y} rx={l.rx} ry={Math.max(l.rx * 0.2, 0.6)} fill="none" stroke={accent} stroke-opacity="0.22" />)}
      </g>
    )}

    {mode === 'moon' && (
      <g>
        <circle cx={C} cy={C} r={R} fill="#171716" />
        <circle cx={C} cy={C} r={R} fill={`url(#gl-lit-${id})`} fill-opacity="0.55" />
        {craters.map((c) => (
          <g>
            <circle cx={c.x} cy={c.y} r={c.r} fill="#0d0d0c" fill-opacity="0.8" />
            <circle cx={c.x - c.r * 0.2} cy={c.y - c.r * 0.2} r={c.r * 0.8} fill="none" stroke={accent} stroke-opacity="0.2" />
          </g>
        ))}
      </g>
    )}

    {mode === 'terminator' && (
      <g>
        <circle cx={C} cy={C} r={R} fill={`url(#gl-term-${id})`} />
        {lats.map((l) => <ellipse cx={C} cy={l.y} rx={l.rx} ry={Math.max(l.rx * 0.2, 0.6)} fill="none" stroke={accent} stroke-opacity="0.26" />)}
        <path d={`M${C + 18} ${C - R} Q${C + 48} ${C} ${C + 18} ${C + R}`} fill="none" stroke={accent} stroke-opacity="0.85" stroke-width="2" />
      </g>
    )}

    {mode === 'wire' && (
      <g fill="none" stroke={accent}>
        <circle cx={C} cy={C} r={R} stroke-opacity="0.1" fill="#0b0d10" />
        {lats.map((l) => <ellipse cx={C} cy={l.y} rx={l.rx} ry={Math.max(l.rx * 0.22, 0.6)} stroke-opacity="0.55" />)}
        {mers.map((rx) => <ellipse cx={C} cy={C} rx={Math.max(rx, 0.6)} ry={R} stroke-opacity="0.55" />)}
      </g>
    )}

    {mode === 'flare' && (
      <g>
        <circle cx={C} cy={C} r={R} fill={accent} fill-opacity="0.16" />
        {Array.from({ length: 30 }, (_, i) => (
          <path d={`M${C} ${C} L${C + Math.cos((i / 30) * Math.PI * 2) * 260} ${C + Math.sin((i / 30) * Math.PI * 2) * 260}`} stroke={accent} stroke-opacity="0.25" stroke-width="5" />
        ))}
        <circle cx={C} cy={C} r={R * 0.52} fill={accent} fill-opacity="0.9" />
        <circle cx={C} cy={C} r={R} fill="none" stroke={accent} stroke-width="3" />
      </g>
    )}

    {mode === 'eclipse' && (
      <g>
        <circle cx={C} cy={C} r={R} fill="#040605" />
        <circle cx={C} cy={C} r={R} fill="none" stroke={accent} stroke-width="5" stroke-opacity="0.95" />
        <circle cx={C} cy={C} r={R - 9} fill="none" stroke={accent} stroke-width="1" stroke-opacity="0.35" />
        <ellipse cx={C} cy={C} rx={R} ry={R * 0.22} fill="none" stroke={accent} stroke-opacity="0.3" />
      </g>
    )}

    {mode === 'grid' && (
      <g fill="none" stroke={accent}>
        <circle cx={C} cy={C} r={R} fill="#0a080d" stroke-opacity="0.1" />
        {lats.map((l, i) => <ellipse cx={C} cy={l.y} rx={l.rx} ry={Math.max(l.rx * 0.22, 0.6)} stroke-opacity={i === 3 ? 0.95 : 0.3} stroke-width={i === 3 ? 2 : 1} />)}
        {mers.map((rx, i) => <ellipse cx={C} cy={C} rx={Math.max(rx, 0.6)} ry={R} stroke-opacity={i === 0 ? 0.95 : 0.3} stroke-width={i === 0 ? 2 : 1} />)}
      </g>
    )}

    {mode === 'scan' && (
      <g>
        <circle cx={C} cy={C} r={R} fill="#0b0a06" />
        {scans.map((y, i) => <path d={`M${C - R} ${y} H${C + R}`} stroke={accent} stroke-opacity={i % 3 === 0 ? 0.85 : 0.28} stroke-width={i % 3 === 0 ? 3 : 1.4} />)}
        <path d={`M${C - R} ${C} H${C + R}`} stroke={accent} stroke-width="6" stroke-opacity="0.95" />
      </g>
    )}
  </g>

  <circle cx={C} cy={C} r={R} fill="none" stroke={accent} stroke-opacity="0.7" stroke-width="1.6" />
  <ellipse cx={C} cy={C} rx={R + 30} ry={(R + 30) * 0.2} fill="none" stroke={accent} stroke-opacity="0.18" />
  <path d={`M40 ${C + R + 46} H360`} stroke="#2b3138" stroke-width="3" />
  <path d={`M64 ${C + R + 46} v-16 M336 ${C + R + 46} v-16`} stroke="#2b3138" stroke-width="2" />
</svg>

<style>
  svg {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
