---
import Layout from '@/layouts/Base.astro';
import GlobeStage from '@/components/GlobeStage.astro';
import GlobeLook from '@/components/GlobeLook.astro';
import VideoEmbed from '@/components/VideoEmbed.astro';
import { url } from '@/lib/url';
import { globe, specs, quotes, looks, videos, videoSearches, globeSources } from '@/data/globe';
import { shows } from '@/data/tour';

const venues = new Set(shows.filter((s) => s.status !== 'cancelled').map((s) => s.venue)).size;

const jsonLd = [
  {
    '@type': 'CreativeWork',
    name: 'The Globe Stage',
    alternateName: globe.alsoKnown,
    description:
      'The spherical stage and screen at the centre of the 2026 Ye Live Concert Tour, estimated at over 50 feet in diameter.',
    dateCreated: '2026',
    creator: [
      { '@type': 'Person', name: 'Ye', alternateName: 'Kanye West' },
      { '@type': 'Person', name: 'Aus Taylor', jobTitle: 'Production designer' },
    ],
    contributor: { '@type': 'Person', name: 'John McGuire', jobTitle: 'Lighting designer' },
    genre: 'Concert production design',
  },
];
---

<Layout
  title="The Globe"
  description="The 50-foot spinning sphere at the centre of Ye's 2026 tour: who designed it, what it projects, how it is lit, the states it cycles through, and full-show video."
  accent="#4a8bff"
  ogType="article"
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"><GlobeStage lines={18} speed={26} uid="globepage" /></div>
    <div class="hero-fade" aria-hidden="true"></div>
    <div class="wrap hero-in">
      <p class="eyebrow">{globe.designers} {'·'} Lighting by {globe.lighting}</p>
      <h1 class="wordmark" style="font-size:clamp(62px,18vw,196px)">
        THE GLOBE
        <small>A 50-FOOT SPHERE THAT IS ALSO THE STAGE AND THE SCREEN</small>
      </h1>
      <p class="hero-sub">
        It debuted on 1 April 2026 at SoFi Stadium on a night billed as "Ye: The Homecoming", and it has
        been to {venues} venues on four continents since. Nobody has said how it works.
      </p>
      <div class="hero-cta">
        <a class="btn-ye solid" href="#looks">The eight states</a>
        <a class="btn-ye" href="#film">Full-show film</a>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <span class="rule-num">01 {'—'} What is known</span>
          <h2>The object</h2>
        </div>
        <p>Everything below is from published reporting. The last line is the important one.</p>
      </div>
      <dl class="facts">
        {specs.map((f) => <div class="fact"><dt>{f.term}</dt><dd style="font-size:15px;font-weight:500;line-height:1.55">{f.body}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="wrap two-col">
      <div>
        <span class="rule-num">02 {'—'} Where it came from</span>
        <h2 style="font-size:clamp(28px,4.4vw,46px)">Return and revival</h2>
        <div class="prose" style="margin-top:22px">
          <p>
            Ye has framed the stage as an idea about coming back rather than a piece of engineering. The
            brief, in his words, was the feeling of standing on top of the world after everything we have
            been through — which is why opening night put him literally on top of a demi-globe, tethered at
            its apex, in a stadium twenty minutes from where he used to live.
          </p>
          <p>
            Aus Taylor, the production designer who built it with him, has been almost aggressively modest
            about his own part: "just a vessel." Between them they replaced the two things every stadium
            show has — a stage at one end and a screen behind it — with a single object in the middle that
            is both.
          </p>
          <p>
            The lighting is John McGuire's. That matters more than it sounds: a sphere has no flat plane
            to wash, so the rig has to model a curved surface from above and behind while the surface
            itself is projecting. Most of the states below are lighting decisions, not video ones.
          </p>
          <p>
            What nobody outside the production has said is how any of it is rigged, driven or projected.
            That silence looks deliberate, and it is treated here as a fact about the tour rather than a
            gap to fill in with a guess.
          </p>
        </div>
      </div>
      <div style="display:grid;gap:18px;align-content:start">
        {
          quotes.map((q) => (
            <blockquote class="panel" style="margin:0">
              <p style="margin:0;font-family:var(--ye-display);font-weight:700;font-size:21px;line-height:1.35;color:var(--ye-bone)">
                {'“'}{q.text}{'”'}
              </p>
              <footer style="margin-top:14px;font-family:var(--ye-mono);font-size:11.5px;letter-spacing:0.14em;color:var(--ye-dust)">
                {'—'} {q.who}
              </footer>
            </blockquote>
          ))
        }
        <div class="notice">
          <div>
            <b>A note on these drawings</b>
            The eight states below are original renderings, not photographs. They are drawn from written
            descriptions of what the sphere does across a set, and they are how the rest of this archive
            shows you things it cannot legally show you.
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="sec" id="looks" style="padding-top:0">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <span class="rule-num">03 {'—'} Gallery</span>
          <h2>Eight states</h2>
        </div>
        <p>
          The sphere does not sit still. Across two hours it moves through planet, moon, structure and
          pure light — each one tied to a stretch of the set.
        </p>
      </div>
      <div class="gallery">
        {
          looks.map((look) => (
            <figure class="plate reveal" style={`--ye-accent:${look.accent}`}>
              <GlobeLook look={look} />
              <figcaption>
                <strong style="display:block;font-family:var(--ye-display);font-size:15px;color:var(--ye-bone);letter-spacing:0;text-transform:none;margin-bottom:6px">
                  {look.title}
                </strong>
                <span style="text-transform:none;letter-spacing:0;font-family:var(--ye-body);font-size:13px;color:var(--ye-ash)">
                  {look.caption}
                </span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="sec" id="film" style="padding-top:0">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <span class="rule-num">04 {'—'} Film</span>
          <h2>See it move</h2>
        </div>
        <p>
          Istanbul is the best-documented night of the tour because Ye livestreamed the whole thing.
          Nothing loads from YouTube until you press play.
        </p>
      </div>
      <div class="gallery">
        {videos.map((v) => <VideoEmbed videoId={v.id} title={v.title} where={v.where} note={v.note} accent="#4a8bff" />)}
      </div>

      <div class="panel" style="margin-top:22px">
        <div class="panel-title">No verified full upload yet</div>
        <p style="margin:0 0 14px;font-size:14px;color:var(--ye-ash);line-height:1.6">
          For these nights there is plenty of phone footage but no single upload this archive can vouch
          for, so you get a search rather than an embed of something I have not checked.
        </p>
        <ul class="pills">
          {
            videoSearches.map((v) => (
              <li style="padding:0">
                <a
                  href={`https://www.youtube.com/results?search_query=${encodeURIComponent(v.q)}`}
                  rel="noopener nofollow"
                  style="display:block;padding:10px 13px;text-decoration:none;color:var(--ye-bone)"
                >
                  {v.label} {'↗'}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <span class="rule-num">05 {'—'} Provenance</span>
          <h2>Sources</h2>
        </div>
        <p>Every claim on this page traces back to one of these.</p>
      </div>
      <ul class="srcs">
        {globeSources.map((s) => <li><a href={s.url} rel="noopener nofollow">{s.label}</a></li>)}
      </ul>
    </div>
  </section>

  <nav class="pager" aria-label="Elsewhere">
    <a href={url('/')}><span>{'←'} Back</span><b>All dates</b><i>Where the globe has been</i></a>
    <a class="next" href={url('/andre/')}><span>Next {'→'}</span><b>André Troutman</b><i>The talk box at the front of it</i></a>
  </nav>
</Layout>
