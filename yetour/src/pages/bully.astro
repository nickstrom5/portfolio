---
import Layout from '@/layouts/Base.astro';
import GlobeStage from '@/components/GlobeStage.astro';
import { url } from '@/lib/url';
import { albums, referenceSet, song, songs, tour, shows, longDate } from '@/data/tour';

/** The BULLY titles that public reporting has actually named. */
const bullyTracks = Object.values(songs).filter((s) => s.album === 'bully');
const inSet = new Set(referenceSet.flatMap((a) => a.songs));
const opener = shows[0]!;

const jsonLd = [
  {
    '@type': 'MusicAlbum',
    name: 'BULLY',
    albumProductionType: 'https://schema.org/StudioAlbum',
    byArtist: { '@type': 'MusicGroup', name: 'Ye', alternateName: 'Kanye West' },
    datePublished: '2026-03-28',
    numTracks: 18,
    recordLabel: [{ '@type': 'Organization', name: 'YZY' }, { '@type': 'Organization', name: 'Gamma' }],
    sameAs: ['https://en.wikipedia.org/wiki/Bully_(album)'],
  },
];

const facts = [
  { term: 'Released', value: '28 March 2026' },
  { term: 'Labels', value: tour.albumLabels },
  { term: 'Sequence', value: 'Twelfth studio album' },
  { term: 'Tracks', value: '18' },
  { term: 'Runtime', value: '30:12 physical · 42:26 streaming · 46:56 deluxe' },
  { term: 'Recorded', value: '2021 — 2026' },
  { term: 'Tour opened', value: `${longDate(opener.date)}, four days later` },
];
---

<Layout
  title="BULLY (2026)"
  description="BULLY, Ye's twelfth studio album and the record the 2026 Live Concert Tour is built around: release facts, the documented tracks, and which of them the globe plays."
  accent="#f2ede1"
  ogType="article"
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"><GlobeStage lines={10} speed={34} rig={false} uid="bully" /></div>
    <div class="hero-fade" aria-hidden="true"></div>
    <div class="wrap hero-in">
      <p class="eyebrow">Twelfth studio album {'·'} YZY / Gamma {'·'} 28 March 2026</p>
      <h1 class="wordmark" style="font-size:clamp(66px,19vw,210px)">
        BULLY
        <small>THE RECORD THE GLOBE IS CARRYING</small>
      </h1>
      <p class="hero-sub">
        Eighteen songs, recorded across five years, announced with four words: <em>BULLY ON THE WAY NO
        AI</em>. Four days after it landed, the sphere switched on at SoFi Stadium.
      </p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <dl class="facts">
        {facts.map((f) => <div class="fact"><dt>{f.term}</dt><dd>{f.value}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="wrap two-col">
      <div>
        <span class="rule-num">01 {'—'} The record</span>
        <h2 style="font-size:clamp(28px,4.4vw,46px)">Five years, thirty minutes</h2>
        <div class="prose" style="margin-top:22px">
          <p>
            BULLY arrived on 28 March 2026 through YZY and Gamma, recorded in sessions stretching back to
            2021. Eighteen tracks that run thirty minutes and twelve seconds on the physical release,
            forty-two on streaming and just under forty-seven on the deluxe — three different versions of
            the same record, which is its own kind of statement.
          </p>
          <p>
            Ye announced it by promising what it would not contain: <em>BULLY ON THE WAY NO AI</em>. In
            2026, with the rest of the industry going the other way, that line did more promotional work
            than any single.
          </p>
          <p>
            Then the tour. Four days after release, a spinning globe the size of a building switched on in
            Inglewood and played the album more or less in sequence. It has done that on every date since.
          </p>
        </div>
        <div class="hero-cta" style="justify-content:flex-start;margin-top:28px">
          <a class="btn-ye" href={url('/setlists/')}>How it is played live</a>
          <a class="btn-ye" href={url(`/shows/${opener.slug}/`)}>Opening night</a>
        </div>
      </div>

      <div>
        <div class="panel">
          <div class="panel-title">Documented tracks {'·'} {bullyTracks.length} of 18</div>
          <div class="setlist">
            {
              bullyTracks.map((t) => (
                <div class="song">
                  <span class="song-n" aria-hidden="true" />
                  <span class="song-body">
                    <span class="song-title">{t.title}</span>
                    <span class="song-meta">
                      <span class="album-chip" style={`--chip:${albums.bully.color}`}>
                        <i aria-hidden="true" />BULLY
                      </span>
                      {t.with ? ` · with ${t.with}` : ''}
                      {inSet.has(t.id) ? ' · in the live set' : ''}
                    </span>
                    {t.note && <span class="song-note">{t.note}</span>}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
        <div class="notice" style="margin-top:18px">
          <div>
            <b>Ten titles missing</b>
            Public reporting has named {bullyTracks.length} of the album's 18 tracks. The rest are not
            listed here rather than guessed at. If you are reading this after a fuller tracklist has been
            published, this page is out of date and the fault is the archive's.
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <span class="rule-num">02 {'—'} Twenty-two years</span>
          <h2>Everything else the set touches</h2>
        </div>
        <p>
          The live show is not a BULLY showcase. Twelve albums show up across a normal night, colour-coded
          here the way they are everywhere on this site.
        </p>
      </div>
      <ul class="pills">
        {
          Object.values(albums)
            .filter((a) => a.year > 0)
            .sort((a, b) => a.year - b.year)
            .map((a) => (
              <li>
                <span class="album-chip" style={`--chip:${a.color}`}>
                  <i aria-hidden="true" />{a.title} {'·'} {a.year}
                </span>
              </li>
            ))
        }
      </ul>
      <p class="prose" style="margin-top:26px;max-width:74ch">
        The oldest song still in rotation is "{song('jesus-walks').title}" from 2004. The newest is whichever
        BULLY track the globe opened with that night. In Chicago on 4 September the two were about ninety
        minutes apart in the same set.
      </p>
    </div>
  </section>

  <nav class="pager" aria-label="Elsewhere">
    <a href={url('/setlists/')}><span>{'←'} Back</span><b>Setlists</b><i>Every documented song</i></a>
    <a class="next" href={url('/about/')}><span>Next {'→'}</span><b>About</b><i>Sources and method</i></a>
  </nav>
</Layout>
