---
import Layout from '@/layouts/Base.astro';
import Garment from '@/components/Garment.astro';
import { url } from '@/lib/url';
import { rooms, yeezySources } from '@/data/yeezy';

const exhibits = rooms.reduce((n, r) => n + r.exhibits.length, 0);

const jsonLd = [
  {
    '@type': 'ExhibitionEvent',
    name: 'The Yeezy Archive',
    description: 'A twelve-room walk-through of Ye’s fashion output, 2004 to the present.',
    startDate: '2026',
    about: { '@type': 'Brand', name: 'Yeezy' },
  },
  {
    '@type': 'ItemList',
    name: 'The Yeezy Archive — rooms',
    numberOfItems: rooms.length,
    itemListElement: rooms.map((r, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: `${r.title} (${r.years})`,
    })),
  },
];
---

<Layout
  title="The Yeezy Archive"
  description="Twenty-two years of Ye's fashion in twelve rooms, from the Pastelle jacket nobody could buy to YZY today — walk it top to bottom, one era per room."
  accent="#d9a441"
  ogType="article"
  jsonLd={jsonLd}
>
  <div class="museum" data-museum>
    <!-- ------------------------------------------------------------ lobby -->
    <section class="sec lobby">
      <div class="wrap">
        <div class="sec-head">
          <div>
            <span class="rule-num">{rooms.length} rooms {'·'} {exhibits} objects {'·'} 2004 {'—'} 2026</span>
            <h1 style="font-size:clamp(40px,7.5vw,92px)">The Yeezy Archive</h1>
          </div>
          <p>
            A walk-through, not a list. Start at the top and keep scrolling: one room per era, wall text
            on the left, objects in the vitrine, and the year rail keeping your place.
          </p>
        </div>

        <div class="plan" aria-label="Floor plan">
          <div class="plan-title">Floor plan {'—'} tap a room to jump</div>
          <ol class="plan-rooms">
            {
              rooms.map((r) => (
                <li>
                  <a href={`#room-${r.id}`} style={`--ye-accent:${r.accent}`}>
                    <span class="plan-n">{String(r.n).padStart(2, '0')}</span>
                    <span class="plan-name">{r.title}</span>
                    <span class="plan-years">{r.years}</span>
                  </a>
                </li>
              ))
            }
          </ol>
        </div>

        <div class="notice" style="margin-top:26px">
          <div>
            <b>About the objects</b>
            None of these are photographs. Runway and product photography belongs to the people who shot
            it, so every exhibit here is an original vector drawing — which has no resolution to run out
            of, and stays sharp at any size you view it. Where you want the real images, the sources at
            the bottom are the places that hold them.
          </div>
        </div>
      </div>
    </section>

    <!-- ------------------------------------------------------------- rail -->
    <nav class="rail" aria-label="Rooms">
      <ol>
        {
          rooms.map((r) => (
            <li>
              <a href={`#room-${r.id}`} data-rail={r.id} style={`--ye-accent:${r.accent}`}>
                <i aria-hidden="true"></i>
                <b>{String(r.n).padStart(2, '0')}</b>
                <span>{r.title}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <!-- ------------------------------------------------------------ rooms -->
    {
      rooms.map((room) => (
        <section class="room" id={`room-${room.id}`} data-room={room.id} style={`--ye-accent:${room.accent}`}>
          <div class="wrap room-in">
            <header class="room-head">
              <span class="room-n">Room {String(room.n).padStart(2, '0')}</span>
              <h2 class="room-title">{room.title}</h2>
              <p class="room-strap">{room.strap}</p>
              <dl class="room-meta">
                <div><dt>Years</dt><dd>{room.years}</dd></div>
                <div><dt>Billing</dt><dd>{room.billing}</dd></div>
                <div><dt>Objects</dt><dd>{room.exhibits.length}</dd></div>
              </dl>
            </header>

            <div class="room-body">
              <div class="wall">
                {room.wall.map((para) => <p>{para}</p>)}
              </div>

              <div class="vitrine">
                {
                  room.exhibits.map((ex) => (
                    <figure class="case reveal">
                      <div class="case-art"><Garment figure={ex.figure} accent={room.accent} label={ex.label} /></div>
                      <figcaption class="case-label">
                        <span class="case-acc">{String(room.n).padStart(2, '0')}.{ex.id.slice(0, 3).toUpperCase()}</span>
                        <strong>{ex.label}</strong>
                        <span class="case-year">{ex.year} {'·'} {ex.material}</span>
                        <span class="case-note">{ex.note}</span>
                      </figcaption>
                    </figure>
                  ))
                }
              </div>
            </div>
          </div>
        </section>
      ))
    }

    <!-- ------------------------------------------------------------- exit -->
    <section class="sec">
      <div class="wrap">
        <div class="sec-head">
          <div>
            <span class="rule-num">Exit {'—'} provenance</span>
            <h2>Sources</h2>
          </div>
          <p>Where the dates come from, and where the real photographs live.</p>
        </div>
        <ul class="srcs">
          {yeezySources.map((s) => <li><a href={s.url} rel="noopener nofollow">{s.label}</a></li>)}
        </ul>
      </div>
    </section>

    <nav class="pager" aria-label="Elsewhere">
      <a href={url('/features/')}><span>{'←'} Back</span><b>Features &amp; credits</b><i>The work outside his own albums</i></a>
      <a class="next" href={url('/donda/')}><span>Next {'→'}</span><b>Donda</b><i>The DW in room three</i></a>
    </nav>
  </div>
</Layout>

<style>
  /* --------------------------------------------------------------- lobby */
  .plan {
    border: 1px solid var(--ye-line);
    background: var(--ye-pit);
    padding: clamp(18px, 3vw, 26px);
  }

  .plan-title {
    font-family: var(--ye-mono);
    font-size: 11.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ye-dust);
    padding-bottom: 14px;
    margin-bottom: 16px;
    border-bottom: 1px solid var(--ye-line);
  }

  .plan-rooms {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(168px, 1fr));
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: none;
  }

  .plan-rooms a {
    display: block;
    padding: 14px 14px 15px;
    border: 1px solid var(--ye-line);
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s, transform 0.2s;
  }

  .plan-rooms a:hover,
  .plan-rooms a:focus-visible {
    border-color: var(--ye-accent);
    background: color-mix(in srgb, var(--ye-accent) 8%, transparent);
    transform: translateY(-2px);
  }

  .plan-n {
    display: block;
    /* Lifted toward bone so every room accent clears 4.5:1 at label size. */
    color: color-mix(in srgb, var(--ye-accent) 58%, #efece4);
    font-family: var(--ye-mono);
    font-size: 11px;
    letter-spacing: 0.2em;
  }

  .plan-name {
    display: block;
    margin-top: 8px;
    font-family: var(--ye-display);
    font-weight: 800;
    font-size: 16px;
    line-height: 1.2;
    color: var(--ye-bone);
  }

  .plan-years {
    display: block;
    margin-top: 5px;
    font-family: var(--ye-mono);
    font-size: 11px;
    color: var(--ye-dust);
  }

  /* ---------------------------------------------------------------- rail */
  .rail {
    display: none;
  }

  @media (min-width: 1180px) {
    .rail {
      display: block;
      position: fixed;
      right: 18px;
      top: 50%;
      transform: translateY(-50%);
      z-index: 30;
    }
    .rail ol {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 2px;
    }
    .rail a {
      display: flex;
      align-items: center;
      gap: 9px;
      justify-content: flex-end;
      padding: 5px 4px;
      text-decoration: none;
    }
    .rail i {
      order: 3;
      width: 22px;
      height: 2px;
      background: var(--ye-line-hot);
      transition: width 0.25s, background 0.25s;
    }
    .rail b {
      order: 2;
      font-family: var(--ye-mono);
      font-weight: 400;
      font-size: 11px;
      color: var(--ye-dust);
      transition: color 0.25s;
    }
    .rail span {
      order: 1;
      font-family: var(--ye-mono);
      font-size: 11px;
      letter-spacing: 0.1em;
      color: var(--ye-dust);
      opacity: 0;
      transform: translateX(6px);
      transition: opacity 0.25s, transform 0.25s;
      white-space: nowrap;
    }
    .rail a:hover span,
    .rail a[data-current] span {
      opacity: 1;
      transform: none;
    }
    .rail a[data-current] i {
      width: 40px;
      background: var(--ye-accent);
    }
    .rail a[data-current] b,
    .rail a:hover b,
    .rail a:hover span {
      color: var(--ye-bone);
    }
  }

  /* --------------------------------------------------------------- rooms */
  .room {
    position: relative;
    border-top: 1px solid var(--ye-line);
    padding-block: clamp(50px, 9vw, 110px);
    background:
      radial-gradient(ellipse 60% 44% at 12% 0%, color-mix(in srgb, var(--ye-accent) 9%, transparent), transparent 62%);
  }

  .room-head {
    padding-bottom: 26px;
    margin-bottom: 30px;
    border-bottom: 1px solid var(--ye-line);
  }

  .room-n {
    display: block;
    /* Lifted toward bone so every room accent clears 4.5:1 at label size. */
    color: color-mix(in srgb, var(--ye-accent) 58%, #efece4);
    font-family: var(--ye-mono);
    font-size: 11.5px;
    letter-spacing: 0.26em;
    text-transform: uppercase;
  }

  .room-title {
    margin-top: 14px;
    font-size: clamp(36px, 7vw, 82px);
    letter-spacing: -0.04em;
  }

  .room-strap {
    margin: 14px 0 0;
    max-width: 46ch;
    font-size: clamp(16px, 2vw, 21px);
    line-height: 1.4;
    color: var(--ye-bone);
  }

  .room-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 30px;
    margin: 22px 0 0;
  }

  .room-meta dt {
    font-family: var(--ye-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ye-dust);
  }

  .room-meta dd {
    margin: 5px 0 0;
    font-family: var(--ye-display);
    font-weight: 700;
    font-size: 15px;
  }

  .room-body {
    display: grid;
    gap: clamp(28px, 4vw, 52px);
  }

  @media (min-width: 1000px) {
    .room-body {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr);
      align-items: start;
    }
    .wall {
      position: sticky;
      top: 84px;
    }
  }

  .wall p {
    max-width: 52ch;
    font-size: clamp(15px, 1.7vw, 17px);
    line-height: 1.75;
    color: #d7d3ca;
  }

  .wall p:first-child {
    border-left: 2px solid var(--ye-accent);
    padding-left: 16px;
  }

  /* ------------------------------------------------------------- vitrine */
  .vitrine {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(248px, 1fr));
    gap: 14px;
  }

  .case {
    margin: 0;
    border: 1px solid var(--ye-line);
    background: var(--ye-pit);
    overflow: hidden;
    transition: border-color 0.25s, transform 0.25s;
  }

  .case:hover {
    border-color: color-mix(in srgb, var(--ye-accent) 55%, var(--ye-line));
    transform: translateY(-3px);
  }

  .case-art {
    border-bottom: 1px solid var(--ye-line);
    background: #0b0d0f;
  }

  .case-label {
    padding: 15px 16px 17px;
  }

  .case-acc {
    display: block;
    /* Lifted toward bone so every room accent clears 4.5:1 at label size. */
    color: color-mix(in srgb, var(--ye-accent) 58%, #efece4);
    font-family: var(--ye-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
  }

  .case-label strong {
    display: block;
    margin-top: 8px;
    font-family: var(--ye-display);
    font-weight: 800;
    font-size: 17px;
    line-height: 1.25;
    color: var(--ye-bone);
  }

  .case-year {
    display: block;
    margin-top: 6px;
    font-family: var(--ye-mono);
    font-size: 11px;
    line-height: 1.6;
    color: var(--ye-dust);
  }

  .case-note {
    display: block;
    margin-top: 11px;
    padding-top: 11px;
    border-top: 1px solid var(--ye-line);
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--ye-ash);
  }
</style>

<script>
  // Light the rail entry for whichever room is nearest the middle of the screen.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('[data-rail]')].map((a) => [a.dataset.rail!, a]),
  );
  const sections = [...document.querySelectorAll<HTMLElement>('[data-room]')];

  if (links.size && sections.length && 'IntersectionObserver' in window) {
    let current = '';
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const id = (e.target as HTMLElement).dataset.room!;
          if (id === current) continue;
          links.get(current)?.removeAttribute('data-current');
          links.get(id)?.setAttribute('data-current', '');
          current = id;
        }
      },
      { rootMargin: '-45% 0px -45% 0px', threshold: 0 },
    );
    sections.forEach((s) => io.observe(s));
  }
</script>
