---
import Layout from '@/layouts/Base.astro';
import { url } from '@/lib/url';
import { shows, legs, legsById, parts, shortPlace, tour } from '@/data/tour';

const W = 1240;
const H = 620;
const project = ([lat, lon]: [number, number]) => ({
  x: ((lon + 180) / 360) * W,
  y: ((90 - lat) / 180) * H,
});

/** Great-circle distance in kilometres. */
function haversine(a: [number, number], b: [number, number]): number {
  const toRad = (d: number) => (d * Math.PI) / 180;
  const dLat = toRad(b[0] - a[0]);
  const dLon = toRad(b[1] - a[1]);
  const s =
    Math.sin(dLat / 2) ** 2 + Math.cos(toRad(a[0])) * Math.cos(toRad(b[0])) * Math.sin(dLon / 2) ** 2;
  return 2 * 6371 * Math.asin(Math.sqrt(s));
}

const routed = shows.filter((s) => s.status !== 'cancelled');
const hops = routed.slice(1).map((s, i) => ({
  from: routed[i]!,
  to: s,
  km: haversine(routed[i]!.coords, s.coords),
}));
const totalKm = Math.round(hops.reduce((sum, h) => sum + h.km, 0));
const longest = hops.reduce((best, h) => (h.km > best.km ? h : best), hops[0]!);

const points = shows.map((s) => ({ show: s, ...project(s.coords), accent: legsById[s.leg]!.color }));

/** Curved hop, bowed away from the equator so overlapping legs stay readable. */
const arcs = hops.map((h) => {
  const a = project(h.from.coords);
  const b = project(h.to.coords);
  const mx = (a.x + b.x) / 2;
  const my = (a.y + b.y) / 2;
  const lift = Math.min(Math.abs(b.x - a.x) * 0.2 + 18, 120);
  return { d: `M${a.x.toFixed(1)} ${a.y.toFixed(1)} Q${mx.toFixed(1)} ${(my - lift).toFixed(1)} ${b.x.toFixed(1)} ${b.y.toFixed(1)}`, accent: legsById[h.to.leg]!.color };
});

const parallels = [-60, -30, 0, 30, 60].map((lat) => ({ lat, y: ((90 - lat) / 180) * H }));
const meridians = [-120, -60, 0, 60, 120].map((lon) => ({ lon, x: ((lon + 180) / 360) * W }));
---

<Layout
  title="The Route"
  description="How the 2026 Ye Live Concert Tour crossed four continents: eight legs, every hop plotted and measured, from SoFi Stadium in April to Glendale in November."
  accent="#4a8bff"
>
  <section class="sec">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <span class="rule-num">Routing {'—'} {tour.opened} to {tour.closes}</span>
          <h1 style="font-size:clamp(44px,8vw,96px)">The route</h1>
        </div>
        <p>
          Eight legs, {routed.length} played or scheduled dates, and roughly {totalKm.toLocaleString('en-US')} km
          of great-circle distance between consecutive shows. Cancelled dates are marked but not routed.
        </p>
      </div>

      <div class="table-scroll" style="background:var(--ye-pit)">
        <svg viewBox={`0 0 ${W} ${H}`} style="min-width:900px;width:100%;height:auto" role="img" aria-label="Diagram of the 2026 tour route plotted on a latitude and longitude grid, with every date numbered in chronological order">
          <rect width={W} height={H} fill="#0b0d0f" />
          {parallels.map((p) => (
            <g>
              <path d={`M0 ${p.y} H${W}`} stroke="#1d2226" stroke-width={p.lat === 0 ? 1.4 : 1} />
              <text x="8" y={p.y - 6} font-family="'JetBrains Mono', monospace" font-size="12" fill="#4b5158">{p.lat}{'°'}</text>
            </g>
          ))}
          {meridians.map((m) => (
            <g>
              <path d={`M${m.x} 0 V${H}`} stroke="#1d2226" stroke-width={m.lon === 0 ? 1.4 : 1} />
              <text x={m.x + 6} y={H - 10} font-family="'JetBrains Mono', monospace" font-size="12" fill="#4b5158">{m.lon}{'°'}</text>
            </g>
          ))}

          {arcs.map((a) => <path d={a.d} fill="none" stroke={a.accent} stroke-opacity="0.5" stroke-width="1.4" stroke-dasharray="5 6" />)}

          {
            points.map((pt) => (
              <g>
                {pt.show.status === 'cancelled' ? (
                  <g>
                    <path d={`M${pt.x - 7} ${pt.y - 7} l14 14 M${pt.x + 7} ${pt.y - 7} l-14 14`} stroke="#6a7178" stroke-width="1.8" />
                  </g>
                ) : (
                  <g>
                    <circle cx={pt.x} cy={pt.y} r={pt.show.status === 'upcoming' ? 8 : 6} fill="#0b0d0f" stroke={pt.accent} stroke-width="2" />
                    <circle cx={pt.x} cy={pt.y} r="2.2" fill={pt.accent} />
                  </g>
                )}
                <text
                  x={pt.x + 12}
                  y={pt.y - 9}
                  font-family="'JetBrains Mono', monospace"
                  font-size="13"
                  letter-spacing="1"
                  fill={pt.show.status === 'cancelled' ? '#6a7178' : '#cfd4d9'}
                >
                  {String(pt.show.n).padStart(2, '0')} {pt.show.city.toUpperCase()}
                </text>
              </g>
            ))
          }
        </svg>
      </div>
      <p class="filter-empty" style="padding-top:14px">
        Scroll the diagram sideways on a phone. Every marker is a date; crosses are the two shows that were
        cancelled.
      </p>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div class="stats-grid">
        <div class="stat"><b>{totalKm.toLocaleString('en-US')}</b><span>km routed</span><i>Between consecutive dates</i></div>
        <div class="stat"><b>{Math.round(longest.km).toLocaleString('en-US')}</b><span>Longest hop</span><i>{longest.from.city} → {longest.to.city}</i></div>
        <div class="stat"><b>{legs.length}</b><span>Legs</span><i>April to November</i></div>
        <div class="stat"><b>{new Set(routed.map((s) => s.country)).size}</b><span>Countries played</span><i>Plus 2 refused</i></div>
        <div class="stat"><b>{new Set(routed.map((s) => s.venue)).size}</b><span>Venues</span><i>Including one built for the night</i></div>
      </div>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <span class="rule-num">Leg by leg</span>
          <h2>The year in order</h2>
        </div>
        <p>Distances are great-circle from the previous date on the itinerary.</p>
      </div>

      {
        legs.map((leg) => (
          <div style="margin-bottom:34px">
            <div class="act-head">
              <h3>Leg {leg.n} — {leg.name}</h3>
              <span>{leg.region}</span>
            </div>
            <p class="prose" style="max-width:74ch;margin-bottom:16px">{leg.blurb}</p>
            <div class="table-scroll">
              <table class="ledger">
                <thead>
                  <tr>
                    <th scope="col">N°</th>
                    <th scope="col">Date</th>
                    <th scope="col">City</th>
                    <th scope="col">Venue</th>
                    <th scope="col">Travel</th>
                    <th scope="col">Status</th>
                  </tr>
                </thead>
                <tbody>
                  {
                    shows.filter((s) => s.leg === leg.id).map((s) => {
                      const hop = hops.find((h) => h.to.slug === s.slug);
                      return (
                        <tr>
                          <td>{String(s.n).padStart(2, '0')}</td>
                          <td>{parts(s.date).dd} {parts(s.date).month}</td>
                          <td><a href={url(`/shows/${s.slug}/`)}>{shortPlace(s)}</a></td>
                          <td>{s.venue}</td>
                          <td>{hop ? `${Math.round(hop.km).toLocaleString('en-US')} km` : s.status === 'cancelled' ? '—' : 'Opening date'}</td>
                          <td><span class:list={['tag', s.status]}>{s.status}</span></td>
                        </tr>
                      );
                    })
                  }
                </tbody>
              </table>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <nav class="pager" aria-label="Elsewhere">
    <a href={url('/')}>
      <span>{'←'} Back</span><b>All dates</b><i>{shows.length} boxes, one per night</i>
    </a>
    <a class="next" href={url('/setlists/')}>
      <span>Next {'→'}</span><b>Setlists</b><i>Every song reported in 2026</i>
    </a>
  </nav>
</Layout>
