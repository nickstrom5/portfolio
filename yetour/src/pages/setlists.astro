---
import Layout from '@/layouts/Base.astro';
import { url } from '@/lib/url';
import { albums, referenceSet, song, songLedger, shows, parts, shortPlace } from '@/data/tour';

const ledger = songLedger();
const documented = shows.filter((s) => s.reported.length > 0);

/** Album spread across the reference set, for the bar. */
const spread = (() => {
  const counts = new Map<string, number>();
  for (const act of referenceSet) {
    for (const id of act.songs) {
      const a = song(id).album;
      counts.set(a, (counts.get(a) ?? 0) + 1);
    }
  }
  const total = [...counts.values()].reduce((a, b) => a + b, 0);
  return [...counts.entries()]
    .map(([id, n]) => ({ album: albums[id as keyof typeof albums], n, pct: (n / total) * 100 }))
    .sort((a, b) => b.n - a.n);
})();

const totalReferenceSongs = referenceSet.reduce((n, a) => n + a.songs.length, 0);

const jsonLd = [
  {
    '@type': 'ItemList',
    name: 'Songs reported at 2026 Ye Live Concert Tour dates',
    numberOfItems: ledger.length,
    itemListElement: ledger.map((l, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'MusicRecording',
        name: l.song.title,
        inAlbum: { '@type': 'MusicAlbum', name: albums[l.song.album].title },
        byArtist: { '@type': 'MusicGroup', name: 'Ye', alternateName: 'Kanye West' },
      },
    })),
  },
];
---

<Layout
  title="Setlist Ledger"
  description="Every song reported at a 2026 Ye Live Concert Tour date, which nights it was played, and the album it comes from — plus the tour's recurring reference set."
  accent="#ff3b2a"
  jsonLd={jsonLd}
>
  <section class="sec">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <span class="rule-num">Songs {'—'} {ledger.length} documented</span>
          <h1 style="font-size:clamp(44px,8vw,96px)">Setlist ledger</h1>
        </div>
        <p>
          Only {documented.length} of the {shows.length} dates have a published song-by-song account. This is
          everything those nights confirm, and nothing they don't.
        </p>
      </div>

      <div class="notice">
        <div>
          <b>How to read this</b>
          A song appears here only if a source places it at a specific 2026 date. The reference set further
          down is a different thing: the tour's recurring shape, assembled from these same reported songs.
          It is printed as a guide on pages where no setlist was published, and it is always labelled as
          such.
        </div>
      </div>

      <div class="table-scroll" style="margin-top:26px">
        <table class="ledger">
          <thead>
            <tr>
              <th scope="col">Song</th>
              <th scope="col">Album</th>
              <th scope="col">Nights</th>
              <th scope="col">Reported at</th>
            </tr>
          </thead>
          <tbody>
            {
              ledger.map(({ song: t, shows: at }) => {
                const a = albums[t.album];
                return (
                  <tr>
                    <td>
                      <strong style="font-family:var(--ye-display);font-size:16px">{t.title}</strong>
                      {t.with && <div style="color:var(--ye-dust);font-size:12.5px;margin-top:4px">with {t.with}</div>}
                    </td>
                    <td>
                      <span class="album-chip" style={`--chip:${a.color}`}>
                        <i aria-hidden="true" />{a.title}
                      </span>
                    </td>
                    <td>{at.length}</td>
                    <td>
                      {at.map((s, i) => (
                        <>
                          {i > 0 ? ', ' : ''}
                          <a href={url(`/shows/${s.slug}/`)}>{s.city} {parts(s.date).dd}.{parts(s.date).mm}</a>
                        </>
                      ))}
                    </td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <span class="rule-num">Documented nights</span>
          <h2>Where the setlists come from</h2>
        </div>
        <p>The dates with published running orders, best documented first.</p>
      </div>
      <div class="date-grid">
        {
          documented
            .slice()
            .sort((a, b) => b.reported.length - a.reported.length)
            .map((s) => (
              <a class="box reveal" href={url(`/shows/${s.slug}/`)} style="min-height:0">
                <div class="box-top">
                  <span>N{'°'} {String(s.n).padStart(2, '0')}</span>
                  <span class:list={['tag', s.setlistSource === 'reported' ? 'played' : 'upcoming']}>
                    {s.setlistSource === 'reported' ? 'Full setlist' : 'Partial'}
                  </span>
                </div>
                <h3 style="margin-top:16px">{s.city}</h3>
                <div class="box-date" style="margin-top:8px">{parts(s.date).dd}.{parts(s.date).mm}.{parts(s.date).y}</div>
                <p class="box-venue" style="margin-top:12px">
                  {s.reported.length} songs confirmed{s.guests.length ? ` · ${s.guests.length} guests` : ''}
                </p>
                <div class="box-foot"><span class="box-go">{shortPlace(s)}</span><span class="box-go" aria-hidden="true">{'→'}</span></div>
              </a>
            ))
        }
      </div>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <span class="rule-num">Reference set {'—'} {totalReferenceSongs} songs</span>
          <h2>The recurring shape</h2>
        </div>
        <p>
          Four acts: BULLY in sequence inside the globe, the Yeezus and Donda block in red, the catalogue
          with the sphere raised, and one song alone at the end.
        </p>
      </div>

      <div class="panel" style="margin-bottom:26px">
        <div class="panel-title">Album spread across the reference set</div>
        <div style="display:flex;height:16px;overflow:hidden;border:1px solid var(--ye-line)">
          {spread.map((s) => <div style={`width:${s.pct}%;background:${s.album.color}`} title={`${s.album.title}: ${s.n}`}></div>)}
        </div>
        <ul class="pills" style="margin-top:16px">
          {
            spread.map((s) => (
              <li>
                <span class="album-chip" style={`--chip:${s.album.color}`}>
                  <i aria-hidden="true" />{s.album.title} {'·'} {s.n}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="panel">
        {
          referenceSet.map((act) => (
            <div class="act setlist">
              <div class="act-head">
                <h3>{act.title}</h3>
                <span>{act.subtitle}</span>
              </div>
              {
                act.songs.map((id) => {
                  const t = song(id);
                  const a = albums[t.album];
                  return (
                    <div class="song">
                      <span class="song-n" aria-hidden="true" />
                      <span class="song-body">
                        <span class="song-title">{t.title}</span>
                        <span class="song-meta">
                          <span class="album-chip" style={`--chip:${a.color}`}>
                            <i aria-hidden="true" />{a.title}{a.year ? ` (${a.year})` : ''}
                          </span>
                          {t.with ? ` · with ${t.with}` : ''}
                        </span>
                        {t.note && <span class="song-note">{t.note}</span>}
                      </span>
                    </div>
                  );
                })
              }
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <nav class="pager" aria-label="Elsewhere">
    <a href={url('/route/')}><span>{'←'} Back</span><b>The route</b><i>Eight legs plotted and measured</i></a>
    <a class="next" href={url('/bully/')}><span>Next {'→'}</span><b>BULLY</b><i>The album the tour is carrying</i></a>
  </nav>
</Layout>
