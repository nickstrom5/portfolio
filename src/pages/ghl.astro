---
/**
 * /ghl/ — GoHighLevel case studies: three businesses, each a sample
 * sub-account with a working landing page and its workflows. Content lives
 * in src/data/ghl; the simulator is src/lib/ghl. Run `npm run ghl:check`
 * after editing a workflow.
 */
import '@/styles/ghl.css';
import Base from '@/layouts/Base.astro';
import CaseStudyView from '@/components/ghl/CaseStudy.astro';
import { cases as allCases } from '@/data/ghl';
import { countSteps, simulate } from '@/lib/ghl/engine';
import type { Step } from '@/lib/ghl/types';
import { site } from '@/data/site';
import { url } from '@/lib/url';

// A case appears once it has workflows, so a half-finished case never ships as an empty tab.
const cases = allCases.filter((c) => c.automations.length > 0);
const words = ['No', 'One', 'Two', 'Three', 'Four', 'Five'];
const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;

// Every number in the hero is computed from the data, by running the simulator at build time.
let branches = 0;
const walk = (list: Step[]) =>
  list.forEach((s) => {
    if (s.kind === 'ifelse') {
      branches += s.branches.length + 1;
      [...s.branches.map((b) => b.nodes), s.otherwise.nodes].forEach(walk);
    }
    if (s.kind === 'wait' && s.branches) {
      branches += 2;
      walk(s.branches.met.nodes);
      walk(s.branches.timeout.nodes);
    }
  });
const all = cases.flatMap((c) => c.automations.map((a) => ({ c, a })));
all.forEach(({ a }) => walk(a.workflow.steps));
const taken = new Set<string>();
for (const { c, a } of all) {
  for (const s of a.scenarios) simulate(a, s, c.business.sampleContact, c.business.env).visited.forEach((v) => v.includes(':') && taken.add(`${c.business.id}/${a.id}/${v}`));
}
const stats = [
  { value: String(all.length), label: 'Working workflows' },
  { value: String(all.reduce((n, { a }) => n + countSteps(a.workflow.steps), 0)), label: 'Workflow steps' },
  { value: String(all.reduce((n, { a }) => n + a.scenarios.length, 0)), label: 'Test contacts you can run' },
  { value: `${taken.size}/${branches}`, label: 'Branches reached by a test' },
];

/** Links to workflows by "case/automation"; missing ones are skipped. */
const find = (ref: string) => {
  const [cid, aid] = ref.split('/');
  const c = cases.find((x) => x.business.id === cid);
  const a = c?.automations.find((x) => x.id === aid);
  return c && a ? { href: `#${cid}-${aid}`, open: `${cid}-${aid}`, label: `${c.business.name} ${a.number} · ${a.name}` } : undefined;
};

const compliance = [
  {
    title: 'A2P-ready opt-in',
    body: 'Every landing page has separate consent boxes for service texts and for offers, unticked and optional. The same wording goes into the A2P 10DLC campaign registration, and the first text names the business and says how to opt out.',
    where: ['roofing/speed-to-lead', 'saas/demo-request', 'coaching/webinar'],
  },
  {
    title: 'Quiet hours in the contact’s time zone',
    body: 'Federal rules stop solicitation texts at 9 PM, but Florida, Oklahoma and Maryland stop at 8. Follow-up and marketing texts wait for an 8 AM to 8 PM window in the contact’s time zone.',
    where: ['roofing/speed-to-lead', 'roofing/reactivation', 'coaching/cart-recovery'],
  },
  {
    title: 'Opt-outs by any reasonable means',
    body: 'STOP and the other standard keywords switch on SMS DND automatically. “Please stop texting me” does not, and since April 11, 2025 the FCC requires honoring it too, within 10 business days. The reactivation workflow catches it and switches DND on.',
    where: ['roofing/reactivation'],
  },
  {
    title: 'No review gating',
    body: 'Everyone gets the same public review link, whatever they think. Google prohibits selectively asking happy customers, and the FTC rule on reviews and testimonials (16 CFR Part 465) bans review suppression and incentives tied to sentiment.',
    where: ['roofing/reviews-referrals', 'saas/nps-health', 'coaching/completion'],
  },
  {
    title: 'Claims a coach can back up',
    body: 'No income promises on the page or in the follow-ups, testimonials that are real and not presented as typical results, and any incentive disclosed. The FTC treats all three as advertising.',
    where: ['coaching/webinar', 'coaching/completion'],
  },
  {
    title: 'Secrets stay out of messages',
    body: 'API keys live in webhook headers and stay out of custom values that templates can print. Payloads carry ids, not passwords, and every call back to the app is logged in Execution Logs.',
    where: ['saas/trial-ending', 'saas/closed-won'],
  },
  {
    title: 'Email that lands',
    body: 'A dedicated sending subdomain with SPF, DKIM and DMARC, one-click unsubscribe on marketing email as Google and Yahoo require of bulk senders, and a postal address in the footer for CAN-SPAM.',
    where: [],
  },
  {
    title: 'Texts that stay cheap',
    body: 'One curly apostrophe or dash turns an SMS from GSM-7 into UCS-2 and cuts each segment from 160 characters to 70. Every text on this page is checked automatically for both.',
    where: [],
  },
];

const audit = [
  { title: 'Loops', body: 'A workflow triggered by a tag that adds the same tag, or two workflows that trigger each other. Fix with trigger filters, re-entry off and an explicit Remove from Workflow.' },
  { title: 'Double texts', body: 'Allow Re-entry on with no dedupe, so a double form submit sends everything twice. Fix with re-entry off, or a tag guard at the top.' },
  { title: 'Stop on Response surprises', body: 'It ends the run on any response to the workflow’s messages, out-of-office auto-replies included. Keep it where any reply should reach a person; use a reply wait with timeout branches where the answer matters.' },
  { title: 'The wrong clock', body: 'Workflows set to the account time zone while contacts span several, and imported contacts with no time zone at all. Quiet hours only work in the recipient’s time.' },
  { title: 'Duplicate opportunities', body: 'Two cards per lead because duplicates are allowed. Fix the setting, then merge the pipeline so reporting can be trusted again.' },
  { title: 'Hard-coded links and numbers', body: 'A booking link typed into forty messages. Move it into a custom value so the next change is one edit.' },
  { title: 'Silent trigger breaks', body: 'A Facebook lead form duplicated in Meta gets a new form ID and the trigger filter stops matching. So does a renamed form, calendar or product. Trigger Statistics shows it; I check it after any change.' },
  { title: 'Premium steps doing standard work', body: 'Custom Code, Custom Webhook and Inbound Webhook are billed per execution. Worth it where they earn it, not for a job a standard action does.' },
];

const process = [
  { title: 'Scope', body: 'Who the lead is, what counts as success, who acts on what, and what must never happen. Written down before anything is built.' },
  { title: 'Data model', body: 'Custom fields, dropdown values, tags, pipeline stages and custom values first, named so the next person can guess them.' },
  { title: 'Build in draft', body: 'One workflow per job, named NN · Folder · Name, with the settings chosen on purpose rather than left at the defaults.' },
  { title: 'Test with test contacts', body: 'A test contact for every path, checked against Execution Logs and Enrollment History. Real phones and real inboxes for the copy.' },
  { title: 'Publish and hand off', body: 'Published in a quiet hour, then a short Loom walkthrough and a one-page SOP: what it does, what to change, what never to touch.' },
  { title: 'Watch it', body: 'Trigger Statistics and Execution Logs checked in the first week, then monthly. Errors fixed before anyone notices them.' },
];

const caseWord = words[cases.length] ?? String(cases.length);
const title = 'GoHighLevel case studies';
const description =
  cases.length === 3
    ? `Three GoHighLevel case studies you can test: a local roofer, a SaaS company and an online coach, with ${all.length} working workflows and live landing pages.`
    : `GoHighLevel case studies you can test: ${plural(all.length, 'working workflow', 'working workflows')}, live landing pages and the build notes behind each.`;
---

<Base title={title} description={description}>
  <section class="gx-hero">
    <div class="container">
      <span class="eyebrow">GoHighLevel · Workflows and landing pages</span>
      <h1>{all.length}&nbsp;GoHighLevel {all.length === 1 ? 'workflow' : 'workflows'} across {caseWord.toLowerCase()} {cases.length === 1 ? 'business' : 'businesses'}. Run every one.</h1>
      <p class="lede">
        {cases.length === 3
          ? 'Three case studies, each built as its own sub-account: a roofing company that lives on the phone, a software company whose product talks to GHL, and an online coach who lives on funnels and payments.'
          : `${caseWord} ${cases.length === 1 ? 'case study' : 'case studies'}, each built as its own sub-account.`}{' '}
        Each has a working landing page, a set of connected workflows and the notes behind every decision. Every workflow runs in a simulator on this page, on sample contacts or on you.
      </p>
      <div class="gx-cta">
        <a class="btn btn-primary" href="#cases">Pick a case study</a>
        <a class="btn btn-secondary" href="#process">How I work</a>
        <a class="btn btn-secondary" href={url('/resume')}>View resume</a>
      </div>
      <dl class="gx-stats">
        {stats.map((s) => (
          <div><dt>{s.label}</dt><dd>{s.value}</dd></div>
        ))}
      </dl>
      <p class="gx-disclaimer">The businesses and people are fictional. The workflows use GHL’s real triggers, actions and settings, checked against HighLevel’s help center, so each one can be rebuilt step for step in a sub-account. Nothing on this page sends a message.</p>
    </div>
  </section>

  <div class="gx-switch" id="cases">
    <div class="container">
      <div class="gx-switch-grid" role="tablist" aria-label="Case studies">
        {cases.map((c, i) => (
          <button
            type="button"
            role="tab"
            class="gx-switch-tab"
            id={`case-tab-${c.business.id}`}
            aria-controls={c.business.id}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-labelledby={`case-name-${c.business.id}`}
            aria-describedby={`case-blurb-${c.business.id}`}
            tabindex={i === 0 ? 0 : -1}
            data-case-tab={c.business.id}
            style={`--case: ${c.business.tint.light}; --case-dark: ${c.business.tint.dark}`}
          >
            <span class="gx-switch-state" aria-hidden="true">Showing</span>
            <span class="gx-switch-kicker" aria-hidden="true">Case study {i + 1} · {c.business.industry}</span>
            <span class="gx-switch-name" id={`case-name-${c.business.id}`}>{c.business.name}</span>
            <span class="gx-switch-blurb" id={`case-blurb-${c.business.id}`}>{c.business.industry}. {c.business.blurb} {plural(c.automations.length, 'workflow', 'workflows')} and a working landing page.</span>
            <span class="gx-switch-meta" aria-hidden="true">{plural(c.automations.length, 'workflow', 'workflows')} · a working landing page</span>
          </button>
        ))}
      </div>
    </div>
  </div>

  {cases.map((c, i) => <CaseStudyView study={c} index={i} hidden={i !== 0} />)}

  <section class="section" id="compliance" aria-labelledby="compliance-title">
    <div class="container">
      <span class="eyebrow">Compliance</span>
      <div class="section-head">
        <h2 id="compliance-title">Compliance is part of the build, not a checkbox</h2>
      </div>
      <p class="lede">A workflow that texts the wrong person at the wrong time costs more than it earns. These rules are built into the workflows in every case study.</p>
      <ul class="gx-cards">
        {compliance.map((x) => {
          const refs = x.where.map(find).filter((r): r is NonNullable<ReturnType<typeof find>> => !!r);
          return (
            <li class="card">
              <h3>{x.title}</h3>
              <p>{x.body}</p>
              {refs.length > 0 && (
                <p class="gx-where">
                  See{' '}
                  {refs.map((r, j) => (
                    <><a href={r.href} data-open-auto={r.open}>{r.label}</a>{j < refs.length - 1 ? ', ' : ''}</>
                  ))}
                </p>
              )}
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section class="section" id="audit" aria-labelledby="audit-title">
    <div class="container gx-split">
      <div>
        <span class="eyebrow">Troubleshooting</span>
        <h2 id="audit-title">What I check first when I inherit an account</h2>
        <p class="lede">Most broken GHL setups fail in the same few ways. This is the order I look in, and what I do about each.</p>
      </div>
      <ol class="gx-audit">
        {audit.map((x) => (
          <li><strong>{x.title}</strong><span>{x.body}</span></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="process" aria-labelledby="process-title">
    <div class="container">
      <span class="eyebrow">How I work</span>
      <div class="section-head">
        <h2 id="process-title">From a brief to a workflow the team trusts</h2>
      </div>
      <ol class="gx-process">
        {process.map((p, i) => (
          <li>
            <span class="gx-process-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </li>
        ))}
      </ol>
      <div class="gx-conventions">
        <h3>Naming, so the next person can find things</h3>
        <dl>
          <div><dt>Workflows</dt><dd><code>01 · Lead Intake · Speed to Lead</code> in a Lead Intake folder</dd></div>
          <div><dt>Tags</dt><dd><code>stl-no-response</code>, <code>pql-alerted</code>: lowercase, prefixed by the workflow that sets them</dd></div>
          <div><dt>Custom fields</dt><dd><code>lead_score</code>, <code>utm_source</code>: snake_case keys, spelled exactly like the form</dd></div>
          <div><dt>Custom values</dt><dd><code>{'{{custom_values.booking_link}}'}</code>: every link and phone number lives in one place</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section gx-closing">
    <div class="container gx-closing-inner">
      <div>
        <h2>Need workflows like these in your account?</h2>
        <p class="muted">I build, fix and document GoHighLevel sub-accounts: workflows, pipelines, funnels and the compliance around them.</p>
      </div>
      <div class="gx-cta">
        <a class="btn btn-primary" href={url('/contact')}>Get in touch</a>
        <a class="btn btn-secondary" href={url('/resume')}>View resume</a>
        <a class="btn btn-secondary" href={`mailto:${site.email}`}>Email me</a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { initGhlPage } from '@/lib/ghl/page';
  initGhlPage();
</script>
