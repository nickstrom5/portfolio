---
/**
 * /ghl/ — GoHighLevel case studies: three businesses, each a sample
 * sub-account with a working landing page and its workflows. Content lives
 * in src/data/ghl; the simulator is src/lib/ghl. Run `npm run ghl:check`
 * after editing a workflow.
 */
import '@/styles/ghl.css';
import Base from '@/layouts/Base.astro';
import CaseStudyView from '@/components/ghl/CaseStudy.astro';
import { cases as allCases } from '@/data/ghl';
import { countSteps, formatDuration, formatTime, simulate } from '@/lib/ghl/engine';
import type { Step } from '@/lib/ghl/types';
import { site } from '@/data/site';
import { url } from '@/lib/url';

// A case appears once it has workflows, so a half-finished case never ships as an empty tab.
const cases = allCases.filter((c) => c.automations.length > 0);
const words = ['No', 'One', 'Two', 'Three', 'Four', 'Five'];
const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;

// Every number in the hero is computed from the data, by running the simulator at build time.
let branches = 0;
const walk = (list: Step[]) =>
  list.forEach((s) => {
    if (s.kind === 'ifelse') {
      branches += s.branches.length + 1;
      [...s.branches.map((b) => b.nodes), s.otherwise.nodes].forEach(walk);
    }
    if (s.kind === 'wait' && s.branches) {
      branches += 2;
      walk(s.branches.met.nodes);
      walk(s.branches.timeout.nodes);
    }
  });
const all = cases.flatMap((c) => c.automations.map((a) => ({ c, a })));
all.forEach(({ a }) => walk(a.workflow.steps));
const taken = new Set<string>();
for (const { c, a } of all) {
  for (const s of a.scenarios) simulate(a, s, c.business.sampleContact, c.business.env).visited.forEach((v) => v.includes(':') && taken.add(`${c.business.id}/${a.id}/${v}`));
}
const stats = [
  { value: String(all.length), label: 'Workflows you can run' },
  { value: String(all.reduce((n, { a }) => n + countSteps(a.workflow.steps), 0)), label: 'Automatic steps inside them' },
  { value: String(all.reduce((n, { a }) => n + a.scenarios.length, 0)), label: 'Sample customers to test with' },
  { value: `${taken.size}/${branches}`, label: 'Possible paths, each one reached by a test' },
];

// The hero's preview is one real run of the first case's first workflow and first sample customer,
// so its messages can never drift from the workflow.
const peekCase = cases[0];
const peekAuto = peekCase.automations[0];
const peekRun = simulate(peekAuto, peekAuto.scenarios[0], peekCase.business.sampleContact, peekCase.business.env);
const lead = peekRun.contact.firstName || 'The lead';
const owner = peekRun.contact.assignedTo ? peekCase.business.env.users[peekRun.contact.assignedTo]?.name.split(' ')[0] : undefined;
const peek = peekRun.steps
  .filter((s) => s.message)
  .map((s) => {
    const m = s.message!;
    const when = s.t === peekRun.start ? 'Right away' : `${formatDuration(s.t - peekRun.start)} later`;
    if (m.channel === 'sms') return { when: `${when} · ${m.direction === 'in' ? `${lead} replies` : `text to ${lead}`}`, cls: `g-bubble ${m.direction}`, body: m.body };
    // The email's greeting and first paragraph are enough to show what it says.
    if (m.channel === 'email') return { when: `${when} · email to ${lead}`, cls: 'g-mail', subject: m.subject, body: `${m.body.split('\n\n').slice(0, 2).join('\n\n')} …` };
    return { when: `${when} · alert to ${(m.to ?? 'the team').replace(/ \(.*\)$/, '')}`, cls: 'g-note', label: 'To the team', subject: m.subject, body: m.body };
  });
const peekEnd =
  peekRun.outcome === 'stopped'
    ? `${lead} replied, so the automatic messages stop${owner ? ` and ${owner} takes it from here` : ' and a person takes it from here'}.`
    : 'The follow-up runs on from here, and the simulator shows every step.';

/** Links to workflows by "case/automation"; missing ones are skipped. */
const find = (ref: string) => {
  const [cid, aid] = ref.split('/');
  const c = cases.find((x) => x.business.id === cid);
  const a = c?.automations.find((x) => x.id === aid);
  return c && a ? { href: `#${cid}-${aid}`, open: `${cid}-${aid}`, label: `${c.business.name} ${a.number} · ${a.name}` } : undefined;
};

const compliance = [
  {
    title: 'A2P-ready opt-in',
    body: 'Every landing page has separate consent boxes for service texts and for offers, unticked and optional, and the roofing booking calendar carries the service box too. No consent on file means SMS DND, set by a workflow rather than left to memory. The same wording goes into the A2P 10DLC campaign registration, along with the missed-call text-back, where the caller starts the conversation. Every first text names the business and says how to opt out.',
    where: ['roofing/speed-to-lead', 'roofing/missed-call', 'roofing/inspection-booked', 'saas/demo-request', 'coaching/webinar'],
  },
  {
    title: 'Quiet hours in the contact’s time zone',
    body: 'Federal rules stop solicitation texts at 9 PM, but Florida, Oklahoma and Maryland stop at 8. Follow-up and marketing texts wait for an 8 AM to 8 PM window in the contact’s time zone.',
    where: ['roofing/speed-to-lead', 'roofing/missed-call', 'roofing/reactivation', 'coaching/cart-recovery'],
  },
  {
    title: 'Opt-outs by any reasonable means',
    body: 'STOP and the other standard keywords switch on SMS DND automatically. “Please stop texting me” does not, and since April 11, 2025 the FCC requires honoring it too, within 10 business days. The reactivation workflow catches it and switches DND on; where a person reads every reply, as with missed calls, the alert tells them to do it the same day.',
    where: ['roofing/missed-call', 'roofing/reactivation'],
  },
  {
    title: 'No review gating',
    body: 'Everyone gets the same public review link, whatever they think. Google prohibits selectively asking happy customers, and the FTC rule on reviews and testimonials (16 CFR Part 465) bans review suppression and incentives tied to sentiment.',
    where: ['roofing/reviews-referrals', 'saas/nps-health', 'coaching/completion'],
  },
  {
    title: 'Claims a coach can back up',
    body: 'No income promises on the page or in the follow-ups, testimonials that are real and not presented as typical results, and any incentive disclosed. The FTC treats all three as advertising.',
    where: ['coaching/webinar', 'coaching/completion'],
  },
  {
    title: 'Secrets stay out of messages',
    body: 'API keys live in webhook headers and stay out of custom values that templates can print. Payloads carry ids, not passwords, and every call back to the app is logged in Execution Logs.',
    where: ['saas/trial-ending', 'saas/closed-won'],
  },
  {
    title: 'Email that lands',
    body: 'A dedicated sending subdomain with SPF, DKIM and DMARC, one-click unsubscribe on marketing email as Google and Yahoo require of bulk senders, and a postal address in the footer for CAN-SPAM.',
    where: [],
  },
  {
    title: 'Texts that stay cheap',
    body: 'One curly apostrophe or dash turns an SMS from GSM-7 into UCS-2 and cuts each segment from 160 characters to 70. Every text on this page is checked automatically for both.',
    where: [],
  },
];

const audit = [
  { title: 'Loops', body: 'A workflow triggered by a tag that adds the same tag, or two workflows that trigger each other. Fix with trigger filters, re-entry off and an explicit Remove from Workflow.' },
  { title: 'Double texts', body: 'GHL will not add a contact who is already active in a workflow, so the duplicates come later: re-entry on and a second form submit next week, or a trigger that fires more than once, like Call Details with no status filter, which fires for each call. Fix with trigger filters, a tag or field check at the top, or re-entry off where one pass is enough.' },
  { title: 'Stop on Response surprises', body: 'It ends the run on any response to the workflow’s messages, out-of-office auto-replies included. Keep it where any reply should reach a person; use a reply wait with timeout branches where the answer matters.' },
  { title: 'The wrong clock', body: 'Workflows set to the account time zone while contacts span several, and imported contacts with no time zone at all. Quiet hours only work in the recipient’s time.' },
  { title: 'Duplicate opportunities', body: 'Two cards per lead because duplicates are allowed. Fix the setting, then merge the pipeline so reporting can be trusted again.' },
  { title: 'Hard-coded links and numbers', body: 'A booking link typed into forty messages. Move it into a custom value so the next change is one edit.' },
  { title: 'Silent trigger breaks', body: 'A Facebook lead form duplicated in Meta gets a new form ID and the trigger filter stops matching. So does a renamed form, calendar or product. Trigger Statistics shows it; I check it after any change.' },
  { title: 'Premium steps doing standard work', body: 'Custom Code, Custom Webhook and Inbound Webhook are billed per execution. Worth it where they earn it, not for a job a standard action does.' },
];

const process = [
  { title: 'Scope', body: 'Who the lead is, what counts as success, who acts on what, and what must never happen. Written down before anything is built.' },
  { title: 'Data model', body: 'Custom fields, dropdown values, tags, pipeline stages and custom values first, named so the next person can guess them.' },
  { title: 'Build in draft', body: 'One workflow per job, named NN · Folder · Name, with the settings chosen on purpose rather than left at the defaults.' },
  { title: 'Test with test contacts', body: 'A test contact for every path, checked against Execution Logs and Enrollment History. Real phones and real inboxes for the copy.' },
  { title: 'Publish and hand off', body: 'Published in a quiet hour, then a short screen-recorded walkthrough (Loom) and a one-page how-to for the team (SOP): what it does, what to change, what never to touch.' },
  { title: 'Watch it', body: 'Trigger Statistics and Execution Logs checked in the first week, then monthly. Errors fixed before anyone notices them.' },
];

const caseWord = words[cases.length] ?? String(cases.length);
const listOf = (xs: string[]) => (xs.length < 3 ? xs.join(' and ') : `${xs.slice(0, -1).join(', ')} and ${xs[xs.length - 1]}`);

/** Plain-English meanings for the GoHighLevel words the page uses; the decoder in the hero. */
const decoder: [string, string][] = [
  ['GoHighLevel (GHL, HighLevel)', 'An all-in-one sales and marketing platform: contacts, landing pages, texts, emails, calendars and sales tracking in one place. Agencies often run it for their clients.'],
  ['Sub-account', 'One business’s own space inside GoHighLevel, with its own contacts, workflows, phone numbers and settings.'],
  ['Workflow', 'A set of automatic steps that runs on its own, such as “email the lead, assign a salesperson, wait a day, text again.”'],
  ['Trigger (the orange lightning bolt)', 'The event that starts a workflow: a form sent, a missed call, a booking, a deal card moving.'],
  ['Contact, contact record', 'A person in the account, and everything saved about them: details, answers, tags, owner and history.'],
  ['Lead score', 'A number from 0 to 100 that a workflow gives each new lead from their answers. For the roofer it comes from the service, the roof’s age and where the lead came from. The higher it is, the sooner someone should call.'],
  ['Custom field, tag', 'A custom field is an extra box on the record for the business’s own answers, like roof age. A tag is a short label, like stl-no-response, that other workflows can react to.'],
  ['Pipeline, opportunity, stage', 'The sales board. Each deal is a card (GoHighLevel calls it an opportunity) that moves through stages such as New Lead and Job Complete. Its status is Open, Won, Lost or Abandoned.'],
  ['Round robin', 'Handing new leads to salespeople in turn, so the work is shared evenly.'],
  ['If/Else, branch', 'A fork in the workflow: “Agreed to texts? Yes: text them. No: email only.” Each path is a branch.'],
  ['Wait, Go To, goal', 'A Wait pauses for a set time or until something happens. Go To jumps to another step. A goal lets the contact skip ahead once they do what the workflow was after, like booking.'],
  ['Stop on Response', 'A setting that ends the automatic follow-up as soon as the customer replies, so a person can take over.'],
  ['DND (Do Not Disturb)', 'A switch on a contact that blocks texts, emails or calls. Texting STOP turns it on for texts; these workflows also turn it on for anyone who didn’t agree to texts.'],
  ['Quiet hours, time window, Advance Window', 'Settings that hold a message until an allowed time, so nobody gets a sales text at night.'],
  ['Re-entry', 'Whether someone who already went through a workflow can go through it again later, like a past lead who asks again next year.'],
  ['A2P 10DLC', 'The registration US phone carriers require before a business can send texts from an ordinary local number. Reviewers check how people opt in.'],
  ['UTM tags', 'Labels on a link, like utm_source=google, that record which ad or email brought a visitor.'],
  ['Landing page, funnel', 'A one-purpose web page, or a short series of pages, built to get one action, like booking an inspection.'],
  ['Merge fields, custom values', 'Placeholders like {{contact.first_name}} that fill in each person’s details when a message goes out. Custom values keep things like the booking link in one place.'],
  ['Execution log', 'GoHighLevel’s step-by-step record of what a workflow did for one contact, with times. The simulator here shows the same kind of log.'],
  ['Custom Code, webhook', 'Custom Code runs a short script inside a workflow, here to score leads. A webhook is an automatic message from one app to another, like “trial started.”'],
];
const title = 'GoHighLevel automation case studies';
const description =
  cases.length === 3
    ? `Three GoHighLevel automation case studies you can test: a local roofer, a SaaS company and an online coach, with ${all.length} working workflows and live landing pages.`
    : `GoHighLevel automation case studies you can test: ${plural(all.length, 'working workflow', 'working workflows')}, live landing pages and the build notes behind each.`;
---

<Base title={title} description={description}>
  <section class="gx-hero">
    <div class="container">
      <div class="gx-hero-grid">
        <div>
          <span class="eyebrow">GoHighLevel · Workflows and landing pages</span>
          <h1>{all.length}&nbsp;GoHighLevel {all.length === 1 ? 'workflow' : 'workflows'} for {caseWord.toLowerCase()} {cases.length === 1 ? 'business' : 'businesses'}. Try every one yourself.</h1>
          <p class="lede">GoHighLevel is an all-in-one sales and marketing platform: contacts, landing pages, texts, emails, calendars and a sales board in one place. A workflow is a set of automatic steps inside it. When someone fills in a form or calls, a workflow can email and text them, hand the lead to a salesperson, remind that person to call, and stop the moment the customer replies.</p>
          <p class="gx-hero-sub">
            {cases.length === 3
              ? `I built ${all.length} of them for three made-up businesses: a roofer, a software company and an online coach. Each one also has a working landing page. Everything runs here in your browser, on sample customers or with your own name.`
              : `I built ${all.length} of them for ${caseWord.toLowerCase()} made-up ${cases.length === 1 ? 'business' : 'businesses'}, each with a working landing page. Everything runs here in your browser, on sample customers or with your own name.`}{' '}
            Need this for your business, or hiring for GoHighLevel? <a href={url('/contact')}>Get in touch</a>.
          </p>
          <div class="gx-cta">
            <a class="btn btn-primary" href={`#${cases[0].business.id}-demo`} data-open-auto={`${cases[0].business.id}-demo`}>Try it: fill in a form</a>
            <a class="btn btn-secondary" href="#cases">See the {caseWord.toLowerCase()} {cases.length === 1 ? 'business' : 'businesses'}</a>
            <a class="btn btn-secondary" href={url('/contact')}>Get in touch</a>
          </div>
        </div>
        <aside class="gx-peek" aria-labelledby="peek-title">
          <p class="gx-peek-kicker" id="peek-title">What one new lead gets</p>
          <p class="gx-peek-sub">{lead} fills in {peekCase.business.name}’s website form at {formatTime(peekRun.start)}. Workflow {peekAuto.number} · {peekAuto.name} does the rest:</p>
          <ol class="gx-peek-list">
            {peek.map((p) => (
              <li>
                <span class="gx-peek-when">{p.when}</span>
                <div class={p.cls}>
                  {p.label && <span class="g-note-to">{p.label}</span>}
                  {p.subject && <span class="g-mail-subj">{p.subject}</span>}
                  {p.body}
                </div>
              </li>
            ))}
          </ol>
          <p class="gx-peek-end">{peekEnd}</p>
          <a class="gx-peek-link" href={`#${peekCase.business.id}-${peekAuto.id}`} data-open-auto={`${peekCase.business.id}-${peekAuto.id}`}>Run it yourself →</a>
        </aside>
      </div>

      <div class="gx-howto">
        <h2 class="gx-howto-title">How to use this page</h2>
        <ol>
          <li><strong>Pick a business.</strong> New to GoHighLevel? Start with the roofer.</li>
          <li><strong>Be the customer.</strong> Fill in its sign-up form with any name, or pick a sample customer such as “Never replies” or “Submits at 11:48 PM”.</li>
          <li><strong>Press Run.</strong> Watch every email, text and task go out, with the time each would happen. Days of waiting are fast-forwarded.</li>
        </ol>
        <p class="gx-howto-hurry">Short on time? Each workflow opens with <strong>The problem</strong> and <strong>What I built</strong> in plain words. The diagrams and <strong>Build notes</strong> are the detail a GoHighLevel builder would check. <a href="#decoder">Words you may not know</a></p>
      </div>

      <dl class="gx-stats">
        {stats.map((s) => (
          <div><dt>{s.label}</dt><dd>{s.value}</dd></div>
        ))}
      </dl>

      <div class="gx-real">
        <div>
          <h2 class="gx-real-title">Are these real businesses?</h2>
          <p>No. {listOf(cases.map((c) => c.business.name))}, and everyone who works there, are made up, so every workflow can be shown end to end with its real messages and tried by anyone. The workflows themselves use GoHighLevel’s real triggers, actions and settings, checked against HighLevel’s help center, so each one can be rebuilt step for step in a real account. Nothing on this page sends a message or keeps what you type.</p>
        </div>
        <div>
          <h2 class="gx-real-title">Who built this</h2>
          <p>I’m {site.name}, a project and operations lead who also builds CRM automations in GoHighLevel, HubSpot, Zoho and Zapier. My client work includes a 2025 Upwork contract for GoHighLevel, Zapier and Slack automations (<a href={`${url('/work')}#contracts`}>see recent contracts</a>). This page and its simulator were built by directing AI, like the projects on my <a href={url('/apps')}>AI/Projects page</a>.</p>
          <p class="gx-real-links"><a href={url('/resume')}>View resume</a> · <a href="#process">How I work</a> · <a href={url('/contact')}>Get in touch</a></p>
        </div>
      </div>

      <details class="gx-conventions gx-decoder" id="decoder">
        <summary>GoHighLevel words in plain English <span class="g-count">({decoder.length})</span></summary>
        <dl>
          {decoder.map(([term, meaning]) => (
            <div><dt>{term}</dt><dd>{meaning}</dd></div>
          ))}
        </dl>
      </details>
    </div>
  </section>

  <div class="gx-switch" id="cases">
    <div class="container">
      <div class="gx-switch-grid" role="tablist" aria-label="Case studies">
        {cases.map((c, i) => (
          <button
            type="button"
            role="tab"
            class="gx-switch-tab"
            id={`case-tab-${c.business.id}`}
            aria-controls={c.business.id}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-labelledby={`case-name-${c.business.id}`}
            aria-describedby={`case-blurb-${c.business.id}`}
            tabindex={i === 0 ? 0 : -1}
            data-case-tab={c.business.id}
            style={`--case: ${c.business.tint.light}; --case-dark: ${c.business.tint.dark}`}
          >
            <span class="gx-switch-state" aria-hidden="true">Showing</span>
            <span class="gx-switch-kicker" aria-hidden="true">Case study {i + 1} · {c.business.industry}</span>
            <span class="gx-switch-name" id={`case-name-${c.business.id}`}>{c.business.name}</span>
            <span class="gx-switch-blurb" id={`case-blurb-${c.business.id}`}><span class="sr-only">{c.business.industry}.</span> {c.business.blurb} <span class="sr-only">{plural(c.automations.length, 'workflow', 'workflows')} and a working landing page.</span></span>
            <span class="gx-switch-meta" aria-hidden="true">{plural(c.automations.length, 'workflow', 'workflows')} · a working landing page</span>
          </button>
        ))}
      </div>
    </div>
  </div>

  {cases.map((c, i) => <CaseStudyView study={c} index={i} hidden={i !== 0} />)}

  <section class="section" id="compliance" aria-labelledby="compliance-title">
    <div class="container">
      <span class="eyebrow">Compliance</span>
      <div class="section-head">
        <h2 id="compliance-title">Compliance is part of the build, not a checkbox</h2>
      </div>
      <p class="lede">A workflow that texts the wrong person at the wrong time costs more than it earns. These rules are built into the workflows in every case study. In plain words: no texts to anyone who didn’t agree to them, no sales texts at night, anyone who asks to stop is stopped, every customer gets the same review request, and emails are set up to reach the inbox.</p>
      <ul class="gx-cards">
        {compliance.map((x) => {
          const refs = x.where.map(find).filter((r): r is NonNullable<ReturnType<typeof find>> => !!r);
          return (
            <li class="card">
              <h3>{x.title}</h3>
              <p>{x.body}</p>
              {refs.length > 0 && (
                <p class="gx-where">
                  See{' '}
                  {refs.map((r, j) => (
                    <><a href={r.href} data-open-auto={r.open}>{r.label}</a>{j < refs.length - 1 ? ', ' : ''}</>
                  ))}
                </p>
              )}
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section class="section" id="audit" aria-labelledby="audit-title">
    <div class="container gx-split">
      <div>
        <span class="eyebrow">Troubleshooting</span>
        <h2 id="audit-title">What I check first when I inherit an account</h2>
        <p class="lede">Most broken GHL setups fail in the same few ways. This is the order I look in, and what I do about each.</p>
      </div>
      <ol class="gx-audit">
        {audit.map((x) => (
          <li><strong>{x.title}</strong><span>{x.body}</span></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="process" aria-labelledby="process-title">
    <div class="container">
      <span class="eyebrow">How I work</span>
      <div class="section-head">
        <h2 id="process-title">From a brief to a workflow the team trusts</h2>
      </div>
      <ol class="gx-process">
        {process.map((p, i) => (
          <li>
            <span class="gx-process-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </li>
        ))}
      </ol>
      <div class="gx-conventions">
        <h3>Naming, so the next person can find things</h3>
        <dl>
          <div><dt>Workflows</dt><dd><code>01 · Lead Intake · Speed to Lead</code> in a Lead Intake folder</dd></div>
          <div><dt>Tags</dt><dd><code>stl-no-response</code>, <code>pql-alerted</code>: lowercase, prefixed by the workflow that sets them</dd></div>
          <div><dt>Custom fields</dt><dd><code>lead_score</code>, <code>utm_source</code>: snake_case keys, spelled exactly like the form</dd></div>
          <div><dt>Custom values</dt><dd><code>{'{{custom_values.booking_link}}'}</code>: every link and phone number lives in one place</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section gx-closing">
    <div class="container gx-closing-inner">
      <div>
        <h2>Hiring for GoHighLevel, or need it built?</h2>
        <p class="muted">I build, fix and document GoHighLevel accounts: workflows, sales pipelines, landing pages, and the texting and email rules around them. If you’re hiring for a GoHighLevel role or need this for your business, I’d like to hear about it.</p>
      </div>
      <div class="gx-cta">
        <a class="btn btn-primary" href={url('/contact')}>Get in touch</a>
        <a class="btn btn-secondary" href={url('/resume')}>View resume</a>
        <a class="btn btn-secondary" href={`mailto:${site.email}`}>Email me</a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { initGhlPage } from '@/lib/ghl/page';
  initGhlPage();
</script>
