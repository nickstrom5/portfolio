---
/**
 * Print-optimized résumé. Linked from the site nav, homepage and About.
 * Also used to generate the PDF in /public via `npm run resume:pdf`.
 */
import { site } from '@/data/site';
import { roles, education } from '@/data/experience';
import { services } from '@/data/services';
import { url } from '@/lib/url';

const summary =
  'Senior project manager and operations lead with 10+ years across federal research, universities, large corporations, startups and nonprofits. I take ownership of the moving parts, projects, timelines, tools, people and processes, so leadership can stay focused on growth. Lately also shipping iPhone apps and websites by directing AI models from brief to production.';
const skillGroups = services.map((s) => ({ label: s.title, items: s.bullets }));
const domain = site.url.replace(/^https?:\/\//, '');
const highlights = [
  ...site.stats.map((s) => ({ value: s.value, label: s.label.replace(' on Upwork', '') })),
  { value: 'Since 2015', label: 'Full-time freelance' },
];
const freelance = {
  title: 'Operations & Project Manager · Chief of Staff',
  company: 'Freelance, mostly via Upwork',
  start: '2015',
  end: 'Present',
  summary:
    '300+ completed contracts across project management, systems and CRM setup, executive support, events and media, and web and app builds. Longest-running roles below.',
};
const contacts = [
  { href: `mailto:${site.email}`, label: site.email },
  { href: site.url, label: domain },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={`Résumé of ${site.name}, ${site.role.toLowerCase()}.`} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <title>{site.name} · Résumé</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    />
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') {
          document.documentElement.dataset.theme = saved;
        }
      } catch {}
    </script>
    <style>
      :root {
        --ink: #17181a;
        --muted: #5b5f66;
        --faint: #6d727a;
        --rule: #e3e3dd;
        --accent: #1f5fd0;
        --accent-strong: #174aa6;
        --accent-soft: #e7eefc;
        --bg: #f4f4f0;
        --sheet: #ffffff;
        --shadow: 0 1px 2px rgb(0 0 0 / 0.04), 0 16px 40px -20px rgb(0 0 0 / 0.18);
        --radius: 16px;
        color-scheme: light;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) {
          --ink: #eef0f2;
          --muted: #a4abb5;
          --faint: #8b939e;
          --rule: #262c34;
          --accent: #6f9cff;
          --accent-strong: #8fb2ff;
          --accent-soft: #1a2740;
          --bg: #0f1114;
          --sheet: #161a1f;
          --shadow: 0 1px 2px rgb(0 0 0 / 0.4), 0 16px 40px -18px rgb(0 0 0 / 0.7);
          color-scheme: dark;
        }
      }
      :root[data-theme='dark'] {
        --ink: #eef0f2;
        --muted: #a4abb5;
        --faint: #8b939e;
        --rule: #262c34;
        --accent: #6f9cff;
        --accent-strong: #8fb2ff;
        --accent-soft: #1a2740;
        --bg: #0f1114;
        --sheet: #161a1f;
        --shadow: 0 1px 2px rgb(0 0 0 / 0.4), 0 16px 40px -18px rgb(0 0 0 / 0.7);
        color-scheme: dark;
      }
      * {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        font-size: 16px;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
      }
      a {
        color: var(--accent);
        text-decoration: none;
      }
      a:hover {
        color: var(--accent-strong);
      }
      :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
      }
      .skip {
        position: absolute;
        left: -999px;
        top: 0.5rem;
        background: var(--accent);
        color: #fff;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        z-index: 100;
      }
      .skip:focus {
        left: 0.5rem;
      }
      .chrome {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        max-width: 820px;
        margin: 0 auto;
        padding: 1.1rem 1.25rem 0;
      }
      .back {
        color: var(--muted);
        font-size: 0.92rem;
        font-weight: 500;
        min-height: 44px;
        display: inline-flex;
        align-items: center;
      }
      .back:hover {
        color: var(--ink);
      }
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 40px;
        padding: 0.45rem 0.95rem;
        border-radius: 999px;
        font-weight: 600;
        font-size: 0.9rem;
        border: 1px solid var(--rule);
        color: var(--ink);
        background: var(--sheet);
      }
      .btn:hover {
        border-color: var(--faint);
        color: var(--ink);
      }
      .wrap {
        max-width: 820px;
        margin: 0 auto;
        padding: 1rem 1.25rem 3.5rem;
      }
      .sheet {
        background: var(--sheet);
        border: 1px solid var(--rule);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: clamp(1.5rem, 4vw, 2.75rem) clamp(1.25rem, 4vw, 2.75rem);
      }
      header.masthead {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 1.5rem;
        padding-bottom: 1.35rem;
        border-bottom: 2px solid var(--ink);
      }
      h1 {
        font-size: clamp(2rem, 5vw, 2.55rem);
        margin: 0;
        letter-spacing: -0.035em;
        line-height: 1.05;
        font-weight: 800;
      }
      .role {
        margin: 0.45rem 0 0;
        font-size: 1.05rem;
        font-weight: 500;
        color: var(--muted);
        letter-spacing: -0.01em;
      }
      .contact {
        text-align: right;
        font-size: 0.95rem;
        color: var(--muted);
        line-height: 1.7;
      }
      .contact a {
        color: var(--ink);
        font-weight: 500;
      }
      .contact a:hover {
        color: var(--accent);
      }
      .highlights {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 0.75rem 1rem;
        margin: 0;
        padding: 1.25rem 0 1.35rem;
        list-style: none;
        border-bottom: 1px solid var(--rule);
      }
      .highlights li {
        min-width: 0;
      }
      .highlights li strong {
        display: block;
        font-size: clamp(1.15rem, 2vw, 1.45rem);
        letter-spacing: -0.03em;
        line-height: 1.15;
        font-weight: 800;
      }
      .highlights li span {
        display: block;
        margin-top: 0.2rem;
        color: var(--muted);
        font-size: 0.78rem;
        line-height: 1.35;
        font-weight: 500;
      }
      section {
        padding-top: 1.35rem;
      }
      h2 {
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--accent);
        margin: 0 0 0.55rem;
      }
      p {
        margin: 0;
      }
      .summary {
        max-width: 68ch;
        color: var(--ink);
        font-size: 1.02rem;
        line-height: 1.6;
      }
      .jobs {
        display: grid;
        gap: 0;
      }
      .job {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 0.15rem 1.5rem;
        padding: 0.85rem 0;
        border-bottom: 1px solid var(--rule);
        break-inside: avoid;
      }
      .job:last-child {
        border-bottom: 0;
        padding-bottom: 0;
      }
      .job:first-child {
        padding-top: 0.15rem;
      }
      .job .title {
        font-size: 1.02rem;
        font-weight: 700;
        letter-spacing: -0.015em;
        line-height: 1.3;
      }
      .job .co {
        display: block;
        color: var(--muted);
        font-size: 0.92rem;
        font-weight: 500;
        margin-top: 0.12rem;
      }
      .job .loc {
        color: var(--faint);
        font-weight: 400;
      }
      .job .when {
        color: var(--faint);
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
        text-align: right;
        font-size: 0.9rem;
        font-weight: 500;
        padding-top: 0.12rem;
      }
      .job .sum {
        grid-column: 1 / -1;
        color: var(--muted);
        max-width: 68ch;
        font-size: 0.95rem;
        line-height: 1.5;
        margin-top: 0.28rem;
      }
      .skills {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1.15rem 1.35rem;
      }
      .skills h3 {
        margin: 0 0 0.45rem;
        font-size: 0.92rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        line-height: 1.3;
      }
      .skill-items {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }
      .skill-items li {
        font-size: 0.78rem;
        font-weight: 500;
        line-height: 1.3;
        padding: 0.22rem 0.55rem;
        border-radius: 999px;
        background: var(--accent-soft);
        color: var(--ink);
        border: 1px solid transparent;
      }
      .foot {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1.5rem;
        margin-top: 0.35rem;
        padding-top: 1.15rem;
        border-top: 1px solid var(--rule);
        font-size: 0.88rem;
        color: var(--muted);
        line-height: 1.45;
      }
      .foot .edu-label {
        display: block;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--accent);
        margin-bottom: 0.3rem;
      }
      .foot .edu-value {
        color: var(--ink);
        font-weight: 600;
      }
      .foot .note {
        text-align: right;
        max-width: 36ch;
        color: var(--faint);
      }
      @media (max-width: 800px) {
        .highlights {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
        .skills {
          grid-template-columns: 1fr 1fr;
        }
      }
      @media (max-width: 640px) {
        .chrome,
        .wrap {
          padding-inline: 1rem;
        }
        .wrap {
          padding-bottom: 2.5rem;
        }
        .sheet {
          border-radius: 12px;
          padding: 1.35rem 1.1rem 1.5rem;
        }
        header.masthead {
          flex-direction: column;
          align-items: flex-start;
          gap: 0.85rem;
        }
        .contact {
          text-align: left;
        }
        .highlights {
          grid-template-columns: 1fr 1fr;
          gap: 0.95rem 0.85rem;
        }
        .skills {
          grid-template-columns: 1fr;
          gap: 1rem;
        }
        .foot {
          flex-direction: column;
          gap: 0.85rem;
        }
        .foot .note {
          text-align: left;
          max-width: none;
        }
        .job {
          grid-template-columns: 1fr;
          gap: 0.15rem;
        }
        .job .when {
          text-align: left;
          padding-top: 0;
        }
      }
      @page {
        size: Letter;
        margin: 0.4in 0.6in;
      }
      @media print {
        :root {
          --ink: #17181a;
          --muted: #4d5158;
          --faint: #5c6168;
          --rule: #d8d8d2;
          --accent: #1a4fad;
          --accent-soft: #fff;
          --bg: #fff;
          --sheet: #fff;
          --shadow: none;
        }
        html,
        body {
          background: #fff;
          color: #17181a;
          font-size: 9.4pt;
          line-height: 1.38;
        }
        .web-only {
          display: none !important;
        }
        .wrap {
          max-width: none;
          margin: 0;
          padding: 0;
        }
        .sheet {
          border: 0;
          border-radius: 0;
          box-shadow: none;
          padding: 0;
        }
        header.masthead {
          padding-bottom: 0.55rem;
          border-bottom-width: 1.5px;
          gap: 1rem;
        }
        h1 {
          font-size: 20pt;
        }
        .role {
          margin-top: 0.18rem;
          font-size: 10pt;
        }
        .contact {
          font-size: 8.75pt;
          line-height: 1.55;
        }
        .highlights {
          grid-template-columns: repeat(5, 1fr);
          gap: 0.45rem;
          padding: 0.55rem 0 0.6rem;
        }
        .highlights li strong {
          font-size: 11.5pt;
        }
        .highlights li span {
          font-size: 7.6pt;
        }
        section {
          padding-top: 0.62rem;
        }
        h2 {
          font-size: 7.6pt;
          margin-bottom: 0.28rem;
        }
        .summary {
          font-size: 9.2pt;
          line-height: 1.4;
          max-width: none;
        }
        .job {
          padding: 0.38rem 0;
          gap: 0.05rem 1rem;
        }
        .job .title {
          font-size: 9.6pt;
        }
        .job .co {
          font-size: 8.6pt;
          margin-top: 0;
        }
        .job .when {
          font-size: 8.5pt;
        }
        .job .sum {
          font-size: 8.7pt;
          margin-top: 0.12rem;
          max-width: none;
        }
        .skills {
          grid-template-columns: 1fr 1fr 1fr;
          gap: 0.4rem 1rem;
        }
        .skills h3 {
          font-size: 8.6pt;
          margin-bottom: 0.08rem;
        }
        .skill-items {
          display: block;
        }
        .skill-items li {
          display: inline;
          padding: 0;
          background: none;
          border: 0;
          font-size: 8pt;
          color: var(--muted);
          font-weight: 400;
        }
        .skill-items li:not(:last-child)::after {
          content: ' · ';
        }
        .foot {
          margin-top: 0.15rem;
          padding-top: 0.45rem;
          font-size: 8pt;
        }
        .foot .edu-label {
          font-size: 7.6pt;
          margin-bottom: 0.1rem;
        }
        a {
          color: inherit;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        * {
          transition: none !important;
        }
      }
    </style>
  </head>
  <body>
    <a class="skip web-only" href="#resume">Skip to résumé</a>
    <div class="chrome web-only">
      <a class="back" href={url('/')}>Back to site</a>
      <a class="btn" href={url(site.resumePdf)} download>Download PDF</a>
    </div>
    <div class="wrap">
      <article class="sheet" id="resume">
        <header class="masthead">
          <div>
            <h1>{site.name}</h1>
            <p class="role">{site.role}</p>
          </div>
          <p class="contact">
            {contacts.map((c, i) => (
              <>
                {i > 0 && <br />}
                <a href={c.href}>{c.label}</a>
              </>
            ))}
            <br />
            {site.location}
          </p>
        </header>

        <ul class="highlights" aria-label="Highlights">
          {highlights.map((s) => (
            <li>
              <strong>{s.value}</strong>
              <span>{s.label}</span>
            </li>
          ))}
        </ul>

        <section>
          <h2>Summary</h2>
          <p class="summary">{summary}</p>
        </section>

        <section>
          <h2>Experience</h2>
          <div class="jobs">
            <div class="job">
              <div>
                <span class="title">{freelance.title}</span>
                <span class="co">{freelance.company}</span>
              </div>
              <div class="when">{freelance.start} – {freelance.end}</div>
              <p class="sum">{freelance.summary}</p>
            </div>
            {roles.map((r) => (
              <div class="job">
                <div>
                  <span class="title">{r.title}</span>
                  <span class="co">
                    {r.company}
                    {r.location && (
                      <>
                        <span aria-hidden="true"> · </span>
                        <span class="loc">{r.location}</span>
                      </>
                    )}
                  </span>
                </div>
                <div class="when">{r.start} – {r.end}</div>
                <p class="sum">{r.summary}</p>
              </div>
            ))}
          </div>
        </section>

        <section>
          <h2>Skills & tools</h2>
          <div class="skills">
            {skillGroups.map((s) => (
              <div>
                <h3>{s.label}</h3>
                <ul class="skill-items">
                  {s.items.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            ))}
          </div>
        </section>

        <footer class="foot">
          <div>
            <span class="edu-label">Education</span>
            <span class="edu-value">{education.map((e) => `${e.school}, ${e.location}`).join('; ')}</span>
          </div>
          <p class="note">Full contract history and client feedback on Upwork. References on request.</p>
        </footer>
      </article>
    </div>
  </body>
</html>
