---
/**
 * Print-optimized résumé. Not linked in the nav; used to generate the PDF
 * in /public via `npm run resume:pdf`, and reachable at /resume for a web copy.
 */
import { site } from '@/data/site';
import { roles, education } from '@/data/experience';
import { services } from '@/data/services';
const summary =
  'Senior project manager and operations lead with 10+ years across federal research, universities, large corporations, startups and nonprofits. I take ownership of the moving parts, projects, timelines, tools, people and processes, so leadership can stay focused on growth. Lately also shipping iPhone apps and websites by directing AI models from brief to production.';
const skillLines = services.map((s) => ({ label: s.title, items: s.bullets.join(' · ') }));
const domain = site.url.replace(/^https?:\/\//, '');
const highlights = [...site.stats.map((s) => ({ value: s.value, label: s.label.replace(' on Upwork', '') })), { value: 'Since 2015', label: 'Full-time freelance' }];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={`Résumé of ${site.name}, ${site.role.toLowerCase()}.`} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{site.name} · Résumé</title>
    <style>
      :root {
        --ink: #17181a;
        --muted: #5b5f66;
        --faint: #8a8f97;
        --rule: #e4e4df;
        --accent: #1f5fd0;
      }
      * {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        background: #fff;
        color: var(--ink);
        font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        font-size: 9.5pt;
        line-height: 1.4;
      }
      .page {
        max-width: 8.5in;
        margin: 0 auto;
        padding: 0.6in 0.75in;
      }
      header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 1rem;
        padding-bottom: 0.7rem;
        border-bottom: 1px solid var(--ink);
      }
      h1 {
        font-size: 24pt;
        margin: 0;
        letter-spacing: -0.025em;
        line-height: 1.1;
      }
      .role {
        margin: 0.3rem 0 0;
        font-size: 10.5pt;
        color: var(--muted);
      }
      .contact {
        text-align: right;
        font-size: 9pt;
        color: var(--muted);
        line-height: 1.6;
      }
      .contact a {
        color: var(--ink);
        text-decoration: none;
      }
      .highlights {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 1rem;
        margin: 0;
        padding: 0.8rem 0;
        list-style: none;
        border-bottom: 1px solid var(--rule);
      }
      .highlights li strong {
        display: block;
        font-size: 13pt;
        letter-spacing: -0.02em;
        line-height: 1.2;
      }
      .highlights li span {
        color: var(--muted);
        font-size: 8.5pt;
      }
      h2 {
        font-size: 8pt;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--accent);
        margin: 1rem 0 0.45rem;
      }
      p {
        margin: 0;
      }
      .summary {
        max-width: 82ch;
        color: var(--ink);
      }
      .jobs {
        display: grid;
        gap: 0.45rem;
      }
      .job {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 0.05rem 1.5rem;
        break-inside: avoid;
      }
      .job strong {
        font-size: 10pt;
      }
      .job .co {
        color: var(--muted);
      }
      .job .when {
        color: var(--faint);
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
        text-align: right;
        font-size: 9pt;
        padding-top: 0.1rem;
      }
      .job .sum {
        grid-column: 1 / -1;
        color: var(--muted);
        max-width: 78ch;
      }
      .skills {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 0.6rem 1.5rem;
        font-size: 9pt;
      }
      .skills div strong {
        display: block;
        font-size: 9.25pt;
        margin-bottom: 0.1rem;
      }
      .skills div span {
        color: var(--muted);
      }
      .foot {
        display: flex;
        justify-content: space-between;
        gap: 1.5rem;
        margin-top: 1.1rem;
        padding-top: 0.6rem;
        border-top: 1px solid var(--rule);
        font-size: 8.5pt;
        color: var(--faint);
      }
      .foot span:first-child {
        white-space: nowrap;
      }
      .foot span:last-child {
        text-align: right;
      }
      .foot strong {
        color: var(--muted);
        font-weight: 600;
      }
      @media (max-width: 600px) {
        .page {
          padding: 1.25rem 1rem;
        }
        header {
          flex-direction: column;
          align-items: flex-start;
        }
        .contact {
          text-align: left;
        }
        .highlights {
          grid-template-columns: 1fr 1fr;
        }
        .skills {
          grid-template-columns: 1fr;
        }
        .foot {
          flex-direction: column;
          gap: 0.3rem;
        }
        .foot span:first-child {
          white-space: normal;
        }
        .foot span:last-child {
          text-align: left;
        }
        .job {
          grid-template-columns: 1fr;
        }
        .job .when {
          text-align: left;
        }
      }
      @page {
        size: Letter;
        margin: 0;
      }
      @media print {
        .page {
          padding: 0.45in 0.7in;
        }
      }
    </style>
  </head>
  <body>
    <div class="page">
      <header>
        <div>
          <h1>{site.name}</h1>
          <p class="role">{site.role}</p>
        </div>
        <div class="contact">
          <a href={`mailto:${site.email}`}>{site.email}</a><br />
          <a href={site.url}>{domain}</a><br />
          {site.location}
        </div>
      </header>

      <ul class="highlights">
        {highlights.map((s) => (
          <li><strong>{s.value}</strong><span>{s.label}</span></li>
        ))}
      </ul>

      <h2>Summary</h2>
      <p class="summary">{summary}</p>

      <h2>Experience</h2>
      <div class="jobs">
        <div class="job">
          <div><strong>Operations & Project Manager · Chief of Staff</strong> <span class="co">· Freelance, mostly via Upwork</span></div>
          <div class="when">2015 – Present</div>
          <div class="sum">300+ completed contracts across project management, systems and CRM setup, executive support, events and media, and web and app builds. Longest-running roles below.</div>
        </div>
        {roles.map((r) => (
          <div class="job">
            <div><strong>{r.title}</strong> <span class="co">· {r.company}</span></div>
            <div class="when">{r.start} – {r.end}</div>
            <div class="sum">{r.summary}</div>
          </div>
        ))}
      </div>

      <h2>Skills & tools</h2>
      <div class="skills">
        {skillLines.map((s) => (
          <div><strong>{s.label}</strong><span>{s.items}</span></div>
        ))}
      </div>

      <p class="foot">
        <span><strong>Education</strong> · {education.map((e) => `${e.school}, ${e.location}`).join('; ')}</span>
        <span>Full contract history and client feedback on Upwork. References on request.</span>
      </p>
    </div>
  </body>
</html>
