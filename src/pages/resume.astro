---
/**
 * Print-optimized résumé. Linked from the site nav, homepage and About.
 * Also used to generate the PDF in /public via `npm run resume:pdf`.
 */
import { Font } from 'astro:assets';
import Analytics from '@/components/Analytics.astro';
import { site } from '@/data/site';
import { roles, education } from '@/data/experience';
import { services } from '@/data/services';
import { url } from '@/lib/url';
import { ids, personNode, websiteNode } from '@/lib/schema';
import { shareCard } from '@/lib/share-card';

const summary =
  'Senior project manager and operations lead with 10+ years across federal research, universities, large corporations, startups and nonprofits. I own the moving parts (projects, timelines, tools, people and processes) so leadership can stay focused on growth. I also ship iPhone apps and websites by directing AI models from brief to production.';
/** Résumé-only skills, kept off the home page service cards. */
const resumeExtras: Record<string, string[]> = {
  'Executive assistant support': ['QuickBooks bookkeeping: bills, AP/AR, reports'],
  'CRM & automation': ['n8n and Keap'],
};
const skillGroups = services.map((s) => ({ label: s.title, items: [...s.bullets, ...(resumeExtras[s.title] ?? [])] }));
const domain = site.url.replace(/^https?:\/\//, '');
// One quiet line of facts under the masthead, not a band of big numbers. Upwork's own metrics
// keep the Upwork name; an employer outside Upwork wouldn't know them.
const highlightLabels = ['contracts', 'freelance hours', 'Job\u00a0Success', 'Top Rated Plus on Upwork'];
const highlights = site.stats.map((s, i) => ({ value: s.value, label: highlightLabels[i] ?? s.label }));
const freelance = {
  title: 'Operations & Project Manager\u00a0· Chief\u00a0of\u00a0Staff',
  company: 'Freelance, mostly via Upwork',
  start: '2015',
  end: 'Present',
  summary:
    '300+ contracts in project management, operations, CRM, executive support, events and web work. Key client roles below; many ran concurrently.',
};
const pageTitle = `${site.name} resume · Senior project manager, Chicago`;
const pageDesc = `Resume of ${site.name}, senior project manager and operations lead in Chicago: 300+ contracts since 2015, including SPARC, Symplicity and BARBRI.`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// The page's own share card (npm run og), or the site-wide default; both are 1200×630.
const card = shareCard(Astro.url.pathname);
const ogImage = new URL(card, Astro.site).href;
const ogAlt = card.endsWith('/og.png') ? `${site.name}, ${site.role}` : pageTitle;
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    websiteNode(),
    personNode(),
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: pageTitle,
      description: pageDesc,
      isPartOf: { '@id': ids.website },
      about: { '@id': ids.person },
      mainEntity: { '@id': ids.person },
      inLanguage: 'en-US',
    },
  ],
};
const contacts = [
  { href: `mailto:${site.email}`, label: site.email },
  { href: site.url, label: domain },
  { href: site.links.linkedin, label: site.links.linkedin.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '') },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <meta name="author" content={site.name} />
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={url('/favicon-96x96.png')} type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <Font cssVariable="--font-inter" preload />
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') {
          document.documentElement.dataset.theme = saved;
        }
      } catch {}
    </script>
    <style>
      /* The résumé is a sheet of paper in both themes, matching the PDF. Dark mode only
         darkens the backdrop and the two controls above the sheet. */
      :root {
        --ink: #17181a;
        --muted: #474b52;
        --faint: #646970;
        --rule: #dcdcd6;
        --accent: #1f5fd0;
        --accent-strong: #174aa6;
        --bg: #f1f1ed;
        --sheet: #ffffff;
        --shadow: 0 1px 2px rgb(0 0 0 / 0.05), 0 12px 32px -18px rgb(0 0 0 / 0.2);
        --radius: 3px;
        --chrome-ink: #17181a;
        --chrome-muted: #5b5f66;
        --chrome-rule: #d5d5cf;
        --chrome-btn: #ffffff;
        color-scheme: light;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) {
          --bg: #0f1114;
          --shadow: 0 1px 2px rgb(0 0 0 / 0.5), 0 16px 40px -18px rgb(0 0 0 / 0.8);
          --chrome-ink: #eef0f2;
          --chrome-muted: #a4abb5;
          --chrome-rule: #2c333c;
          --chrome-btn: #161a1f;
          color-scheme: dark;
        }
      }
      :root[data-theme='dark'] {
        --bg: #0f1114;
        --shadow: 0 1px 2px rgb(0 0 0 / 0.5), 0 16px 40px -18px rgb(0 0 0 / 0.8);
        --chrome-ink: #eef0f2;
        --chrome-muted: #a4abb5;
        --chrome-rule: #2c333c;
        --chrome-btn: #161a1f;
        color-scheme: dark;
      }
      * {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: var(--font-inter);
        font-size: 16px;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
      }
      a {
        color: var(--accent);
        text-decoration: none;
      }
      a:hover {
        color: var(--accent-strong);
      }
      :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
      }
      .skip {
        position: absolute;
        left: -999px;
        top: 0.5rem;
        background: var(--accent);
        color: #fff;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        z-index: 100;
      }
      .skip:focus {
        left: 0.5rem;
      }
      .chrome {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        max-width: 820px;
        margin: 0 auto;
        padding: 1.1rem 1.25rem 0;
      }
      .chrome :focus-visible {
        outline-color: var(--chrome-ink);
      }
      .back {
        color: var(--chrome-muted);
        font-size: 0.92rem;
        font-weight: 500;
        min-height: 44px;
        display: inline-flex;
        align-items: center;
      }
      .back:hover {
        color: var(--chrome-ink);
      }
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 40px;
        padding: 0.45rem 0.95rem;
        border-radius: 999px;
        font-weight: 600;
        font-size: 0.9rem;
        border: 1px solid var(--chrome-rule);
        color: var(--chrome-ink);
        background: var(--chrome-btn);
      }
      .btn:hover {
        border-color: var(--chrome-muted);
        color: var(--chrome-ink);
      }
      .wrap {
        max-width: 820px;
        margin: 0 auto;
        padding: 1rem 1.25rem 3.5rem;
      }
      .sheet {
        background: var(--sheet);
        color: var(--ink);
        color-scheme: light;
        border: 1px solid var(--rule);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: clamp(1.5rem, 4vw, 2.75rem) clamp(1.25rem, 4vw, 2.75rem);
      }
      /* Name, role, then the contacts as one row with the location under it. Side by side,
         the contacts squeezed into a narrow right column and broke mid-address. */
      header.masthead {
        padding-bottom: 1.15rem;
        border-bottom: 1.5px solid var(--ink);
      }
      h1 {
        font-size: clamp(1.8rem, 4.5vw, 2.2rem);
        margin: 0;
        letter-spacing: -0.022em;
        line-height: 1.1;
        font-weight: 700;
      }
      .role {
        margin: 0.45rem 0 0;
        font-size: 1.05rem;
        font-weight: 500;
        color: var(--muted);
        letter-spacing: -0.01em;
        text-wrap: balance;
      }
      /* Contact row and facts line: items split by hairlines. Each item's left rule sits just
         outside the list's clipped edge, so no row ever starts with a divider when it wraps. */
      .contact,
      .highlights {
        display: flex;
        flex-wrap: wrap;
        row-gap: 0.2rem;
        margin: 0 0 0 -0.8rem;
        padding: 0;
        list-style: none;
        overflow-x: clip;
        color: var(--muted);
      }
      .contact li,
      .highlights li {
        margin-left: -1px;
        padding: 0 0.8rem;
        border-left: 1px solid var(--rule);
        white-space: nowrap;
      }
      .contact {
        margin-top: 0.85rem;
        font-size: 0.93rem;
        line-height: 1.5;
      }
      .contact .where {
        flex-basis: 100%;
        white-space: normal;
      }
      .contact a {
        color: var(--ink);
        font-weight: 500;
      }
      .contact a:hover {
        color: var(--accent);
      }
      .highlights {
        margin-left: -0.65rem;
        padding-top: 0.8rem;
        font-size: 0.85rem;
        line-height: 1.5;
      }
      .highlights li {
        padding: 0 0.65rem;
      }
      .highlights li strong {
        color: var(--ink);
        font-weight: 700;
      }
      section {
        padding-top: 1.35rem;
      }
      h2 {
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ink);
        margin: 0 0 0.7rem;
        padding-bottom: 0.35rem;
        border-bottom: 1px solid var(--rule);
      }
      p {
        margin: 0;
      }
      .summary {
        max-width: 68ch;
        color: var(--ink);
        font-size: 0.98rem;
        line-height: 1.6;
      }
      .jobs {
        display: grid;
        gap: 0;
      }
      .job {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 0.15rem 1.5rem;
        padding: 0.7rem 0;
        break-inside: avoid;
      }
      .job:last-child {
        padding-bottom: 0;
      }
      .job:first-child {
        padding-top: 0.15rem;
      }
      .job .title {
        font-size: 1.02rem;
        font-weight: 700;
        letter-spacing: -0.015em;
        line-height: 1.3;
      }
      .job a.title {
        color: inherit;
        text-decoration: none;
      }
      .job a.title:hover {
        color: var(--accent);
      }
      .job .co {
        display: block;
        color: var(--muted);
        font-size: 0.92rem;
        font-weight: 500;
        margin-top: 0.12rem;
      }
      .job .loc {
        color: var(--faint);
        font-weight: 400;
      }
      .job .when {
        color: var(--faint);
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
        text-align: right;
        font-size: 0.9rem;
        font-weight: 500;
        padding-top: 0.12rem;
      }
      .job .bullets {
        grid-column: 1 / -1;
        margin: 0.3rem 0 0;
        padding-left: 1.1rem;
        color: var(--muted);
        font-size: 0.92rem;
        line-height: 1.5;
        max-width: 68ch;
      }
      .job .sum {
        grid-column: 1 / -1;
        color: var(--muted);
        max-width: 68ch;
        font-size: 0.95rem;
        line-height: 1.5;
        margin-top: 0.28rem;
      }
      .skills {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1.15rem 1.35rem;
      }
      /* Groups in a row share row tracks (subgrid, as on the site's cards), so every list starts
         on the same line even when one heading wraps. */
      .skills > div {
        display: grid;
        grid-row: span 2;
        grid-template-rows: subgrid;
        row-gap: 0;
      }
      .skills h3 {
        align-self: end;
        margin: 0 0 0.45rem;
        font-size: 0.92rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        line-height: 1.3;
      }
      /* A dot-separated line, as in print: whole phrases read badly as wrapped pills. */
      /* No one-word last lines ("…research / platform."). */
      .job .sum,
      .job .bullets,
      .skill-items {
        text-wrap: pretty;
      }
      .skill-items {
        display: block;
        margin: 0;
        padding: 0;
        list-style: none;
      }
      .skill-items li {
        display: inline;
        font-size: 0.88rem;
        font-weight: 400;
        line-height: 1.55;
        color: var(--muted);
      }
      .skill-items li:not(:last-child)::after {
        content: '\00a0· ';
      }
      .foot {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1.5rem;
        margin-top: 0.35rem;
        padding-top: 1.15rem;
        border-top: 1px solid var(--rule);
        font-size: 0.88rem;
        color: var(--muted);
        line-height: 1.45;
      }
      .foot .edu-label {
        display: block;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ink);
        margin-bottom: 0.3rem;
      }
      .foot .edu-value {
        color: var(--ink);
        font-weight: 600;
      }
      /* On screen the degree and the school each get a line, so neither breaks mid-name. */
      .foot .edu-degree {
        display: block;
      }
      .foot .note {
        text-align: right;
        max-width: 36ch;
        color: var(--faint);
      }
      @media (max-width: 800px) {
        /* Too narrow for the four facts on one line: two tidy columns, no dividers. */
        .highlights {
          display: grid;
          grid-template-columns: auto auto;
          justify-content: start;
          column-gap: 2rem;
          margin-left: 0;
        }
        .highlights li {
          margin-left: 0;
          padding: 0;
          border-left: 0;
        }
        .skills {
          grid-template-columns: 1fr 1fr;
        }
      }
      @media (max-width: 640px) {
        .chrome,
        .wrap {
          padding-inline: 1rem;
        }
        .wrap {
          padding-bottom: 2.5rem;
        }
        .sheet {
          border-radius: 12px;
          padding: 1.35rem 1.1rem 1.5rem;
        }
        .highlights {
          grid-template-columns: 1fr;
        }
        .contact {
          flex-direction: column;
          margin-left: 0;
        }
        .contact li,
        .highlights li {
          margin-left: 0;
          padding: 0;
          border-left: 0;
          white-space: normal;
        }
        .contact {
          margin-top: 0.75rem;
        }
        .skills {
          grid-template-columns: 1fr;
          gap: 1rem;
        }
        .foot {
          flex-direction: column;
          gap: 0.85rem;
        }
        .foot .note {
          text-align: left;
          max-width: none;
        }
        .job {
          grid-template-columns: 1fr;
          gap: 0.15rem;
        }
        .job .when {
          text-align: left;
          padding-top: 0;
        }
      }
      @page {
        size: Letter;
        margin: 0.35in 0.6in;
      }
      @media print {
        :root {
          --ink: #17181a;
          --muted: #4d5158;
          --faint: #5c6168;
          --rule: #d8d8d2;
          --accent: #1a4fad;
          --bg: #fff;
          --sheet: #fff;
          --shadow: none;
        }
        html,
        body {
          background: #fff;
          color: #17181a;
          font-size: 9.4pt;
          line-height: 1.38;
        }
        .web-only {
          display: none !important;
        }
        .wrap {
          max-width: none;
          margin: 0;
          padding: 0;
        }
        .sheet {
          border: 0;
          border-radius: 0;
          box-shadow: none;
          padding: 0;
        }
        /* On paper the page is wide enough for name and contacts side by side, as before:
           email, then site and LinkedIn, then location, right-aligned. */
        header.masthead {
          display: grid;
          grid-template-columns: auto auto;
          justify-content: space-between;
          align-items: end;
          column-gap: 1rem;
          padding-bottom: 0.45rem;
          border-bottom-width: 1.5px;
        }
        header.masthead h1,
        header.masthead .role {
          grid-column: 1;
        }
        header.masthead .contact {
          grid-column: 2;
          grid-row: 1 / span 2;
          display: block;
          margin: 0;
          text-align: right;
          overflow: visible;
        }
        .contact li {
          display: inline;
          margin: 0;
          padding: 0;
          border: 0;
        }
        .contact li:first-child,
        .contact .where {
          display: block;
        }
        .contact li:nth-child(3)::before {
          content: ' · ';
        }
        h1 {
          font-size: 20pt;
        }
        .role {
          margin-top: 0.18rem;
          font-size: 10pt;
        }
        .contact {
          font-size: 8.75pt;
          line-height: 1.4;
        }
        .highlights {
          padding-top: 0.5rem;
          font-size: 8.6pt;
        }
        section {
          padding-top: 0.6rem;
        }
        h2 {
          font-size: 7.6pt;
          margin-bottom: 0.25rem;
          padding-bottom: 0.14rem;
        }
        .summary {
          font-size: 9.2pt;
          line-height: 1.35;
          max-width: none;
        }
        .job {
          padding: 0.16rem 0;
          gap: 0.05rem 1rem;
        }
        .job .title {
          font-size: 9.6pt;
        }
        .job .co {
          font-size: 8.6pt;
          margin-top: 0;
        }
        .job .when {
          font-size: 8.5pt;
        }
        .job .bullets {
          font-size: 8.3pt;
          line-height: 1.3;
          margin-top: 0.04rem;
          /* The list starts at the page margin, so its padding must hold the whole outside bullet;
             at 0.9rem the PDF page edge cut each dot in half. */
          padding-left: 1.4em;
          max-width: none;
        }
        .job .sum {
          font-size: 8.7pt;
          line-height: 1.33;
          margin-top: 0.08rem;
          max-width: none;
        }
        .skills {
          grid-template-columns: 1fr 1fr 1fr;
          gap: 0.22rem 1rem;
        }
        .skills h3 {
          font-size: 8.6pt;
          margin-bottom: 0.04rem;
        }
        .skill-items {
          display: block;
          font-size: 8pt;
          line-height: 1.32;
        }
        .skill-items li {
          display: inline;
          padding: 0;
          background: none;
          border: 0;
          font-size: 8pt;
          color: var(--muted);
          font-weight: 400;
        }
        .skill-items li:not(:last-child)::after {
          content: '\00a0· ';
        }
        .foot {
          margin-top: 0.1rem;
          padding-top: 0.35rem;
          font-size: 8pt;
        }
        .foot .edu-label {
          font-size: 7.6pt;
          margin-bottom: 0.1rem;
        }
        /* The page is wide enough for one line, and the line it saves keeps the PDF to one page. */
        .foot .edu-degree {
          display: inline;
        }
        .foot .edu-degree::after {
          content: ',';
        }
        a {
          color: inherit;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        * {
          transition: none !important;
        }
      }
    </style>
  </head>
  <body>
    <a class="skip web-only" href="#resume">Skip to resume</a>
    <header class="chrome web-only">
      <a class="back" href={url('/')}>Back to site</a>
      <a class="btn" href={url(site.resumePdf)} download>Download PDF</a>
    </header>
    <main class="wrap">
      <article class="sheet" id="resume">
        <header class="masthead">
          <h1>{site.name}</h1>
          <p class="role">{site.role}</p>
          <ul class="contact" aria-label="Contact">
            {contacts.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
            <li class="where">{site.location}</li>
          </ul>
        </header>

        <ul class="highlights" aria-label="Highlights">
          {highlights.map((s) => (
            <li>
              <strong>{s.value}</strong> {s.label}
            </li>
          ))}
        </ul>

        <section>
          <h2>Summary</h2>
          <p class="summary">{summary}</p>
        </section>

        <section>
          <h2>Experience</h2>
          <div class="jobs">
            <div class="job">
              <div>
                <span class="title">{freelance.title}</span>
                <span class="co">{freelance.company}</span>
              </div>
              <div class="when">{freelance.start} – {freelance.end}</div>
              <p class="sum">{freelance.summary}</p>
            </div>
            {roles.map((r) => (
              <div class="job">
                <div>
                  {r.slug ? (
                    <a class="title" href={`${site.url}/work/${r.slug}/`}>{r.title}</a>
                  ) : (
                    <span class="title">{r.title}</span>
                  )}
                  <span class="co">
                    {r.company}
                    {r.location && (
                      <>
                        <span aria-hidden="true"> · </span>
                        <span class="loc">{r.location}</span>
                      </>
                    )}
                  </span>
                </div>
                <div class="when">{r.start} – {r.end}</div>
                <p class="sum">{r.summary}</p>
                {r.bullets && (
                  <ul class="bullets">
                    {r.bullets.map((b) => <li>{b}</li>)}
                  </ul>
                )}
              </div>
            ))}
          </div>
        </section>

        <section>
          <h2>Skills & tools</h2>
          <div class="skills">
            {skillGroups.map((s) => (
              <div>
                <h3>{s.label}</h3>
                <ul class="skill-items">
                  {s.items.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            ))}
          </div>
        </section>

        <footer class="foot">
          <div>
            <span class="edu-label">Education</span>
            {education.map((e) => (
              <span class="edu-value"><span class="edu-degree">{e.degree}</span> {e.school}, {e.location}</span>
            ))}
          </div>
          <p class="note">Full contract history and client feedback on Upwork. References on request.</p>
        </footer>
      </article>
    </main>
    <Analytics />
  </body>
</html>
