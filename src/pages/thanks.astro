---
import Base from '@/layouts/Base.astro';
import { site } from '@/data/site';
import { url } from '@/lib/url';
---

<Base title="Message sent" description="Thanks for getting in touch." noindex>
  <section class="section">
    <div class="container">
      <span class="eyebrow">Thanks</span>
      <h1>Got it. I'll reply within one business day.</h1>
      <p class="lede">
        Your message is on its way to my inbox. If it's urgent, email <a href={`mailto:${site.email}`}>{site.email}</a> directly.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href={url('/')}>Back home</a>
        <a class="btn btn-secondary" href={url('/clients')}>See my work</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* inline-block moves the whole address to the next line instead of splitting it at a hyphen;
     it only breaks inside on a screen narrower than the address itself. */
  .lede a {
    display: inline-block;
    overflow-wrap: anywhere;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
</style>
