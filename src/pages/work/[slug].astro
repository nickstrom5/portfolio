---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '@/layouts/Base.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import Testimonial from '@/components/Testimonial.astro';
import { getImage } from 'astro:assets';
import testimonials from '@/data/testimonials.json';
import { site } from '@/data/site';
import { url } from '@/lib/url';
import { categoryLabel } from '@/lib/categories';
import { ids } from '@/lib/schema';
import { lastCommit, projectSources } from '@/lib/git-date.mjs';
import { shareCard } from '@/lib/share-card';
import { showcaseAsset } from '@/lib/showcase-images';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.hidden);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;
const quotes = testimonials.filter((t) => 'slug' in t && t.slug === project.id);
const coverAlt = `Screenshot of ${d.shortTitle ?? d.title}`;
// Link previews want 1200×630: the top of the cover screenshot, cropped to fit. Never read .src or
// .width on the asset itself, or Astro also publishes the untouched original.
const coverAsset = d.cover ? showcaseAsset(d.cover) : undefined;
if (d.cover && !coverAsset) throw new Error(`${project.id}: cover ${d.cover} is not in src/assets/showcase/`);
const shareImage = coverAsset
  ? (await getImage({ src: coverAsset, width: 1200, height: 630, fit: 'cover', position: 'top', format: 'jpg' })).src
  : undefined;
const category = categoryLabel(d.category);

// Rotate through the category so every case study gets related links, not just the first two alphabetically.
// Featured roles point to the other featured roles instead.
const peers = (await getCollection('projects', ({ data }) => !data.hidden))
  .filter((p) => (d.featured ? p.data.featured : p.data.category === d.category))
  .sort((a, b) => a.id.localeCompare(b.id));
const i = peers.findIndex((p) => p.id === project.id);
const related = [...peers.slice(i + 1), ...peers.slice(0, i)].slice(0, 2);
const relatedHeading = d.featured ? 'Other long-term roles' : `More ${category.toLowerCase()} work`;

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const iso = (dt: Date) => dt.toISOString().slice(0, 10);
// The later of the frontmatter date and the write-up's last commit (the sitemap's lastmod source),
// so a retitled case study doesn't keep an old dateModified.
const lastEdit = lastCommit(projectSources(project.id))?.slice(0, 10);
const dateModified = d.published ? [iso(d.updated ?? d.published), lastEdit ?? ''].sort().at(-1) : undefined;
const shortDate = (dt: Date) => dt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

const sourceLabel = { upwork: 'Upwork contract', direct: 'Direct client', personal: 'Personal project' }[d.source];
// The closing button speaks to the kind of work and opens Contact with that topic picked.
const build = ['development', 'mobile', 'web', 'backend'].includes(d.category);
const cta =
  d.source === 'personal' || build
    ? 'Build something similar'
    : ({ admin: 'Get support like this', automation: 'Automate something similar' } as Record<string, string>)[d.category] ?? 'Talk about a project like this';
const topic = build
  ? 'Website or app build'
  : ({ admin: 'Executive & admin support', operations: 'Operations & systems setup', automation: 'CRM & automation', video: 'Events, webinars & video', consulting: 'Project management' } as Record<string, string>)[d.category];
const ctaHref = url(`/contact?${new URLSearchParams({ ...(topic ? { about: topic } : {}), from: project.id })}`);
// "Remote" alone says nothing a case study doesn't already.
const platforms = d.platforms.filter((p) => p !== 'Remote').length > 0 ? d.platforms : [];
const links = [
  // A client's site is already linked from the Client row.
  d.links.live && d.source === 'personal' && { label: 'Live site', href: d.links.live },
  d.links.appStore && { label: 'App Store', href: d.links.appStore },
  d.links.playStore && { label: 'Google Play', href: d.links.playStore },
  d.links.repo && { label: 'Source', href: d.links.repo },
].filter(Boolean) as { label: string; href: string }[];
---

<Base
  title={d.shortTitle ?? d.title}
  description={d.summary}
  ogType="article"
  image={shareImage}
  imageSize={shareImage ? { width: 1200, height: 630 } : undefined}
  imageAlt={shareImage ? coverAlt : undefined}
  breadcrumbs={[{ name: 'Work', path: '/work/' }, { name: d.shortTitle ?? d.title, path: Astro.url.pathname }]}
  jsonLd={[
    {
      '@type': 'Article',
      '@id': `${pageUrl}#article`,
      headline: d.title,
      description: d.summary,
      url: pageUrl,
      image: [new URL(shareImage ?? shareCard(Astro.url.pathname), Astro.site).href],
      inLanguage: 'en-US',
      isPartOf: { '@id': ids.website },
      keywords: d.stack.join(', '),
      ...(d.published ? { datePublished: iso(d.published), dateModified } : {}),
      author: { '@type': 'Person', '@id': ids.person, name: site.name, url: `${site.url}/about/` },
      publisher: { '@id': ids.person },
      mainEntityOfPage: { '@id': `${pageUrl}#webpage` },
      // Only clients already named and linked on the page; anonymized clients have no live link.
      ...(d.source !== 'personal' && d.links.live ? { about: { '@type': 'Organization', name: d.client, url: d.links.live } } : {}),
    },
  ]}
>
  <article class="section">
    <div class="container">
      <a class="back" href={url('/work')}>← All work</a>
      <span class="eyebrow">{category} · {d.year}</span>
      <h1>{d.title}</h1>
      <p class="lede">{d.summary}</p>

      <div class="layout">
        <div class="prose">
          <Content />
        </div>
        <section class="facts card" aria-label="Project facts">
          <dl>
            <dt>Client</dt>
            <dd>
              {d.links.live && d.source !== 'personal' ? (
                <a class="client-link" href={d.links.live} target="_blank" rel="noopener">{d.client} <span aria-hidden="true">↗</span></a>
              ) : (
                d.client
              )}
            </dd>
            <dt>Engagement</dt>
            <dd>{sourceLabel}</dd>
            {d.dates && (
              <>
                <dt>Dates</dt>
                <dd>{d.dates}</dd>
              </>
            )}
            {platforms.length > 0 && (
              <>
                <dt>Platforms</dt>
                <dd>{platforms.join(', ')}</dd>
              </>
            )}
            <dt>Stack</dt>
            <dd>
              <ul class="tags">
                {d.stack.map((s) => <li class="tag">{s}</li>)}
              </ul>
            </dd>
            {links.length > 0 && (
              <>
                <dt>Links</dt>
                <dd class="links">
                  {links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label}</a>)}
                </dd>
              </>
            )}
            {d.published && (
              <>
                <dt>Published</dt>
                <dd><time datetime={iso(d.published)}>{shortDate(d.published)}</time></dd>
              </>
            )}
          </dl>
          <a class="btn btn-primary full" href={ctaHref}>{cta}</a>
          {d.source !== 'personal' && <a class="btn btn-secondary full" href={url('/resume')}>View resume</a>}
        </section>
      </div>
    </div>
  </article>

  {quotes.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head">
          <h2>Client feedback</h2>
        </div>
        {quotes.map((t) => <Testimonial {...t} />)}
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head">
          <h2>{relatedHeading}</h2>
        </div>
        <div class="grid grid-2">
          {related.map((p) => <ProjectCard project={p} />)}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .back {
    display: block;
    width: fit-content;
    margin-bottom: 1.5rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 3rem;
    margin-top: 2.5rem;
    align-items: start;
  }
  .facts {
    position: sticky;
    top: 88px;
  }
  dl {
    margin: 0 0 1.25rem;
  }
  dt {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-faint);
    font-weight: 600;
    margin-top: 1rem;
  }
  dt:first-child {
    margin-top: 0;
  }
  dd {
    margin: 0.2rem 0 0;
  }
  .links {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .full {
    width: 100%;
    justify-content: center;
    text-align: center;
  }
  .full + .full {
    margin-top: 0.6rem;
  }
  @media (max-width: 860px) {
    .layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .facts {
      position: static;
    }
  }
  .client-link {
    display: inline-block;
    font-weight: 600;
    padding: 0.6rem 0;
    margin: -0.6rem 0;
  }
</style>
