---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '@/layouts/Base.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import Testimonial from '@/components/Testimonial.astro';
import testimonials from '@/data/testimonials.json';
import { site } from '@/data/site';
import { url } from '@/lib/url';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;
const quotes = testimonials.filter((t) => 'slug' in t && t.slug === project.id);
const coverAlt = `Screenshot of ${d.shortTitle ?? d.title}`;

// Rotate through the category so every case study gets related links, not just the first two alphabetically.
const peers = (await getCollection('projects'))
  .filter((p) => p.data.category === d.category)
  .sort((a, b) => a.id.localeCompare(b.id));
const i = peers.findIndex((p) => p.id === project.id);
const related = [...peers.slice(i + 1), ...peers.slice(0, i)].slice(0, 2);

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const iso = (dt: Date) => dt.toISOString().slice(0, 10);
const shortDate = (dt: Date) => dt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

const sourceLabel = { upwork: 'Upwork contract', direct: 'Direct client', personal: 'Personal project' }[d.source];
const links = [
  d.links.live && { label: d.source === 'personal' ? 'Live site' : 'Client website', href: d.links.live },
  d.links.appStore && { label: 'App Store', href: d.links.appStore },
  d.links.playStore && { label: 'Google Play', href: d.links.playStore },
  d.links.repo && { label: 'Source', href: d.links.repo },
].filter(Boolean) as { label: string; href: string }[];
---

<Base
  title={d.shortTitle ?? d.title}
  description={d.summary}
  ogType="article"
  image={d.cover}
  imageAlt={d.cover ? coverAlt : undefined}
  breadcrumbs={[{ name: 'Work', path: '/work/' }, { name: d.shortTitle ?? d.title, path: Astro.url.pathname }]}
  jsonLd={[
    {
      '@type': 'Article',
      '@id': `${pageUrl}#article`,
      headline: d.title,
      description: d.summary,
      url: pageUrl,
      image: [new URL(d.cover ?? '/og.png', Astro.site).href],
      inLanguage: 'en-US',
      isPartOf: { '@id': `${site.url}/#website` },
      keywords: d.stack.join(', '),
      ...(d.published ? { datePublished: iso(d.published), dateModified: iso(d.updated ?? d.published) } : {}),
      author: { '@type': 'Person', '@id': `${site.url}/#person`, name: site.name, url: `${site.url}/about/` },
      publisher: { '@id': `${site.url}/#person` },
      mainEntityOfPage: { '@id': `${pageUrl}#webpage` },
      // Only clients already named and linked on the page; anonymized clients have no live link.
      ...(d.source !== 'personal' && d.links.live ? { about: { '@type': 'Organization', name: d.client, url: d.links.live } } : {}),
    },
  ]}
>
  <article class="section">
    <div class="container">
      <a class="back" href={url('/work')}>← All work</a>
      <span class="eyebrow">{d.category} · {d.year}</span>
      <h1>{d.title}</h1>
      <p class="lede">{d.summary}</p>

      <div class="layout">
        <div class="prose">
          <Content />
        </div>
        <aside class="facts card">
          <dl>
            <dt>Client</dt>
            <dd>
              {d.links.live && d.source !== 'personal' ? (
                <a class="client-link" href={d.links.live} target="_blank" rel="noopener">{d.client} <span aria-hidden="true">↗</span></a>
              ) : (
                d.client
              )}
            </dd>
            <dt>Engagement</dt>
            <dd>{sourceLabel}</dd>
            {d.published && (
              <>
                <dt>Published</dt>
                <dd><time datetime={iso(d.published)}>{shortDate(d.published)}</time></dd>
              </>
            )}
            {d.platforms.length > 0 && (
              <>
                <dt>Platforms</dt>
                <dd>{d.platforms.join(', ')}</dd>
              </>
            )}
            <dt>Stack</dt>
            <dd>
              <ul class="tags">
                {d.stack.map((s) => <li class="tag">{s}</li>)}
              </ul>
            </dd>
            {links.length > 0 && (
              <>
                <dt>Links</dt>
                <dd class="links">
                  {links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label}</a>)}
                </dd>
              </>
            )}
          </dl>
          <a class="btn btn-primary full" href={url('/contact')}>Build something similar</a>
        </aside>
      </div>
    </div>
  </article>

  {quotes.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head">
          <h2>Client feedback</h2>
        </div>
        {quotes.map((t) => <Testimonial {...t} />)}
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head">
          <h2>More {d.category} work</h2>
        </div>
        <div class="grid grid-2">
          {related.map((p) => <ProjectCard project={p} />)}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .back {
    display: block;
    width: fit-content;
    margin-bottom: 1.5rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 3rem;
    margin-top: 2.5rem;
    align-items: start;
  }
  .facts {
    position: sticky;
    top: 88px;
  }
  dl {
    margin: 0 0 1.25rem;
  }
  dt {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-faint);
    font-weight: 600;
    margin-top: 1rem;
  }
  dt:first-child {
    margin-top: 0;
  }
  dd {
    margin: 0.2rem 0 0;
  }
  .links {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .full {
    width: 100%;
    justify-content: center;
  }
  @media (max-width: 860px) {
    .layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .facts {
      position: static;
    }
  }
  .client-link {
    display: inline-block;
    font-weight: 600;
    padding: 0.6rem 0;
    margin: -0.6rem 0;
  }
</style>
