---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import contracts from '@/data/contracts.json';
import { site } from '@/data/site';
import { roles, education } from '@/data/experience';
import { url } from '@/lib/url';

const projects = (await getCollection('projects')).sort((a, b) => b.data.year - a.data.year);
const order = ['consulting', 'operations', 'admin', 'automation', 'video', 'development', 'mobile', 'web', 'backend', 'other'];
const labels: Record<string, string> = { all: 'All', video: 'Events & video' };
const categories = ['all', ...order.filter((c) => projects.some((p) => p.data.category === c))];
const upworkLive = !site.links.upwork.includes('REPLACE');
---

<Base title="Work" description="Case studies and featured roles from 300+ freelance contracts: project management, operations, CRM, events and app builds.">
  <section class="section">
    <div class="container">
      <span class="eyebrow">Work</span>
      <h1>Client projects</h1>
      <p class="lede">A selection of contracts I can talk about publicly. Some engagements may be vague due to NDA requirements.</p>

      <div class="toolbar">
        <div class="filters" role="group" aria-label="Filter by category">
          {categories.map((c) => (
            <button class:list={['chip', { active: c === 'all' }]} data-filter={c} aria-pressed={c === 'all'}>
              {labels[c] ?? c.charAt(0).toUpperCase() + c.slice(1)}
            </button>
          ))}
        </div>
        <div class="tools">
          <a class="btn btn-secondary" href="#roles">Featured roles ↓</a>
        </div>
      </div>

      <div class="grid grid-3" data-project-grid>
        {projects.map((p) => (
          <div data-category={p.data.category}>
            <ProjectCard project={p} level={2} />
          </div>
        ))}
      </div>
      <p class="empty muted" data-empty hidden>No projects in this category yet.</p>
    </div>
  </section>

  <section class="section" id="roles">
    <div class="container">
      <span class="eyebrow">Experience</span>
      <div class="section-head">
        <h2>Featured roles</h2>
        <a href={url('/clients')}>Featured clients →</a>
      </div>
      <p class="lede">
        Freelancing full-time since 2015. These are the longest-running roles from 300+ contracts, 257 of them on Upwork; the rest ranged from a week to a year.
      </p>
      <ol class="roles">
        {roles.map((r) => (
          <li>
            <span class="years">{r.start}–{r.end}</span>
            <span class="what">
              <strong>{r.title}</strong>
              <span class="company">{r.company}</span>
            </span>
            {r.slug ? <a class="detail" href={url(`/work/${r.slug}`)}>Details →</a> : <span />}
          </li>
        ))}
      </ol>
      <p class="edu muted">
        Education: {education.map((e) => `${e.school}, ${e.location}`).join('; ')} · Full history in the <a href={url('/resume')}>resume</a>{upworkLive && <> or on <a href={site.links.upwork} target="_blank" rel="noopener">Upwork</a></>}.
      </p>
    </div>
  </section>

  <section class="section" id="contracts">
    <div class="container">
      <span class="eyebrow">Upwork</span>
      <div class="section-head">
        <h2>Recent contracts</h2>
        {upworkLive && <a href={site.links.upwork} target="_blank" rel="noopener">Full history on Upwork →</a>}
      </div>
      <p class="lede">A sample of contract titles from the last two years, out of 257 completed on Upwork and 300+ overall. Client names are kept private.</p>
      <ul class="contracts">
        {contracts.map((c) => (
          <li>
            <span class="c-title">{c.title}</span>
            <span class="c-meta muted">{c.type} · {c.year}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('[data-project-grid] > [data-category]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter;
      buttons.forEach((b) => {
        const on = b === btn;
        b.classList.toggle('active', on);
        b.setAttribute('aria-pressed', String(on));
      });
      let visible = 0;
      items.forEach((el) => {
        const show = filter === 'all' || el.dataset.category === filter;
        el.hidden = !show;
        if (show) visible++;
      });
      if (empty) empty.hidden = visible > 0;
    });
  });
</script>

<style>
  .roles {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  .roles li {
    display: grid;
    grid-template-columns: 7rem 1fr auto;
    gap: 1rem;
    align-items: baseline;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
  }
  .years {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }
  .what {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    align-items: baseline;
  }
  .what strong {
    font-size: 1.05rem;
  }
  .company {
    color: var(--text-muted);
  }
  .detail {
    font-size: 0.9rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .edu {
    margin: 1.25rem 0 0;
    font-size: 0.9rem;
  }
  @media (max-width: 800px) {
    .roles li {
      grid-template-columns: 1fr auto;
    }
    .years {
      grid-column: 1 / -1;
    }
  }
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 1.5rem 0 2rem;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tools .btn {
    padding: 0.45rem 0.95rem;
    font-size: 0.9rem;
  }
  #roles {
    scroll-margin-top: 80px;
  }
  .chip {
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-elev);
    color: var(--text-muted);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
  }
  .chip.active {
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
  }
  .empty {
    margin-top: 1.5rem;
  }
  .contracts {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 0.5rem 2rem;
  }
  .contracts li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.95rem;
  }
  .c-meta {
    font-size: 0.82rem;
    white-space: nowrap;
  }
</style>
