---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import contracts from '@/data/contracts.json';
import { site } from '@/data/site';
import { roles, staffJob, education } from '@/data/experience';
import { url } from '@/lib/url';
import { categoryLabel } from '@/lib/categories';

// Featured client work first, own products last, newest first within each.
const projects = (await getCollection('projects', ({ data }) => !data.hidden)).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    Number(a.data.source === 'personal') - Number(b.data.source === 'personal') ||
    b.data.year - a.data.year,
);
const order = ['consulting', 'operations', 'admin', 'automation', 'video', 'development', 'mobile', 'web', 'backend', 'other'];
const categories = ['all', ...order.filter((c) => projects.some((p) => p.data.category === c))];
const upworkLive = !site.links.upwork.includes('REPLACE');
---

<Base title="Project management and operations case studies" description="Case studies from 300+ freelance contracts: project management, operations, executive assistant work, webinars, Zapier/HubSpot/Zoho automation and AI-built apps.">
  <section class="section">
    <div class="container">
      <span class="eyebrow">Work</span>
      <h1>Client projects</h1>
      <p class="lede">Contracts I can talk about publicly, plus a few products of my own. Some clients are unnamed under NDA. GoHighLevel builds have their own page: <a href={url('/ghl')}>GoHighLevel automation case studies</a>.</p>

      <div class="toolbar">
        <div class="filters" role="group" aria-label="Filter by category">
          {categories.map((c) => (
            <button class:list={['chip', { active: c === 'all' }]} data-filter={c} aria-pressed={c === 'all'}>
              {c === 'all' ? 'All' : categoryLabel(c)}
            </button>
          ))}
        </div>
        <div class="tools">
          <a class="btn btn-secondary" href="#roles">Featured roles ↓</a>
        </div>
      </div>

      <div class="grid grid-3" data-project-grid>
        {projects.map((p) => (
          <div data-category={p.data.category}>
            <ProjectCard project={p} level={2} />
          </div>
        ))}
      </div>
      <p class="empty muted" data-empty hidden>No projects in this category yet.</p>
    </div>
  </section>

  <section class="section" id="roles">
    <div class="container">
      <span class="eyebrow">Experience</span>
      <div class="section-head">
        <h2>Featured roles</h2>
        <a href={url('/clients')}>Featured clients →</a>
      </div>
      <p class="lede">
        Freelancing since 2015, with 300+ contracts lasting from a few days to several years, 257 of them on Upwork. Below are key client roles{staffJob && `, plus a staff job at ${staffJob.company}`}.
      </p>
      <ol class="roles">
        {roles.map((r) => (
          <li>
            <span class="years">{r.start}–{r.end}</span>
            <span class="what">
              <strong>{r.title}</strong>
              <span class="company">{r.company}</span>
            </span>
            {r.slug ? <a class="detail" href={url(`/work/${r.slug}`)}>{r.company.split(' · ')[0]} case study →</a> : <span />}
          </li>
        ))}
      </ol>
      <p class="edu muted">
        Education: {education.map((e) => `${e.school}, ${e.location}`).join('; ')} · Full history in the <a href={url('/resume')}>resume</a>{upworkLive && <> or on <a href={site.links.upwork} target="_blank" rel="noopener">Upwork</a></>}.
      </p>
    </div>
  </section>

  <section class="section" id="contracts">
    <div class="container">
      <span class="eyebrow">Upwork</span>
      <div class="section-head">
        <h2>Recent contracts</h2>
        {upworkLive && <a href={site.links.upwork} target="_blank" rel="noopener">Full history on Upwork →</a>}
      </div>
      <p class="lede">A sample of contract titles since 2024, out of 257 completed on Upwork and 300+ overall. Client names are kept private.</p>
      <ul class="contracts">
        {contracts.map((c) => (
          <li>
            <span class="c-title">{c.title}</span>
            <span class="c-meta muted">{c.type} · {c.year}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('[data-project-grid] > [data-category]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter;
      buttons.forEach((b) => {
        const on = b === btn;
        b.classList.toggle('active', on);
        b.setAttribute('aria-pressed', String(on));
      });
      let visible = 0;
      items.forEach((el) => {
        const show = filter === 'all' || el.dataset.category === filter;
        el.hidden = !show;
        if (show) visible++;
      });
      if (empty) empty.hidden = visible > 0;
    });
  });
</script>

<style>
  .roles {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  .roles li {
    display: grid;
    grid-template-columns: 7rem 1fr auto;
    gap: 1rem;
    align-items: baseline;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
  }
  .years {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }
  .what {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    align-items: baseline;
  }
  .what strong {
    font-size: 1.05rem;
  }
  .company {
    color: var(--text-muted);
  }
  .detail {
    font-size: 0.9rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .edu {
    margin: 1.25rem 0 0;
    font-size: 0.9rem;
  }
  .edu a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    text-decoration-color: color-mix(in srgb, currentColor 45%, transparent);
  }
  @media (max-width: 800px) {
    .roles li {
      grid-template-columns: 1fr auto;
    }
    .years {
      grid-column: 1 / -1;
    }
    .detail {
      white-space: normal;
      text-align: right;
    }
  }
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 1.5rem 0 2rem;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tools .btn {
    padding: 0.45rem 0.95rem;
    font-size: 0.9rem;
  }
  .chip {
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-elev);
    color: var(--text-muted);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
  }
  .chip.active {
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
  }
  .empty {
    margin-top: 1.5rem;
  }
  /* Pass the grid's rows through each filter wrapper so cards share row tracks
     (see ProjectCard). :not([hidden]) keeps filtered-out cards hidden. */
  [data-project-grid] > [data-category]:not([hidden]) {
    display: grid;
    grid-row: span 5;
    grid-template-rows: subgrid;
    row-gap: 0.5rem;
  }
  .contracts {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 0.5rem 2rem;
  }
  /* Title, then type and year underneath; items in a row share row tracks (subgrid),
     so every type line in the row sits on the same line. */
  .contracts li {
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    row-gap: 0.2rem;
    align-content: start;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.95rem;
  }
  .c-meta {
    font-size: 0.82rem;
    white-space: nowrap;
  }
</style>
