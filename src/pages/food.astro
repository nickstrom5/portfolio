---
/**
 * /food/: Nick's food portfolio, shared by link (for example with job applications)
 * and linked from one line on the About page. It is noindex and left out of the
 * sitemap, so it stays out of search results. Add photos with `npm run food:add`
 * (see src/assets/food/README.md).
 */
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import food from '@/data/food.json';

// Per-photo title, one-line note and alt text; photos listed here come first, in this order.
type Entry = { title?: string; note?: string; alt?: string };
const entries = food.photos as Record<string, Entry>;
const order = Object.keys(entries);

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/food/*.{jpg,jpeg,png,webp,avif}', { eager: true });

const photos = await Promise.all(
  Object.entries(files).map(async ([path, mod]) => {
    const file = path.split('/').pop()!;
    // File names look like cacio-e-pepe.jpg or 2026-10-09-cacio-e-pepe.jpg; without an
    // entry in food.json the name becomes the title.
    const m = file.match(/^(\d{4}-\d{2}-\d{2})-(.+)\.[a-z]+$/i);
    const date = m ? m[1] : '';
    const words = (m ? m[2] : file.replace(/\.[a-z]+$/i, '')).replace(/-\d+$/, '').replace(/-/g, ' ');
    const e = entries[file] ?? {};
    const title = e.title ?? words.charAt(0).toUpperCase() + words.slice(1);
    // Never read .width/.src etc. on the imported image here: any property read makes Astro
    // also publish the untouched original (with whatever metadata it has). getImage does not
    // enlarge, so a fixed width is safe for small photos.
    const full = await getImage({ src: mod.default, width: 1600, format: 'webp' });
    return { file, date, title, note: e.note ?? '', alt: e.alt ?? title, img: mod.default, full: full.src };
  }),
);
// Listed photos in food.json order, then the rest newest first.
const rank = (f: string) => (order.includes(f) ? order.indexOf(f) : order.length);
photos.sort((a, b) => rank(a.file) - rank(b.file) || b.date.localeCompare(a.date) || a.file.localeCompare(b.file));

// Link previews (email, LinkedIn, Slack) show the first photo. JPEG, because some
// preview scrapers still skip WebP.
const preview = photos[0]
  ? (await getImage({ src: photos[0].img, width: 1200, format: 'jpg' })).src
  : undefined;

---

<Base title={food.title} description={food.description} image={preview} imageAlt={photos[0]?.alt} noindex>
  <section class="section">
    <div class="container">
      <span class="eyebrow">{food.eyebrow}</span>
      <h1>{food.title}</h1>
      <p class="lede">{food.intro}</p>

      {photos.length === 0 ? (
        <p class="empty muted">No photos yet.</p>
      ) : (
        <ul class="gallery" data-gallery>
          {photos.map((p, i) => (
            <li>
              <a href={p.full} data-full data-index={i} data-caption={p.note ? `${p.title}. ${p.note}` : p.title}>
                <Image src={p.img} alt={p.alt} widths={[320, 640]} sizes="(max-width: 640px) 50vw, 300px" loading={i < 4 ? 'eager' : 'lazy'} decoding="async" />
              </a>
              <h2 class="cap-title">{p.title}</h2>
              {p.note && <p class="cap-note muted">{p.note}</p>}
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <dialog class="lightbox" aria-labelledby="lb-cap" data-lightbox>
    <figure>
      <img alt="" data-lb-img />
      <figcaption id="lb-cap" aria-live="polite" data-lb-cap></figcaption>
    </figure>
    <button class="lb-btn lb-close" type="button" aria-label="Close" data-lb-close>×</button>
    <button class="lb-btn lb-prev" type="button" aria-label="Previous photo" data-lb-prev>‹</button>
    <button class="lb-btn lb-next" type="button" aria-label="Next photo" data-lb-next>›</button>
  </dialog>
</Base>

<script>
  // Without JS each photo simply links to its full-size image.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-full]')];
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const img = document.querySelector<HTMLImageElement>('[data-lb-img]');
  const cap = document.querySelector<HTMLElement>('[data-lb-cap]');
  let current = 0;

  function show(i: number) {
    if (!links.length || !img || !cap) return;
    current = (i + links.length) % links.length;
    const link = links[current];
    const thumb = link.querySelector('img');
    img.removeAttribute('src'); // never paint the previous photo under the new caption
    if (thumb) {
      // Reserve the photo's box while it loads.
      img.setAttribute('width', thumb.getAttribute('width') ?? '');
      img.setAttribute('height', thumb.getAttribute('height') ?? '');
    }
    img.src = link.href;
    img.alt = link.querySelector('img')?.alt ?? '';
    cap.textContent = link.dataset.caption ?? '';
  }

  if (dialog && typeof dialog.showModal === 'function') {
    links.forEach((link, i) =>
      link.addEventListener('click', (e) => {
        e.preventDefault();
        show(i);
        dialog.showModal();
      }),
    );
    dialog.querySelector('[data-lb-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-lb-next]')?.addEventListener('click', () => show(current + 1));
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
    // A click on the backdrop (the dialog itself, outside the figure) closes it.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => links[current]?.focus());
  }
</script>

<style>
  .empty {
    margin-top: 1.5rem;
  }
  .gallery {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 160px), 1fr));
    gap: 1.25rem 1rem;
  }
  @media (min-width: 900px) {
    .gallery {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .gallery a {
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-muted);
  }
  .gallery img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    transition: transform 0.2s ease;
  }
  .gallery a:hover img {
    transform: scale(1.03);
  }
  .cap-title {
    margin: 0.65rem 0 0;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .cap-note {
    margin: 0.2rem 0 0;
    font-size: 0.9rem;
  }

  .lightbox {
    width: min(96vw, 1100px);
    max-width: none;
    max-height: 94vh;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: #0b0b0e;
    color: #fff;
    overflow: visible;
  }
  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.8);
  }
  .lightbox figure {
    margin: 0;
  }
  /* Natural size, never enlarged: a small photo stays sharp, centered on the dark dialog. */
  .lightbox img {
    display: block;
    width: auto;
    max-width: 100%;
    margin-inline: auto;
    height: auto;
    max-height: calc(94vh - 3.5rem);
    object-fit: contain;
    border-radius: var(--radius) var(--radius) 0 0;
  }
  .lightbox figcaption {
    padding: 0.85rem 1rem;
    font-size: 0.95rem;
  }
  .lb-btn {
    position: absolute;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.55);
    color: #fff;
    font: inherit;
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
  }
  /* Two-tone ring: visible over light and dark photos alike. */
  .lb-btn:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 0;
    box-shadow: 0 0 0 4px #000;
  }
  .lb-close {
    top: 0.6rem;
    right: 0.6rem;
  }
  .lb-prev,
  .lb-next {
    top: calc(50% - 22px - 1.75rem);
  }
  .lb-prev {
    left: 0.6rem;
  }
  .lb-next {
    right: 0.6rem;
  }
</style>
