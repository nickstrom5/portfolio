---
/**
 * /food/: an unlisted photo page. Nothing links here, it is noindex and left out
 * of the sitemap, so it is reachable only by its URL. Unlisted, not private:
 * the repo is public. Add photos with `npm run food:add` (see src/assets/food/README.md).
 */
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import food from '@/data/food.json';

type Override = { caption?: string; alt?: string };
const overrides = food.photos as Record<string, Override>;

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/food/*.{jpg,jpeg,png,webp,avif}', { eager: true });

const photos = await Promise.all(
  Object.entries(files).map(async ([path, mod]) => {
    const file = path.split('/').pop()!;
    // File names look like 2026-10-09-cacio-e-pepe.jpg; the rest of the name is the caption.
    const m = file.match(/^(\d{4}-\d{2}-\d{2})-(.+)\.[a-z]+$/i);
    const date = m ? m[1] : '';
    const words = (m ? m[2] : file.replace(/\.[a-z]+$/i, '')).replace(/-\d+$/, '').replace(/-/g, ' ');
    const named = words.charAt(0).toUpperCase() + words.slice(1);
    const o = overrides[file] ?? {};
    const caption = o.caption ?? named;
    const full = await getImage({ src: mod.default, width: Math.min(1600, mod.default.width), format: 'webp' });
    return { file, date, caption, alt: o.alt ?? caption, img: mod.default, full: full.src };
  }),
);
photos.sort((a, b) => b.date.localeCompare(a.date) || b.file.localeCompare(a.file));

const when = (d: string) =>
  d ? new Date(`${d}T12:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }) : '';
---

<Base title={food.title} description="An unlisted page of food photos." noindex>
  <section class="section">
    <div class="container">
      <span class="eyebrow">Off the clock</span>
      <h1>{food.title}</h1>
      <p class="lede">{food.intro}</p>

      {photos.length === 0 ? (
        <p class="empty muted">No photos yet.</p>
      ) : (
        <ul class="gallery" data-gallery>
          {photos.map((p, i) => (
            <li>
              <a href={p.full} data-full data-index={i} data-caption={p.caption}>
                <Image src={p.img} alt={p.alt} widths={[320, 640]} sizes="(max-width: 640px) 50vw, 300px" loading={i < 4 ? 'eager' : 'lazy'} decoding="async" />
              </a>
              <p class="cap">
                <span>{p.caption}</span>
                {p.date && <time datetime={p.date}>{when(p.date)}</time>}
              </p>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <dialog class="lightbox" aria-label="Photo" data-lightbox>
    <figure>
      <img alt="" data-lb-img />
      <figcaption data-lb-cap></figcaption>
    </figure>
    <button class="lb-btn lb-close" type="button" aria-label="Close" data-lb-close>×</button>
    <button class="lb-btn lb-prev" type="button" aria-label="Previous photo" data-lb-prev>‹</button>
    <button class="lb-btn lb-next" type="button" aria-label="Next photo" data-lb-next>›</button>
  </dialog>
</Base>

<script>
  // Without JS each photo simply links to its full-size image.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-full]')];
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const img = document.querySelector<HTMLImageElement>('[data-lb-img]');
  const cap = document.querySelector<HTMLElement>('[data-lb-cap]');
  let current = 0;

  function show(i: number) {
    if (!links.length || !img || !cap) return;
    current = (i + links.length) % links.length;
    const link = links[current];
    img.src = link.href;
    img.alt = link.querySelector('img')?.alt ?? '';
    cap.textContent = link.dataset.caption ?? '';
  }

  if (dialog && typeof dialog.showModal === 'function') {
    links.forEach((link, i) =>
      link.addEventListener('click', (e) => {
        e.preventDefault();
        show(i);
        dialog.showModal();
      }),
    );
    dialog.querySelector('[data-lb-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-lb-next]')?.addEventListener('click', () => show(current + 1));
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
    // A click on the backdrop (the dialog itself, outside the figure) closes it.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => links[current]?.focus());
  }
</script>

<style>
  .empty {
    margin-top: 1.5rem;
  }
  .gallery {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 160px), 1fr));
    gap: 1.25rem 1rem;
  }
  @media (min-width: 900px) {
    .gallery {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .gallery a {
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-muted);
  }
  .gallery img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    transition: transform 0.2s ease;
  }
  .gallery a:hover img {
    transform: scale(1.03);
  }
  .cap {
    margin: 0.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 0.75rem;
    font-size: 0.9rem;
  }
  .cap time {
    color: var(--text-muted);
  }

  .lightbox {
    width: min(96vw, 1100px);
    max-width: none;
    max-height: 94vh;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: #0b0b0e;
    color: #fff;
    overflow: visible;
  }
  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.8);
  }
  .lightbox figure {
    margin: 0;
  }
  .lightbox img {
    display: block;
    width: 100%;
    max-height: calc(94vh - 3.5rem);
    object-fit: contain;
    border-radius: var(--radius) var(--radius) 0 0;
  }
  .lightbox figcaption {
    padding: 0.85rem 1rem;
    font-size: 0.95rem;
  }
  .lb-btn {
    position: absolute;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.55);
    color: #fff;
    font: inherit;
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
  }
  .lb-btn:focus-visible {
    outline-color: #fff;
  }
  .lb-close {
    top: 0.6rem;
    right: 0.6rem;
  }
  .lb-prev,
  .lb-next {
    top: calc(50% - 22px - 1.75rem);
  }
  .lb-prev {
    left: 0.6rem;
  }
  .lb-next {
    right: 0.6rem;
  }
</style>
