---
import Base from '@/layouts/Base.astro';
import AppCard from '@/components/AppCard.astro';
import apps from '@/data/apps.json';
import { site } from '@/data/site';
import { url } from '@/lib/url';

const sorted = [...apps].sort((a, b) => b.year - a.year);

const steps = [
  {
    n: '01',
    title: 'Start with one sentence and a proven market',
    ai: 'Claude and Grok researched the category, pulled apart the incumbents, and drafted a strategy document: positioning, pricing, targets, risks and a 30-day plan.',
    me: 'I picked the ideas, set the constraint that nothing leaves the phone, and killed the versions that needed a backend.',
  },
  {
    n: '02',
    title: 'Write the product before the code',
    ai: 'Every onboarding screen, the belief each one has to move, the paywall copy, the naming shortlist and the rejected names all came out of long working sessions with the models.',
    me: 'I read every screen as the user, sent back what felt like a pitch instead of a product, and approved the final flow.',
  },
  {
    n: '03',
    title: 'Generate the app',
    ai: 'The SwiftUI app, the Screen Time and Live Activity extensions, the StoreKit 2 paywall, the widgets, the unit tests and the Xcode project definition were written by the models, file by file, from those documents.',
    me: 'I ran the builds, reported what broke on a real iPhone, and pasted the errors back. That loop, not typing code, is where my hours went.',
  },
  {
    n: '04',
    title: 'Ship the launch kit at the same time',
    ai: 'App Store listing, screenshot plan, entitlement request answers, privacy and terms pages, the landing site, a social kit and a creator outreach brief were drafted alongside the code so launch is a checklist, not a project.',
    me: 'I registered the domains, set up GitHub Pages and the developer account, and decided what goes live when.',
  },
  {
    n: '05',
    title: 'Let the data decide what comes next',
    ai: 'Roadmaps are written to a rule: ship the core loop, then let reviews, cancellations and the funnel choose the next feature. The models keep a list of what waits for evidence.',
    me: 'I own the metric each release has to move, and I say no to everything else.',
  },
];
---

<Base title="Apps" description="Clam and Lume: two iPhone apps built as AI experiments, 95% or more written by Claude and Grok.">
  <section class="section">
    <div class="container">
      <span class="eyebrow">Apps</span>
      <h1>Two iPhone apps, built as an AI experiment</h1>
      <p class="lede">
        I'm not a career iOS developer. Clam and Lume exist to answer one question: how much of a real, App Store-ready product can be built by directing AI models instead of writing the code yourself? The answer so far is about 95 percent.
      </p>
      <div class="grid apps-grid">
        {sorted.map((a) => <AppCard app={a} />)}
      </div>
    </div>
  </section>

  <section class="section split-section">
    <div class="container">
      <div class="section-head">
        <h2>Who did what</h2>
      </div>
      <div class="split" role="img" aria-label="About 95 percent of the work was done by AI models and about 5 percent by me">
        <div class="bar">
          <span class="ai" style="width: 95%">AI · Claude &amp; Grok · ~95%</span>
          <span class="me" style="width: 5%"><span class="sr-only">Me · ~5%</span></span>
        </div>
        <div class="legend">
          <div>
            <strong>Claude and Grok wrote</strong>
            <span class="muted">strategy, onboarding copy, Swift code, extensions, tests, store listings, legal pages, landing sites, social kits.</span>
          </div>
          <div>
            <strong>I did</strong>
            <span class="muted">the idea, the constraints, every product decision, testing on device, accounts, domains and the go/no-go calls.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">The process</span>
      <div class="section-head">
        <h2>How each app gets made</h2>
      </div>
      <ol class="steps">
        {steps.map((s) => (
          <li class="step" data-reveal>
            <div class="num" aria-hidden="true">{s.n}</div>
            <div class="body">
              <h3>{s.title}</h3>
              <div class="cols">
                <div class="col">
                  <span class="label ai-label">AI</span>
                  <p>{s.ai}</p>
                </div>
                <div class="col">
                  <span class="label me-label">Me</span>
                  <p>{s.me}</p>
                </div>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Follow the apps</h2>
      </div>
      <div class="grid apps-grid">
        {sorted.map((a) => (
          <div class="card follow">
            <h3>{a.name}</h3>
            <p class="muted">{a.tagline}</p>
            <div class="links">
              {a.website && <a class="btn btn-secondary" href={a.website} target="_blank" rel="noopener">{a.website.replace(/^https?:\/\//, '')}</a>}
              {a.appStore ? (
                <a class="btn btn-primary" href={a.appStore} target="_blank" rel="noopener">App Store</a>
              ) : (
                <span class="btn btn-secondary disabled" aria-disabled="true">App Store · {a.status ?? 'soon'}</span>
              )}
              {a.projectSlug && <a class="inline" href={url(`/work/${a.projectSlug}`)}>Case study →</a>}
            </div>
          </div>
        ))}
      </div>
      <p class="muted note">
        Store links switch on the day each listing goes live. Both apps are built for the iPhone Duo and work on every iPhone. Want the same experiment run on your idea? <a href={url('/contact')}>Get in touch</a>.
      </p>
    </div>
  </section>
</Base>

<script>
  const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduce || !('IntersectionObserver' in window)) {
    items.forEach((el) => el.classList.add('in'));
  } else {
    document.documentElement.classList.add('reveal-js');
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        });
      },
      { rootMargin: '0px 0px -12% 0px', threshold: 0.15 },
    );
    items.forEach((el) => io.observe(el));
  }
</script>

<style>
  .apps-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    margin-top: 2rem;
  }
  @media (min-width: 700px) {
    .apps-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .split-section {
    background: var(--bg-muted);
  }
  .bar {
    display: flex;
    height: 44px;
    border-radius: 999px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-elev);
  }
  .bar .ai {
    display: flex;
    align-items: center;
    padding-left: 1rem;
    background: linear-gradient(90deg, var(--accent), var(--accent-strong));
    color: #fff;
    font-weight: 700;
    font-size: 0.9rem;
    white-space: nowrap;
  }
  .bar .me {
    background: var(--text);
  }
  .legend {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 1rem;
    font-size: 0.95rem;
  }
  .legend div {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  @media (max-width: 760px) {
    .legend {
      grid-template-columns: 1fr;
    }
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }
  .step {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 1.5rem;
    padding: 2.25rem 0;
    border-top: 1px solid var(--border);
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
  }
  :global(html.reveal-js) .step:not(.in) {
    opacity: 0;
    transform: translateY(18px);
  }
  .num {
    font-size: 2.6rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .step h3 {
    font-size: 1.35rem;
    margin-bottom: 1rem;
  }
  .cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  .col p {
    margin: 0.4rem 0 0;
    color: var(--text-muted);
  }
  .label {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.15rem 0.55rem;
    border-radius: 4px;
  }
  .ai-label {
    background: var(--accent-soft);
    color: var(--accent);
  }
  .me-label {
    background: var(--text);
    color: var(--bg);
  }
  @media (max-width: 700px) {
    .step {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    .cols {
      grid-template-columns: 1fr;
    }
  }
  .follow h3 {
    margin-bottom: 0.25rem;
  }
  .follow .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: center;
    margin-top: 0.75rem;
  }
  .follow .inline {
    font-weight: 600;
    font-size: 0.9rem;
  }
  .btn.disabled {
    opacity: 0.6;
    cursor: default;
  }
  .note {
    margin-top: 1.5rem;
    font-size: 0.95rem;
  }
</style>
