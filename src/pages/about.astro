---
import Base from '@/layouts/Base.astro';
import { site } from '@/data/site';
import { experience, education } from '@/data/experience';
import { url } from '@/lib/url';

const skills = {
  'Project management': ['Asana', 'ClickUp', 'Monday', 'Jira', 'Trello', 'Notion', 'Airtable', 'Confluence'],
  'Microsoft 365': ['Planner', 'Teams', 'SharePoint Lists', 'Power Automate', 'Forms'],
  'CRM & automation': ['GoHighLevel', 'HubSpot', 'Salesforce', 'Zoho', 'Zapier', 'AI workflows'],
  'Events & media': ['Zoom Webinars', 'OBS', 'Premiere Pro', 'After Effects', 'Final Cut', 'Photoshop', 'Illustrator', 'InDesign'],
  'Web & apps': ['WordPress', 'Wix', 'Shopify', 'React', 'React Native', 'Flutter'],
};
const linkedinLive = !site.links.linkedin.includes('REPLACE');
const upworkLive = !site.links.upwork.includes('REPLACE');
---

<Base title="About" description={`About ${site.name}, ${site.role.toLowerCase()} based in the ${site.location}.`}>
  <section class="section">
    <div class="container about">
      <div class="prose">
        <span class="eyebrow">About</span>
        <h1>Hi, I'm {site.firstName}.</h1>
        <p class="lede">
          I'm a senior project manager and operations lead with more than ten years running projects for federal research institutions, major universities, large corporations, startups and nonprofits.
        </p>
        <p>
          That range means I've seen how organizations of every size actually operate. I can step into your team, learn your systems and start moving things forward in days, not weeks.
        </p>
        <p>
          What I do best is take ownership of the moving parts, the projects, timelines, tools, people and processes, so you can stay focused on growth. Clients keep me around for years, with my longest engagements running past 3,000 hours, because I'm consistent, detail-oriented and easy to work with.
        </p>
        <p>
          I respond within a few hours and flex my schedule around your time zone. Based in {site.location.split(' · ')[0]}, working with clients across North America, Europe and Australia.
        </p>
        <div class="cta">
          <a class="btn btn-primary" href={url('/contact')}>Work with me</a>
          {upworkLive && <a class="btn btn-secondary" href={site.links.upwork} target="_blank" rel="noopener">Upwork</a>}
          {linkedinLive && <a class="btn btn-secondary" href={site.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>}
        </div>
      </div>

      <aside>
        <div class="card">
          <h2 class="h3">Experience</h2>
          <ol class="timeline">
            {experience.map((r) => (
              <li>
                <span class="dates">{r.start}–{r.end}</span>
                <div>
                  <strong>{r.title}</strong>
                  <span class="muted"> · {r.company}</span>
                  <p class="muted small">{r.summary}{r.slug && <> <a href={url(`/work/${r.slug}`)}>Details →</a></>}</p>
                </div>
              </li>
            ))}
          </ol>
          <p class="muted small edu">Education: {education.map((e) => `${e.school}, ${e.location}`).join('; ')}</p>
        </div>
        <div class="card skills">
          <h2 class="h3">Skills</h2>
          {Object.entries(skills).map(([group, items]) => (
            <div class="skill-group">
              <h3>{group}</h3>
              <ul class="tags">
                {items.map((s) => <li class="tag">{s}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(280px, 1fr);
    gap: 3rem;
    align-items: start;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .h3 {
    font-size: 1.25rem;
    margin-bottom: 1rem;
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .timeline li {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 0.75rem;
    align-items: start;
  }
  .dates {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-faint);
    padding-top: 0.15rem;
    white-space: nowrap;
  }
  .small {
    font-size: 0.88rem;
    margin: 0.15rem 0 0;
  }
  .edu {
    margin-top: 1.25rem;
  }
  .skills {
    margin-top: 1.25rem;
  }
  .skill-group {
    margin-bottom: 1.1rem;
  }
  .skill-group h3 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-faint);
    margin-bottom: 0.5rem;
  }
  @media (max-width: 800px) {
    .about {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
