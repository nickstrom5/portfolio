---
import Base from '@/layouts/Base.astro';
import { site } from '@/data/site';
import { roles, education } from '@/data/experience';
import personal from '@/data/personal.json';
import { url } from '@/lib/url';

const skills = {
  'AI & development': [
    'Claude Code',
    'Grok',
    'Prompt-directed builds',
    'SwiftUI & iOS',
    'Screen Time & StoreKit APIs',
    'Astro & static sites',
    'GitHub Actions & Pages',
    'Cloudflare DNS',
  ],
  'Project management': ['Asana', 'ClickUp', 'Monday', 'Jira', 'Trello', 'Notion', 'Airtable', 'Confluence', 'Loom async updates'],
  'Microsoft 365': ['Planner', 'Teams', 'SharePoint Lists', 'Power Automate', 'Forms'],
  'CRM & automation': ['GoHighLevel', 'HubSpot', 'Salesforce', 'Zoho One', 'Zapier', 'Google Sheets + AI'],
  'Operations & finance': ['QuickBooks Online', 'Google Workspace', 'Slack', 'Vendor & billing coordination', 'Hiring & onboarding', 'Client onboarding'],
  'Events & media': ['Zoom Webinars', 'OBS', 'Premiere Pro', 'After Effects', 'Final Cut', 'Photoshop', 'Illustrator', 'InDesign'],
  'Web & apps': ['WordPress', 'Wix', 'Shopify', 'React', 'App Store Connect'],
};
const linkedinLive = !site.links.linkedin.includes('REPLACE');
const upworkLive = !site.links.upwork.includes('REPLACE');
const connect = [
  { label: 'Email', value: site.email, href: `mailto:${site.email}`, mark: '@' },
  upworkLive && { label: 'Upwork', value: 'Top Rated Plus · 257 contracts', href: site.links.upwork, mark: 'Up' },
  linkedinLive && { label: 'LinkedIn', value: 'nick-s-0a0a29bb', href: site.links.linkedin, mark: 'in' },
  site.links.github && { label: 'GitHub', value: 'nickstrom5', href: site.links.github, mark: '{}' },
].filter(Boolean) as { label: string; value: string; href: string; mark: string }[];
const photos = personal.photos as { src: string; alt: string; caption?: string }[];
---

<Base title="About" description={`About ${site.name}, ${site.role.toLowerCase()} based in Chicago.`}>
  <section class="section">
    <div class="container about">
      <div class="prose">
        <img class="portrait" src={url(site.photo)} alt={`${site.name}`} width="128" height="128" loading="eager" />
        <span class="eyebrow">About</span>
        <h1>Hi, I'm {site.firstName}.</h1>
        <p class="lede">
          I'm a senior project manager and operations lead with more than ten years running projects for federal research institutions, major universities, large corporations, startups and nonprofits.
        </p>
        <p>
          That range means I've seen how organizations of every size actually operate. I can step into your team, learn your systems and start moving things forward in days, not weeks.
        </p>
        <p>
          What I do best is take ownership of the moving parts, the projects, timelines, tools, people and processes, so you can stay focused on growth. Clients keep me around for years, with my longest engagements running past 3,000 hours, because I'm consistent, detail-oriented and easy to work with.
        </p>
        <p>
          I flex my schedule around your time zone. Based in {site.location.split(' · ')[0]}, working with clients across North America, Europe and Australia.
        </p>
        <div class="cta">
          <a class="btn btn-primary" href={url('/contact')}>Work with me</a>
          <a class="btn btn-secondary" href={url(site.resumePdf)} download>Download résumé (PDF)</a>
          {upworkLive && <a class="btn btn-secondary" href={site.links.upwork} target="_blank" rel="noopener">Upwork</a>}
          {linkedinLive && <a class="btn btn-secondary" href={site.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>}
        </div>
      </div>

      <aside>
        <div class="card connect">
          <h2 class="h3">Connect</h2>
          <ul>
            {connect.map((c) => (
              <li>
                <a href={c.href} target={c.href.startsWith('mailto:') ? undefined : '_blank'} rel={c.href.startsWith('mailto:') ? undefined : 'me noopener'}>
                  <span class="mark" aria-hidden="true">{c.mark}</span>
                  <span class="text">
                    <strong>{c.label}</strong>
                    <span class="muted">{c.value}</span>
                  </span>
                  <span class="arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div class="card skills">
          <h2 class="h3">Skills</h2>
          {Object.entries(skills).map(([group, items]) => (
            <div class="skill-group">
              <h3>{group}</h3>
              <ul class="tags">
                {items.map((s) => <li class="tag">{s}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Experience</span>
      <div class="section-head">
        <h2>Featured roles</h2>
        <a href={url('/clients')}>Featured clients →</a>
      </div>
      <p class="lede">
        Freelancing full-time since 2015. These are the longest-running roles from 257 contracts; the rest ranged from a week to a year.
      </p>
      <ol class="roles">
        {roles.map((r) => (
          <li>
            <span class="years">{r.start}–{r.end}</span>
            <span class="what">
              <strong>{r.title}</strong>
              <span class="company">{r.company}</span>
            </span>
            {r.slug ? <a class="detail" href={url(`/work/${r.slug}`)}>Details →</a> : <span />}
          </li>
        ))}
      </ol>
      <p class="edu muted">
        Education: {education.map((e) => `${e.school}, ${e.location}`).join('; ')} · Full history in the <a href={url(site.resumePdf)} download>résumé</a>{upworkLive && <> or on <a href={site.links.upwork} target="_blank" rel="noopener">Upwork</a></>}.
      </p>
    </div>
  </section>

  {photos.length > 0 && (
    <section class="section">
      <div class="container">
        <span class="eyebrow">Personal</span>
        <div class="section-head">
          <h2>{personal.title}</h2>
        </div>
        <p class="lede">{personal.intro}</p>
        <ul class="gallery">
          {photos.map((p) => (
            <li>
              <figure>
                <img src={url(p.src)} alt={p.alt} loading="lazy" width="800" height="600" />
                {p.caption && <figcaption class="muted">{p.caption}</figcaption>}
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Base>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(280px, 1fr);
    gap: 3rem;
    align-items: start;
  }
  .portrait {
    width: 128px;
    height: 128px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: var(--shadow);
    margin-bottom: 1.25rem;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .h3 {
    font-size: 1.25rem;
    margin-bottom: 1rem;
  }
  .connect ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }
  .connect a {
    display: grid;
    grid-template-columns: 40px 1fr auto;
    align-items: center;
    gap: 0.8rem;
    padding: 0.6rem 0.7rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    color: var(--text);
    min-height: 44px;
    transition: border-color 0.15s ease;
  }
  .connect a:hover {
    border-color: var(--text-faint);
  }
  .connect .mark {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 800;
    font-size: 0.85rem;
  }
  .connect .text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
    min-width: 0;
  }
  .connect .text .muted {
    font-size: 0.85rem;
    overflow-wrap: anywhere;
  }
  .connect .arrow {
    color: var(--text-faint);
  }
  .skills {
    margin-top: 1.25rem;
  }
  .gallery {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 1rem;
  }
  .gallery figure {
    margin: 0;
  }
  .gallery img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .gallery figcaption {
    margin-top: 0.5rem;
    font-size: 0.9rem;
  }
  .skill-group {
    margin-bottom: 1.1rem;
  }
  .skill-group h3 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-faint);
    margin-bottom: 0.5rem;
  }
  .roles {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  .roles li {
    display: grid;
    grid-template-columns: 7rem 1fr auto;
    gap: 1rem;
    align-items: baseline;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
  }
  .years {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }
  .what {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    align-items: baseline;
  }
  .what strong {
    font-size: 1.05rem;
  }
  .company {
    color: var(--text-muted);
  }
  .detail {
    font-size: 0.9rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .edu {
    margin: 1.25rem 0 0;
    font-size: 0.9rem;
  }
  @media (max-width: 800px) {
    .about {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .roles li {
      grid-template-columns: 1fr auto;
    }
    .years {
      grid-column: 1 / -1;
    }
  }
</style>
