---
import '@/styles/global.css';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import { Font } from 'astro:assets';
import { site } from '@/data/site';
import { ids, personNode, websiteNode } from '@/lib/schema';

interface Props {
  title?: string;
  description?: string;
  /** Path under /public used for social previews. */
  image?: string;
  /** Alt text for the social preview image. */
  imageAlt?: string;
  /** Keep the page out of search results (thank-you pages, print views). */
  noindex?: boolean;
  /** Extra JSON-LD objects merged into the page graph. */
  jsonLd?: Record<string, unknown>[];
  ogType?: 'website' | 'article' | 'profile';
  /** schema.org type of this page's WebPage node. */
  pageType?: 'WebPage' | 'ProfilePage';
  /** Extra properties merged into the WebPage node. */
  pageProps?: Record<string, unknown>;
  /** Breadcrumb trail after Home; the last item is the current page. */
  breadcrumbs?: { name: string; path: string }[];
}

const {
  title,
  description = `${site.name}, freelance ${site.role.toLowerCase()} in Chicago. 300+ contracts since 2015, Top Rated Plus on Upwork, 100% Job Success.`,
  image = '/og.png',
  imageAlt,
  noindex = false,
  jsonLd = [],
  ogType = 'website',
  pageType = 'WebPage',
  pageProps = {},
  breadcrumbs,
} = Astro.props;

// A page may pass a full title that already names Nick; otherwise the name is appended.
const fullTitle = title ? (title.includes(site.name) ? title : `${title} · ${site.name}`) : `${site.name} · Freelance project manager and operations lead`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
// Only the default card is 1200×630; other preview images omit sizes rather than state wrong ones.
const isDefaultImage = image === '/og.png';
const ogAlt = imageAlt ?? `${site.name}, ${site.role}`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const crumbs = breadcrumbs && [{ name: 'Home', path: '/' }, ...breadcrumbs];

const graph = [
  websiteNode(),
  personNode(),
  {
    '@type': pageType,
    '@id': `${canonical.href}#webpage`,
    url: canonical.href,
    name: fullTitle,
    description,
    isPartOf: { '@id': ids.website },
    about: { '@id': ids.person },
    inLanguage: 'en-US',
    ...(crumbs ? { breadcrumb: { '@id': `${canonical.href}#breadcrumb` } } : {}),
    ...pageProps,
  },
  ...(crumbs
    ? [
        {
          '@type': 'BreadcrumbList',
          '@id': `${canonical.href}#breadcrumb`,
          itemListElement: crumbs.map((c, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            name: c.name,
            item: new URL(c.path, Astro.site).href,
          })),
        },
      ]
    : []),
  ...jsonLd,
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}/favicon-96x96.png`} type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <meta name="theme-color" content="#fbfbf9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1114" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {isDefaultImage && <meta property="og:image:width" content="1200" />}
    {isDefaultImage && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <Font cssVariable="--font-inter" preload />

    <script is:inline>
      // Apply the saved theme before first paint to avoid a flash.
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') {
          document.documentElement.dataset.theme = saved;
        }
      } catch {}
    </script>

    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -999px;
    top: 0.5rem;
    background: var(--accent);
    color: #fff;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-sm);
    z-index: 100;
  }
  .skip:focus {
    left: 0.5rem;
  }
</style>
