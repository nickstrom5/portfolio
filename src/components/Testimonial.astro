---
interface Props {
  quote: string;
  contract: string;
  period: string;
  rating: number;
  hours?: number;
  endorsements?: string[];
  source: string;
  placeholder?: boolean;
}
const { quote, contract, period, rating, hours, endorsements = [], source, placeholder } = Astro.props;
const showBadge = import.meta.env.DEV && placeholder;
const hoursLabel = hours && hours > 1 ? `${hours.toLocaleString()} hours` : '';
---

<figure class="card quote">
  {showBadge && <span class="placeholder-badge">Sample</span>}
  <div class="head">
    <span class="rating">
      <span class="star" aria-hidden="true">★</span>
      <span aria-hidden="true">{rating.toFixed(1)}</span>
      <span class="sr-only">Rated {rating} out of 5</span>
    </span>
    {hoursLabel && <span class="muted small">{hoursLabel}</span>}
  </div>
  <blockquote>“{quote}”</blockquote>
  <figcaption>
    <strong>{contract}</strong>
    <span class="muted">{period} · via {source}</span>
    {endorsements.length > 0 && (
      <ul class="tags">
        {endorsements.map((e) => <li class="tag">{e}</li>)}
      </ul>
    )}
  </figcaption>
</figure>

<style>
  /* In a grid row every card shares row tracks (subgrid): rating, quote, contract
     title, date line and pills each start on the same line across the row, even when
     one title wraps. Outside a grid it is a plain stack. */
  .quote {
    position: relative;
    margin: 0;
    display: grid;
    grid-row: span 5;
    grid-template-rows: subgrid;
    row-gap: 0.75rem;
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .rating {
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .star {
    color: #f5b301;
    font-size: 1.1rem;
    line-height: 1;
  }
  .small {
    font-size: 0.85rem;
  }
  blockquote {
    margin: 0;
    flex: 1;
    font-size: 1.02rem;
  }
  figcaption {
    font-size: 0.9rem;
    display: grid;
    grid-row: span 3;
    grid-template-rows: subgrid;
    row-gap: 0.5rem;
    align-content: start;
  }
  figcaption strong {
    color: var(--text);
  }
  /* Rows are as tall as the tallest card's; keep each part (and a lone pill) at its natural height. */
  figcaption > * {
    align-self: start;
  }
  .tags {
    margin-top: 0.1rem;
    align-content: flex-start;
  }
</style>
