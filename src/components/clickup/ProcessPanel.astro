---
/**
 * One process: the story and what it is built from, then its body (the List
 * setup and simulator, the same setup in ClickUp, and the build notes). A
 * deferred panel keeps the story in the HTML and leaves a slot for the body,
 * which loads when the process is opened.
 */
import type { Process } from '@/lib/clickup/types';
import type { Names } from '@/lib/clickup/engine';
import Part from '@/components/ghl/Part.astro';
import ProcessBody from './ProcessBody.astro';

interface Props {
  process: Process;
  caseId: string;
  names: Names;
  hidden?: boolean;
  /** Leave the body out of the HTML (src/lib/parts.ts). */
  deferred?: boolean;
}
const { process: p, caseId, names, hidden = false, deferred = false } = Astro.props;
const uid = `${caseId}-${p.id}`;
---

<div class="gx-panel" id={uid} role="tabpanel" aria-labelledby={`tab-${uid}`} hidden={hidden} data-panel={p.id}>
  <header class="gx-panel-head">
    <span class="eyebrow">{p.number} · {p.kicker}</span>
    <h4 tabindex="-1" data-panel-heading>{p.name}</h4>
    <p class="gx-tagline">{p.tagline}</p>
  </header>

  <div class="gx-ps">
    <div>
      <h5>The problem</h5>
      <p>{p.problem}</p>
    </div>
    <div>
      <h5>What I built</h5>
      <p>{p.solution}</p>
    </div>
  </div>

  <ul class="cu-pieces" aria-label="Besides the Automations">
    {p.pieces.map((x) => (
      <li><span class="cu-piece-kind">{x.kind}</span><strong>{x.name}</strong><span>{x.note}</span></li>
    ))}
  </ul>

  {deferred ? <Part id={`${caseId}/${p.id}`} what="the List setup, simulator and build notes" /> : <ProcessBody process={p} caseId={caseId} names={names} />}
</div>
