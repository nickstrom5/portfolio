---
/** Controls and live output for one process. Wired up by src/lib/clickup/ui.ts. */
import type { Process } from '@/lib/clickup/types';
import { formatClock } from '@/lib/clickup/engine';
import Icon from '@/components/ghl/Icon.astro';

interface Props {
  process: Process;
  caseId: string;
}
const { process: p, caseId } = Astro.props;
const uid = `${caseId}-${p.id}`;
---

<div class="g-sim" data-sim={p.id} data-case={caseId}>
  <fieldset class="g-scen">
    <legend>Pick a sample task</legend>
    <div class="g-scen-list">
      {p.scenarios.map((s, i) => (
        <label class="g-scen-opt">
          <input type="radio" name={`scenario-${uid}`} value={s.id} checked={i === 0} />
          <span><strong>{s.label}</strong><span><em class="g-scen-who">{s.task.name}.</em> {s.summary}</span></span>
        </label>
      ))}
    </div>
  </fieldset>
  <p class="g-override" data-override hidden>
    Running with your Form answers: <strong data-override-name></strong>. What happens next: <strong data-override-next></strong> (your choice beside the Form). Nothing is sent or stored.
    <button type="button" class="g-link" data-clear-override>Use a sample task instead</button>
  </p>
  <div class="g-controls">
    <button type="button" class="btn btn-primary" data-run><Icon name="play" size={16} />Run it</button>
    <button type="button" class="btn btn-secondary" data-instant><Icon name="skip" size={16} />Skip to result</button>
    <button type="button" class="btn btn-secondary" data-reset><Icon name="reset" size={16} />Reset</button>
  </div>
  <div class="g-screen">
    <div class="g-clock">
      <span class="g-clock-now" data-clock>{formatClock(p.scenarios[0].start)}</span>
      <span class="g-clock-elapsed" data-elapsed>Not started</span>
    </div>
    <p class="g-outcome" data-outcome hidden></p>
    <div class="g-views" role="tablist" aria-label="Simulator output">
      <button type="button" role="tab" class="g-view" id={`log-tab-${uid}`} aria-controls={`log-${uid}`} aria-selected="true" data-view="log">Activity</button>
      <button type="button" role="tab" class="g-view" id={`rec-tab-${uid}`} aria-controls={`rec-${uid}`} aria-selected="false" tabindex="-1" data-view="record">The task <span class="g-view-dot" data-rec-dot hidden aria-hidden="true"></span></button>
    </div>
    <div role="tabpanel" id={`log-${uid}`} aria-labelledby={`log-tab-${uid}`} data-view-panel="log">
      <ol class="g-log" data-log tabindex="0" aria-label="Activity">
        <li class="g-log-empty">Pick a sample task above, then press Run it. Each line is one change, with the time it would happen: what people do, which Automation fires, and each Action it takes. Days are fast-forwarded.</li>
      </ol>
    </div>
    <div role="tabpanel" id={`rec-${uid}`} aria-labelledby={`rec-tab-${uid}`} data-view-panel="record" hidden>
      <div class="g-record" data-record></div>
    </div>
    <p class="sr-only" role="status" data-announce></p>
  </div>
</div>
