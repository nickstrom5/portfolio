---
/** Controls and live output for one automation. Wired up by src/lib/ghl/ui.ts. */
import type { Automation } from '@/lib/ghl/types';
import { formatClock } from '@/lib/ghl/engine';
import Icon from './Icon.astro';

interface Props {
  automation: Automation;
  caseId: string;
}
const { automation: a, caseId } = Astro.props;
const uid = `${caseId}-${a.id}`;
---

<div class="g-sim" data-sim={a.id} data-case={caseId}>
  <fieldset class="g-scen">
    <legend>Pick a test contact</legend>
    <div class="g-scen-list">
      {a.scenarios.map((s, i) => (
        <label class="g-scen-opt">
          <input type="radio" name={`scenario-${uid}`} value={s.id} checked={i === 0} />
          <span><strong>{s.label}</strong><span>{s.summary}</span></span>
        </label>
      ))}
    </div>
  </fieldset>
  <p class="g-override" data-override hidden>
    Running on your form details: <strong data-override-name></strong>, at your local time. Nothing is sent or stored.
    <button type="button" class="g-link" data-clear-override>Use the sample contact</button>
  </p>
  <div class="g-controls">
    <button type="button" class="btn btn-primary" data-run><Icon name="play" size={16} />Run workflow</button>
    <button type="button" class="btn btn-secondary" data-instant><Icon name="skip" size={16} />Skip to result</button>
    <button type="button" class="btn btn-secondary" data-reset><Icon name="reset" size={16} />Reset</button>
  </div>
  <div class="g-screen">
    <div class="g-clock">
      <span class="g-clock-now" data-clock>{formatClock(a.scenarios[0].start)}</span>
      <span class="g-clock-elapsed" data-elapsed>Not started</span>
    </div>
    <div class="g-views" role="tablist" aria-label="Simulator output">
      <button type="button" role="tab" class="g-view" id={`log-tab-${uid}`} aria-controls={`log-${uid}`} aria-selected="true" data-view="log">Execution log</button>
      <button type="button" role="tab" class="g-view" id={`rec-tab-${uid}`} aria-controls={`rec-${uid}`} aria-selected="false" tabindex="-1" data-view="record">Contact record <span class="g-view-dot" data-rec-dot hidden aria-hidden="true"></span></button>
    </div>
    <div role="tabpanel" id={`log-${uid}`} aria-labelledby={`log-tab-${uid}`} data-view-panel="log">
      <ol class="g-log" data-log tabindex="-1" aria-label="Execution log">
        <li class="g-log-empty">Run the workflow to see each step with its timestamp.</li>
      </ol>
    </div>
    <div role="tabpanel" id={`rec-${uid}`} aria-labelledby={`rec-tab-${uid}`} data-view-panel="record" hidden>
      <div class="g-record" data-record></div>
    </div>
    <p class="g-outcome" data-outcome hidden></p>
    <p class="sr-only" role="status" data-announce></p>
  </div>
</div>
