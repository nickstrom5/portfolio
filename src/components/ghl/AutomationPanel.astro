---
/** One automation: the story, the canvas and simulator side by side, then the build notes. */
import type { Automation } from '@/lib/ghl/types';
import Canvas from './Canvas.astro';
import Simulator from './Simulator.astro';
import Icon from './Icon.astro';

interface Props {
  automation: Automation;
  hidden?: boolean;
}
const { automation: a, hidden = false } = Astro.props;
const dm = a.dataModel;
---

<article class="gx-panel" id={a.id} role="tabpanel" aria-labelledby={`tab-${a.id}`} hidden={hidden} data-panel={a.id}>
  <header class="gx-panel-head">
    <span class="eyebrow">{a.number} · {a.kicker}</span>
    <h3>{a.name}</h3>
    <p class="gx-tagline">{a.tagline}</p>
  </header>

  <div class="gx-ps">
    <div>
      <h4>The problem</h4>
      <p>{a.problem}</p>
    </div>
    <div>
      <h4>What I built</h4>
      <p>{a.solution}</p>
    </div>
  </div>
  {a.evidence && (
    <figure class="gx-evidence">
      <blockquote><p>{a.evidence.text}</p></blockquote>
      <figcaption><a href={a.evidence.href} target="_blank" rel="noopener">{a.evidence.source}</a></figcaption>
    </figure>
  )}

  <div class="gx-lab">
    <div class="gx-lab-canvas">
      <Canvas automation={a} />
    </div>
    <div class="gx-lab-sim">
      <Simulator automation={a} />
    </div>
  </div>

  <div class="gx-notes">
    <section class="gx-build" aria-labelledby={`build-${a.id}`}>
      <h4 id={`build-${a.id}`}>How I built it</h4>
      <ol class="gx-build-list">
        {a.build.map((b) => (
          <li><strong>{b.title}.</strong> {b.body}</li>
        ))}
      </ol>
    </section>

    <section class="gx-model" aria-labelledby={`model-${a.id}`}>
      <h4 id={`model-${a.id}`}>Data model</h4>
      {dm.customFields && dm.customFields.length > 0 && (
        <div class="gx-table-wrap">
          <table class="gx-table">
            <caption class="sr-only">Custom fields</caption>
            <thead><tr><th scope="col">Custom field</th><th scope="col">Type</th><th scope="col">Notes</th></tr></thead>
            <tbody>
              {dm.customFields.map((f) => (
                <tr><td><strong>{f.name}</strong><code>{f.key}</code></td><td>{f.type}</td><td>{f.note ?? ''}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
      {dm.tags && dm.tags.length > 0 && (
        <dl class="gx-kv">
          {dm.tags.map((t) => (
            <div><dt><span class="gx-tag">{t.name}</span></dt><dd>{t.note}</dd></div>
          ))}
        </dl>
      )}
      {dm.pipeline && (
        <p class="gx-pipe"><span class="gx-pipe-name">{dm.pipeline.name}</span>{dm.pipeline.stages.map((st) => <span class="gx-stage">{st}</span>)}</p>
      )}
      {dm.customValues && dm.customValues.length > 0 && (
        <p class="gx-values">Custom values: {dm.customValues.map((v, i) => <><code>{`{{custom_values.${v.key}}}`}</code>{i < dm.customValues!.length - 1 ? ' ' : ''}</>)}</p>
      )}
    </section>

    <section class="gx-edges" aria-labelledby={`edges-${a.id}`}>
      <h4 id={`edges-${a.id}`}>Edge cases it handles</h4>
      <ul class="gx-edge-list">
        {a.edgeCases.map((e) => (
          <li><strong>{e.title}</strong><span>{e.body}</span></li>
        ))}
      </ul>
    </section>

    <section class="gx-qa" aria-labelledby={`qa-${a.id}`}>
      <h4 id={`qa-${a.id}`}>Test plan before publishing</h4>
      <ul class="gx-qa-list">
        {a.qa.map((q) => (
          <li><Icon name="check" size={16} /><span>{q}</span></li>
        ))}
      </ul>
    </section>

    {a.snippets && a.snippets.length > 0 && (
      <section class="gx-snips" aria-labelledby={`snips-${a.id}`}>
        <h4 id={`snips-${a.id}`}>Copy-ready pieces</h4>
        <div class="gx-snip-grid">
          {a.snippets.map((sn) => (
            <div class="g-snippet">
              <div class="g-snippet-head">
                <h5>{sn.title}</h5>
                <button type="button" class="g-copy" data-copy><Icon name="copy" size={15} /><span>Copy</span></button>
              </div>
              <pre><code>{sn.code}</code></pre>
              {sn.note && <p>{sn.note}</p>}
            </div>
          ))}
        </div>
      </section>
    )}

    <div class="gx-features">
      <p class="gx-features-title">GHL features in this build</p>
      <ul class="tags">
        {a.features.map((f) => <li class="tag">{f}</li>)}
      </ul>
      {a.proof && a.proof.length > 0 && (
        <p class="gx-proof">{a.proof.map((p) => <a href={p.href} target="_blank" rel="noopener">{p.label}</a>)}</p>
      )}
    </div>
  </div>
</article>
