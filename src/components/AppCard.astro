---
import { url } from '@/lib/url';

interface App {
  name: string;
  tagline: string;
  platforms: string[];
  stack: string[];
  client: string;
  year: number;
  appStore?: string;
  playStore?: string;
  website?: string;
  status?: string;
  projectSlug?: string;
  icon: string;
  /** App icon under /public; without one the card shows the `icon` initials. */
  iconImage?: string;
  placeholder?: boolean;
}
interface Props {
  app: App;
  /** Its story on /apps/; when set, the card links there instead of the /work case study. */
  story?: string;
}
const { app, story } = Astro.props;
const showBadge = import.meta.env.DEV && app.placeholder;
const hasStore = Boolean(app.appStore || app.playStore);
const siteLabel = app.website ? app.website.replace(/^https?:\/\//, '').replace(/\/$/, '') : '';
const studyHref = story ? url(`/apps/#${story}`) : app.projectSlug ? url(`/work/${app.projectSlug}`) : '';
---

<article class="card app">
  {showBadge && <span class="placeholder-badge">Sample</span>}
  <div class="app-head">
    {app.iconImage ? (
      <img class="icon icon-img" src={url(app.iconImage)} alt="" width="56" height="56" loading="lazy" decoding="async" />
    ) : (
      <div class="icon" aria-hidden="true">{app.icon}</div>
    )}
    <div>
      <h3>{app.name}</h3>
      <p class="muted small">{app.client} · {app.year}</p>
    </div>
  </div>
  <p class="tagline">{app.tagline}</p>
  <ul class="tags">
    {app.platforms.map((p) => <li class="tag platform">{p}</li>)}
  </ul>
  <p class="stack muted">{app.stack.slice(0, 3).join(' · ')}</p>
  <div class="foot">
    <div class="links">
      {app.appStore && <a class="store" href={app.appStore} target="_blank" rel="noopener">App Store</a>}
      {app.playStore && <a class="store" href={app.playStore} target="_blank" rel="noopener">Google Play</a>}
      {app.website && <a class="store" href={app.website} target="_blank" rel="noopener">{siteLabel}</a>}
      {!hasStore && !app.status && !studyHref && <span class="muted small">Private / enterprise distribution</span>}
    </div>
    {studyHref && <a class="study" href={studyHref}>{app.name} case study →</a>}
    {!hasStore && app.status && <p class="muted small status">{app.status}</p>}
  </div>
</article>

<style>
  /* Cards in a grid row share row tracks (subgrid), so pills, stack and links line up. */
  .app {
    position: relative;
    display: grid;
    grid-row: span 5;
    grid-template-rows: subgrid;
    row-gap: 0.75rem;
  }
  .app > * {
    align-self: start;
  }
  .app-head {
    display: flex;
    gap: 0.9rem;
    align-items: center;
  }
  .icon {
    flex: none;
    width: 56px;
    height: 56px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    font-weight: 800;
    font-size: 1.1rem;
    color: #fff;
    background: linear-gradient(135deg, var(--accent-btn), var(--accent-btn-hover));
    box-shadow: var(--shadow);
  }
  /* The real app icon, in the same rounded square. */
  .icon-img {
    display: block;
    object-fit: cover;
    background: none;
    /* A hairline ring keeps a dark icon visible on the dark card. */
    box-shadow: 0 0 0 1px var(--border), var(--shadow);
  }
  h3 {
    margin: 0;
    font-size: 1.1rem;
  }
  .small {
    font-size: 0.85rem;
    margin: 0;
  }
  .tagline {
    margin: 0;
  }
  .platform {
    background: var(--accent-soft);
    color: var(--accent);
    border-color: transparent;
  }
  .stack {
    font-size: 0.85rem;
    margin: 0;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.9rem;
    font-weight: 600;
    align-items: center;
  }
  .store {
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--text);
  }
  .store:hover {
    border-color: var(--text-faint);
  }
  /* Pills, then the case study, then the status, each on its own line on every card. */
  .foot {
    display: grid;
    justify-items: start;
    gap: 0.6rem;
  }
  .foot .links:empty {
    display: none;
  }
  .study {
    font-size: 0.9rem;
    font-weight: 600;
  }
  .status {
    font-weight: 500;
  }
</style>
