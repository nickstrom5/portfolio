---
import type { CollectionEntry } from 'astro:content';
import { url } from '@/lib/url';
import { categoryLabel } from '@/data/site';

interface Props {
  project: CollectionEntry<'projects'>;
  /** Heading level so the card fits the page outline (2 on index pages, 3 under a section heading). */
  level?: 2 | 3;
}
const { project, level = 3 } = Astro.props;
const { title, client, summary, stack, year, category, platforms, placeholder } = project.data;
const showBadge = import.meta.env.DEV && placeholder;
const shownPlatforms = platforms.filter((p) => p !== 'Remote');
const Heading = `h${level}` as 'h2' | 'h3';
---

<article class="card project">
  {showBadge && <span class="placeholder-badge">Sample</span>}
  <div class="meta">
    <span class="tag">{categoryLabel[category] ?? category}</span>
    <span class="muted">{year}</span>
  </div>
  <Heading class="title"><a href={url(`/work/${project.id}`)}>{title}</a></Heading>
  <p class="muted client">{client}{shownPlatforms.length ? ` · ${shownPlatforms.join(' / ')}` : ''}</p>
  <p class="summary">{summary}</p>
  <ul class="tags">
    {stack.slice(0, 5).map((s) => <li class="tag">{s}</li>)}
  </ul>
</article>

<style>
  .project {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease,
      transform 0.15s ease;
  }
  /* The whole card is the link: show it on hover, and ring the card (not the title) on keyboard focus. */
  .project:hover {
    border-color: var(--text-faint);
    transform: translateY(-2px);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.04),
      0 14px 32px -14px rgb(0 0 0 / 0.18);
  }
  .project:has(.title a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .project .title a:focus-visible {
    outline: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .project {
      transition: none;
    }
    .project:hover {
      transform: none;
    }
  }
  .meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
  }
  .title {
    margin: 0.25rem 0 0;
    font-size: 1.25rem;
  }
  .title a {
    color: var(--text);
  }
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .title a:hover {
    color: var(--accent);
  }
  .client {
    font-size: 0.9rem;
    margin: 0;
  }
  .summary {
    flex: 1;
    margin: 0.25rem 0 0.5rem;
  }
</style>
