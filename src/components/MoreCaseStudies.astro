---
/**
 * The row under a tool page's closing band: links to the other tools' case
 * studies and to the overview, so a visitor who arrived from search on one
 * tool can reach the rest. The list comes from the Case studies data, so a new
 * platform appears here on every page without touching them.
 */
import { platforms } from '@/data/caseStudies';
import { url } from '@/lib/url';

interface Props {
  /** The platform this page is about ("ghl", "n8n"…); it is left out of the row. */
  current: string;
}
const { current } = Astro.props;
const others = platforms.filter((p) => p.id !== current);
---

<nav class="container more-cases" aria-label="More case studies">
  <span class="more-label">More case studies</span>
  <ul>
    {others.map((p) => <li><a href={url(p.href)}>{p.name}</a></li>)}
    <li><a href={url('/case-studies')}>All case studies</a></li>
  </ul>
</nav>

<style>
  .more-cases {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    font-size: 0.95rem;
  }
  .more-label {
    font-weight: 600;
    color: var(--text);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
