---
/** Controls and live output for one workflow. Wired up by src/lib/n8n/ui.ts. */
import type { Automation } from '@/lib/n8n/types';
import { formatClock } from '@/lib/n8n/engine';
import Icon from './Icon.astro';

interface Props {
  automation: Automation;
  caseId: string;
}
const { automation: a, caseId } = Astro.props;
const uid = `${caseId}-${a.id}`;
const empty = 'Pick a test event above, then press Execute workflow. Each line is one node, with the time it ran and how many items it passed on; open Output to see them. Messages a person would read (Slack, email, tasks, HTTP responses) are shown as they would arrive. Waits of days are fast-forwarded.';
---

<div class="g-sim" data-sim={a.id} data-case={caseId} data-empty={empty}>
  <fieldset class="g-scen">
    <legend>Pick a test event</legend>
    <div class="g-scen-list">
      {a.scenarios.map((s, i) => (
        <label class="g-scen-opt">
          <input type="radio" name={`scenario-${uid}`} value={s.id} checked={i === 0} />
          <span><strong>{s.label}</strong><span>{s.summary}</span></span>
        </label>
      ))}
    </div>
  </fieldset>
  <p class="g-override" data-override hidden>
    Running with your own form answers, at your local time. What the rest of the world does: <strong data-override-next></strong> (your choice under the form). Nothing is sent or stored.
    <button type="button" class="g-link" data-clear-override>Use a test event instead</button>
  </p>
  <div class="g-controls">
    <button type="button" class="btn btn-primary" data-run><Icon name="play" size={16} />Execute workflow</button>
    <button type="button" class="btn btn-secondary" data-instant><Icon name="skip" size={16} />Skip to result</button>
    <button type="button" class="btn btn-secondary" data-reset><Icon name="reset" size={16} />Reset</button>
  </div>
  <div class="g-screen">
    <div class="g-clock">
      <span class="g-clock-now" data-clock>{formatClock(a.scenarios[0].start * 60000)}</span>
      <span class="g-clock-elapsed" data-elapsed>Not started</span>
    </div>
    <p class="g-outcome" data-outcome hidden></p>
    <div class="g-views" role="tablist" aria-label="Simulator output">
      <button type="button" role="tab" class="g-view" id={`log-tab-${uid}`} aria-controls={`log-${uid}`} aria-selected="true" data-view="log">Execution</button>
      <button type="button" role="tab" class="g-view" id={`rec-tab-${uid}`} aria-controls={`rec-${uid}`} aria-selected="false" tabindex="-1" data-view="record">Executions list <span class="g-view-dot" data-rec-dot hidden aria-hidden="true"></span></button>
    </div>
    <div role="tabpanel" id={`log-${uid}`} aria-labelledby={`log-tab-${uid}`} data-view-panel="log">
      <ol class="g-log" data-log tabindex="0" aria-label="Execution log">
        <li class="g-log-empty">{empty}</li>
      </ol>
    </div>
    <div role="tabpanel" id={`rec-${uid}`} aria-labelledby={`rec-tab-${uid}`} data-view-panel="record" hidden>
      <div class="g-record" data-record></div>
    </div>
    <p class="sr-only" role="status" data-announce></p>
  </div>
</div>
