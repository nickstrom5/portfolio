---
/**
 * One case study: the business, the working test form first, then
 * every workflow with its simulator and build notes. Ids are prefixed with
 * the case id so three of these can live on one page.
 */
import type { CaseStudy } from '@/lib/n8n/types';
import { countNodes } from '@/lib/n8n/engine';
import DemoForm from './DemoForm.astro';
import AutomationPanel from './AutomationPanel.astro';

interface Props {
  study: CaseStudy;
  index: number;
  hidden?: boolean;
}
const { study, index, hidden = false } = Astro.props;
const { business: b, demo, automations } = study;
const fed = automations.find((a) => a.id === demo.feeds);
const feedsName = fed ? `workflow ${fed.number} · ${fed.name}` : 'the first workflow';
const nodes = automations.reduce((n, a) => n + countNodes(a), 0);
const names = Object.fromEntries(automations.map((a) => [a.id, a.workflow.name]));
---

<section
  class="gx-case"
  id={b.id}
  role="tabpanel"
  aria-labelledby={`case-tab-${b.id}`}
  hidden={hidden}
  data-case-panel={b.id}
  style={`--case: ${b.tint.light}; --case-dark: ${b.tint.dark}`}
>
  <header class="gx-case-head">
    <div class="container">
      <span class="eyebrow gx-case-eyebrow">Case study {index + 1} · {b.industry}</span>
      <h2>{b.name}</h2>
      <p class="lede">{b.intro}</p>
      <dl class="gx-case-facts">
        <div><dt>Workflows</dt><dd>{automations.length}</dd></div>
        <div><dt>Nodes</dt><dd>{nodes}</dd></div>
        <div><dt>Test events</dt><dd>{automations.reduce((n, a) => n + a.scenarios.length, 0)}</dd></div>
        <div><dt>Where</dt><dd class="gx-small">{b.area}</dd></div>
      </dl>
      <details class="gx-notes-more n-about">
        <summary>The team, where n8n runs and the apps it connects</summary>
        <div class="gx-team">
          <p class="gx-team-title">The sample team</p>
          <ul>
            {b.team.map((m) => <li><strong>{m.name}</strong> <span>{m.role}</span></li>)}
          </ul>
        </div>
        <div class="gx-team n-host">
          <p class="gx-team-title">Where n8n runs</p>
          <p>{b.hosting}</p>
          <p class="n-stack" aria-label="Apps connected">{b.stack.map((x) => <span class="gx-stage">{x}</span>)}</p>
        </div>
      </details>
      <p class="gx-disclaimer">{b.disclaimer}</p>
      <ul class="gx-jump" aria-label={`Jump to a part of the ${b.name} case study`}>
        <li><a href={`#${b.id}-demo`} data-open-auto={`${b.id}-demo`}>Try the form</a></li>
        <li><a href={`#${b.id}-workflows`} data-open-auto={`${b.id}-workflows`}>The workflows</a></li>
      </ul>
    </div>
  </header>

  <div class="section" id={`${b.id}-demo`}>
    <div class="container">
      <span class="eyebrow">Live demo</span>
      <h3 class="gx-h3">Try it: send the workflow your own answers</h3>
      <p class="lede">Fill it in as a customer would, press {demo.submitLabel}, then watch {feedsName} run on your answers. Nothing is sent or stored.</p>
      <DemoForm caseId={b.id} demo={demo} feedsName={feedsName} triggerType={fed?.workflow.trigger.type ?? 'trigger'} />
      <div class="gx-landing-notes">
        <p class="gx-notes-plain">How the form reaches n8n, and the settings that matter.</p>
        <details class="gx-notes-more">
          <summary>How it is set up <span class="g-count">({demo.notes.length} notes for builders)</span></summary>
          <ul class="gx-note-grid">
            {demo.notes.map((n) => <li><strong>{n.title}</strong><span>{n.body}</span></li>)}
          </ul>
        </details>
      </div>
    </div>
  </div>

  <div class="section gx-workflows" id={`${b.id}-workflows`}>
    <div class="container">
      <span class="eyebrow">The workflows</span>
      <h3 class="gx-h3">Pick a workflow, pick a test event, press Execute</h3>
      <p class="lede">Each tab is one workflow. The problem and What I built are the short version; pick a test event and press Execute workflow to watch it run.</p>
      <p class="gx-builder-note">For n8n builders: the simulator follows n8n’s rules. Nodes run once per item, an If or Switch can send items down several outputs in one execution, v1 order finishes each branch before the next, a node with no input items does not run, branches meet at a Merge, and a failed production execution starts the error workflow. <a href="#decoder">New to the words? Open the decoder.</a></p>
      <div class="gx-tabs" role="tablist" aria-label={`${b.name} workflows`} data-case-tabs={b.id}>
        {automations.map((a, i) => (
          <button
            class="gx-tab"
            role="tab"
            type="button"
            id={`tab-${b.id}-${a.id}`}
            aria-controls={`${b.id}-${a.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-tab={a.id}
          >
            <span class="gx-tab-num">{a.number}</span>
            <span class="gx-tab-name">{a.name}</span>
            <span class="gx-tab-kicker">{a.kicker}</span>
          </button>
        ))}
      </div>
      {automations.map((a, i) => <AutomationPanel automation={a} caseId={b.id} names={names} hidden={i !== 0} />)}
    </div>
  </div>
</section>
