---
/**
 * A showcase screenshot. Files in src/assets/showcase/ render as a responsive
 * <picture> (AVIF and WebP at the given widths, JPEG fallback); any other path
 * renders as a plain <img>. `src` is the public-style path the data uses
 * ('/showcase/x.jpg', with or without the base), matched by file name.
 * Extra attributes (class, the caller's scoped-style attribute) go on the <img>.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

const shots = import.meta.glob<{ default: ImageMetadata }>('/src/assets/showcase/*.{jpg,jpeg,png}', { eager: true });

interface Props {
  src: string;
  alt: string;
  /** Used only for the plain <img> fallback; a picture takes the file's own size. */
  width: number;
  height: number;
  widths: number[];
  sizes: string;
  loading?: 'lazy' | 'eager';
  [attr: string]: unknown;
}
const { src, alt, width, height, widths, sizes, loading = 'lazy', ...attrs } = Astro.props;
const asset = shots[`/src/assets/showcase/${src.split('/').pop()}`]?.default;
---

{asset ? (
  <Picture src={asset} alt={alt} widths={widths} sizes={sizes} formats={['avif', 'webp']} loading={loading} decoding="async" pictureAttributes={{ class: 'shot-pic' }} {...attrs} />
) : (
  <img src={src} alt={alt} width={width} height={height} loading={loading} decoding="async" {...attrs} />
)}
