---
/**
 * One automation: the story, then its body (the editor and simulator, and the
 * build notes). A deferred panel keeps the story in the HTML and leaves a slot
 * for the body, which loads when the automation is opened.
 */
import type { Automation } from '@/lib/airtable/types';
import Part from '@/components/ghl/Part.astro';
import AutomationBody from './AutomationBody.astro';

interface Props {
  automation: Automation;
  caseId: string;
  hidden?: boolean;
  /** Leave the body out of the HTML (src/lib/parts.ts). */
  deferred?: boolean;
}
const { automation: a, caseId, hidden = false, deferred = false } = Astro.props;
const uid = `${caseId}-${a.id}`;
---

<div class="gx-panel" id={uid} role="tabpanel" aria-labelledby={`tab-${uid}`} hidden={hidden} data-panel={a.id}>
  <header class="gx-panel-head">
    <span class="eyebrow">{a.number} · {a.kicker}</span>
    <h4 tabindex="-1" data-panel-heading>{a.name}</h4>
    <p class="gx-tagline">{a.tagline}</p>
  </header>

  <div class="gx-ps">
    <div>
      <h5>The problem</h5>
      <p>{a.problem}</p>
    </div>
    <div>
      <h5>What I built</h5>
      <p>{a.solution}</p>
    </div>
  </div>

  {deferred ? <Part id={`${caseId}/${a.id}`} what="the editor, simulator and build notes" /> : <AutomationBody automation={a} caseId={caseId} />}
</div>
