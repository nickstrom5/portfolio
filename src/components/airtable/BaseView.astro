---
/**
 * A case's base as a builder would review it: how its tables link, every
 * table with its fields, views and sample records (BaseTables), the
 * interfaces and syncs. A deferred base leaves a slot for the tables, which
 * load when the case is opened (src/lib/parts.ts).
 */
import type { BaseSchema } from '@/lib/airtable/types';
import Part from '@/components/ghl/Part.astro';
import BaseTables from './BaseTables.astro';
import Icon from './Icon.astro';

interface Props {
  caseId: string;
  base: BaseSchema;
  /** Leave the tables out of the HTML. */
  deferred?: boolean;
}
const { caseId, base, deferred = false } = Astro.props;

const links = base.tables.flatMap((t) => t.fields.filter((f) => f.type === 'Link to another record' && !f.mirror).map((f) => `${t.name} › ${f.name} → ${f.link}`));
---

<div class="section a-base-section" id={`${caseId}-base`}>
  <div class="container">
    <span class="eyebrow">The base</span>
    <h3 class="gx-h3">{base.name}: {base.tables.length} tables, linked</h3>
    <p class="lede">Every table, field and view the automations rely on. Links are what make it a database rather than a spreadsheet: a lookup reads a field through a link, a rollup adds up or picks from linked records, a count counts them, and a formula works from the record’s own fields. The sample records below are computed by the same code as the simulator.</p>
    <p class="a-links" aria-label="Links between tables">{links.map((l) => <span class="gx-stage"><Icon name="link" size={13} /> {l}</span>)}</p>

    {deferred ? <Part id={`${caseId}/base`} what="the tables" /> : <BaseTables base={base} />}

    <h4 class="a-sub">Interfaces</h4>
    <div class="a-interfaces">
      {base.interfaces.map((x) => (
        <div class="card a-interface">
          <h5><Icon name="layout" /> {x.name}</h5>
          <p class="a-note">{x.audience}</p>
          <ul>
            {x.pages.map((p) => (
              <li><strong>{p.name}</strong> <span class="a-type">{p.layout}</span><span>{p.purpose}</span><span class="a-view-setup">{p.elements.join(' · ')}</span></li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    {base.syncs.length > 0 && (
      <>
        <h4 class="a-sub">Sync</h4>
        <ul class="a-syncs">
          {base.syncs.map((s) => (
            <li><Icon name="sync" /> <strong>{s.table}</strong> {s.direction === 'in' ? `synced in from ${s.other}` : `synced out to ${s.other}`}. {s.note}</li>
          ))}
        </ul>
      </>
    )}
  </div>
</div>
