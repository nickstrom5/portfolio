---
/**
 * One case study: the business, its base, the working form and every
 * automation with its simulator and build notes. Ids are prefixed with the
 * case id so three of these can live on one page.
 */
import type { CaseStudy } from '@/lib/airtable/types';
import { countSteps } from '@/lib/airtable/engine';
import BaseView from './BaseView.astro';
import DemoForm from './DemoForm.astro';
import AutomationPanel from './AutomationPanel.astro';
import Icon from './Icon.astro';

interface Props {
  study: CaseStudy;
  index: number;
  hidden?: boolean;
}
const { study, index, hidden = false } = Astro.props;
const { business: b, base, demo, automations } = study;
const fed = automations.find((a) => a.id === demo.feeds);
const feedsName = fed ? `automation ${fed.number} · ${fed.name}` : 'the first automation';
const fields = base.tables.reduce((n, t) => n + t.fields.length, 0);
---

<section
  class="gx-case"
  id={b.id}
  role="tabpanel"
  aria-labelledby={`case-tab-${b.id}`}
  hidden={hidden}
  data-case-panel={b.id}
  style={`--case: ${b.tint.light}; --case-dark: ${b.tint.dark}`}
>
  <header class="gx-case-head">
    <div class="container">
      <span class="eyebrow gx-case-eyebrow">Case study {index + 1} · {b.industry}</span>
      <h2>{b.name}</h2>
      <p class="lede">{b.intro}</p>
      <dl class="gx-case-facts">
        <div><dt>Tables</dt><dd>{base.tables.length}</dd></div>
        <div><dt>Fields</dt><dd>{fields}</dd></div>
        <div><dt>Automations</dt><dd>{automations.length}</dd></div>
        <div><dt>Test events</dt><dd>{automations.reduce((n, a) => n + a.scenarios.length, 0)}</dd></div>
        <div><dt>Where</dt><dd class="gx-small">{b.area}</dd></div>
      </dl>
      <div class="gx-team">
        <p class="gx-team-title">The sample team</p>
        <ul>
          {b.team.map((m) => <li><strong>{m.name}</strong> <span>{m.role}</span></li>)}
        </ul>
      </div>
      <div class="gx-team n-host">
        <p class="gx-team-title">How the base is set up</p>
        <p>{b.setup}</p>
        <p class="n-stack" aria-label="What it uses">{b.stack.map((s) => <span class="gx-stage">{s}</span>)}</p>
      </div>
      <p class="gx-disclaimer">{b.disclaimer}</p>
      <ul class="gx-jump" aria-label={`Jump to a part of the ${b.name} case study`}>
        <li><a href={`#${b.id}-base`} data-open-auto={`${b.id}-base`}>The base</a></li>
        <li><a href={`#${b.id}-journey`} data-open-auto={`${b.id}-journey`}>The system</a></li>
        <li><a href={`#${b.id}-demo`} data-open-auto={`${b.id}-demo`}>The form</a></li>
        <li><a href={`#${b.id}-workflows`} data-open-auto={`${b.id}-workflows`}>The automations</a></li>
      </ul>
    </div>
  </header>

  <BaseView caseId={b.id} base={base} />

  <div class="section gx-journey-section" id={`${b.id}-journey`}>
    <div class="container">
      <span class="eyebrow">The system</span>
      <h3 class="gx-h3">Three automations, one way of working</h3>
      <p class="lede">Each automation does one job. The line with the lightning bolt on each card is its trigger: a form, a record that starts to match, a field that changes, or a schedule. Pick a card to open that automation below.</p>
      <ol class="gx-journey" data-count={automations.length}>
        {automations.map((a) => (
          <li>
            <a href={`#${b.id}-${a.id}`} data-open-auto={`${b.id}-${a.id}`} class="gx-j n-j">
              <span class="gx-j-num">{a.number}</span>
              <span class="gx-j-name">{a.name}</span>
              <span class="gx-j-trigger"><Icon name="bolt" size={14} />{a.trigger.type}</span>
              <span class="gx-j-out">{b.handoff[a.id] ?? a.kicker}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </div>

  <div class="section" id={`${b.id}-demo`}>
    <div class="container">
      <span class="eyebrow">Live demo</span>
      <h3 class="gx-h3">Fill in the base’s form yourself</h3>
      <p class="lede">This is the base’s form view. Fill it in and press {demo.submitLabel}. Use any name and a made-up email: nothing is sent or stored. Then press Watch the automation run, which appears once you submit, to see every step {feedsName} takes on your record, what it writes to the base and what each person would receive.</p>
      <DemoForm caseId={b.id} demo={demo} feedsName={feedsName} triggerType={fed?.trigger.type ?? 'form'} />
      <div class="gx-landing-notes">
        <p class="gx-notes-plain">How the form is set up in Airtable, and the settings that matter.</p>
        <details class="gx-notes-more">
          <summary>How it is set up <span class="g-count">({demo.notes.length} notes for builders)</span></summary>
          <ul class="gx-note-grid">
            {demo.notes.map((n) => <li><strong>{n.title}</strong><span>{n.body}</span></li>)}
          </ul>
        </details>
      </div>
    </div>
  </div>

  <div class="section gx-workflows" id={`${b.id}-workflows`}>
    <div class="container">
      <span class="eyebrow">The automations</span>
      <h3 class="gx-h3">Pick an automation, pick a test event, press Run</h3>
      <p class="lede">Each tab below is one automation. Read The problem and What I built for the short version. Then pick a test event and press Run automation: the log lists every step in order, with the time it ran and what it changed in the base, and the editor ticks off each step as it runs.</p>
      <p class="gx-builder-note">For Airtable builders: the simulator follows Airtable’s rules. A “matches conditions” trigger fires only when a record starts to match; a conditional group runs its actions only when its conditions are met; a repeating group runs once per item; computed and synced fields cannot be written; and a failed action stops the run without undoing earlier steps. This case has {automations.reduce((n, a) => n + countSteps(a), 0)} steps across its automations, triggers included. <a href="#decoder">New to the words? Open the decoder.</a></p>
      <div class="gx-tabs" role="tablist" aria-label={`${b.name} automations`} data-case-tabs={b.id}>
        {automations.map((a, i) => (
          <button
            class="gx-tab"
            role="tab"
            type="button"
            id={`tab-${b.id}-${a.id}`}
            aria-controls={`${b.id}-${a.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-tab={a.id}
          >
            <span class="gx-tab-num">{a.number}</span>
            <span class="gx-tab-name">{a.name}</span>
            <span class="gx-tab-kicker">{a.kicker}</span>
          </button>
        ))}
      </div>
      {automations.map((a, i) => <AutomationPanel automation={a} caseId={b.id} hidden={i !== 0} />)}
    </div>
  </div>
</section>
