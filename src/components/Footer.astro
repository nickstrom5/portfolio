---
import { site, footerNav } from '@/data/site';
import { url } from '@/lib/url';

const year = new Date().getFullYear();
const social = [
  { label: 'Upwork', href: site.links.upwork },
  { label: 'LinkedIn', href: site.links.linkedin },
  { label: 'GitHub', href: site.links.github },
].filter((s) => s.href && !s.href.includes('REPLACE'));
---

<footer class="footer">
  <div class="container footer-inner">
    <div>
      <p class="footer-name">{site.name}</p>
      <p class="muted footer-role">{site.role}</p>
      <a class="footer-mail" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
    <nav aria-label="Footer">
      <ul>
        {footerNav.map((item) => (
          <li><a href={url(item.href)}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    {social.length > 0 && (
      <nav aria-label="Social">
        <ul>
          {social.map((s) => (
            <li><a href={s.href} rel="me noopener" target="_blank">{s.label}</a></li>
          ))}
        </ul>
      </nav>
    )}
  </div>
  <div class="container copy muted">© {year} {site.name}. All rights reserved.</div>
</footer>

<script>
  // A mailto: link does nothing visible when the visitor's browser has no mail app set up.
  // So every email link also copies the address and says so; the mailto still fires for
  // people who do have one.
  let toast: HTMLElement | undefined;
  let timer: number | undefined;
  function say(text: string) {
    if (!toast) {
      toast = document.createElement('div');
      toast.className = 'mail-toast';
      toast.setAttribute('role', 'status');
      document.body.append(toast);
    }
    toast.textContent = text;
    toast.classList.add('show');
    window.clearTimeout(timer);
    timer = window.setTimeout(() => toast?.classList.remove('show'), 4000);
  }
  document.addEventListener('click', (e) => {
    const link = (e.target as Element | null)?.closest?.('a[href^="mailto:"]');
    if (!link) return;
    const address = decodeURIComponent((link.getAttribute('href') || '').slice(7).split('?')[0]);
    if (!address) return;
    navigator.clipboard?.writeText(address).then(
      () => say(`Copied ${address}`),
      () => say(`Email me at ${address}`),
    ) ?? say(`Email me at ${address}`);
  });
</script>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding-block: 2.5rem 1.5rem;
    margin-top: 0;
    font-size: 0.95rem;
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 2rem;
  }
  .footer-name {
    font-weight: 700;
    margin-bottom: 0.15rem;
  }
  .footer-role {
    margin-bottom: 0.5rem;
  }
  .footer-mail {
    word-break: break-all;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }
  li a {
    color: var(--text-muted);
  }
  li a:hover {
    color: var(--text);
  }
  .copy {
    margin-top: 2rem;
    font-size: 0.85rem;
  }
  @media (max-width: 640px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
  :global(.mail-toast) {
    position: fixed;
    left: 50%;
    bottom: 1.25rem;
    z-index: 60;
    max-width: calc(100vw - 2rem);
    padding: 0.6rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-elev);
    color: var(--text);
    box-shadow: var(--shadow);
    font-size: 0.95rem;
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 0.5rem);
    transition: opacity 0.2s, transform 0.2s, visibility 0.2s;
  }
  :global(.mail-toast.show) {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }
</style>
