---
/**
 * The heavy half of a Zap panel: the editor and simulator side by side, then
 * the build notes. ZapPanel renders it inline for the first Zap a visitor
 * sees; every other one loads from /zapier/parts/<case>.json.
 */
import type { AppStep, Zap } from '@/lib/zapier/types';
import { allSteps, stepNumbers } from '@/lib/zapier/engine';
import Editor from './Editor.astro';
import Simulator from './Simulator.astro';
import Icon from './Icon.astro';

interface Props {
  zap: Zap;
  caseId: string;
}
const { zap: z, caseId } = Astro.props;
const uid = `${caseId}-${z.id}`;
const numbers = stepNumbers(z);
const coded = allSteps(z.steps).filter((s): s is AppStep => s.kind === 'action' && !!s.code);
// "What if…" leads: the unusual cases in plain words are what most readers want first.
const notes = [
  { key: 'edges', label: `What if… (${z.edgeCases.length})` },
  { key: 'build', label: 'How I built it' },
  { key: 'model', label: 'Fields it uses' },
  { key: 'qa', label: `Test plan (${z.qa.length})` },
  ...(coded.length ? [{ key: 'snips', label: coded.length === 1 ? 'The code step' : 'The code steps' }] : []),
];
---

<div class="gx-lab">
  <div class="gx-lab-canvas">
    <Editor zap={z} caseId={caseId} />
  </div>
  <div class="gx-lab-sim">
    <Simulator zap={z} caseId={caseId} />
  </div>
</div>

<div class="gx-notes">
  <h5 class="gx-notes-title">Build notes</h5>
  <p class="gx-notes-intro">The detail a Zapier builder would check before trusting this Zap. Start with What if… for the unusual cases in plain words. <a href="#decoder">Words you may not know</a></p>
  <div class="gx-note-tabs" role="tablist" aria-label={`Build notes for ${z.name}`} data-note-tabs>
    {notes.map((n, i) => (
      <button type="button" role="tab" class="gx-note-tab" id={`nt-${uid}-${n.key}`} aria-controls={`np-${uid}-${n.key}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-note-tab={n.key}>{n.label}</button>
    ))}
  </div>

  <div class="gx-note-panel gx-edges" role="tabpanel" id={`np-${uid}-edges`} aria-labelledby={`nt-${uid}-edges`} data-note-panel="edges">
    <ul class="gx-edge-list">
      {z.edgeCases.map((e) => (
        <li><strong>{e.title}</strong><span>{e.body}</span></li>
      ))}
    </ul>
  </div>

  <div class="gx-note-panel gx-build" role="tabpanel" id={`np-${uid}-build`} aria-labelledby={`nt-${uid}-build`} data-note-panel="build" hidden>
    <ol class="gx-build-list">
      {z.build.map((b) => (
        <li><strong>{b.title}.</strong> {b.body}</li>
      ))}
    </ol>
  </div>

  <div class="gx-note-panel gx-model" role="tabpanel" id={`np-${uid}-model`} aria-labelledby={`nt-${uid}-model`} data-note-panel="model" hidden>
    <div class="gx-table-wrap">
      <table class="gx-table">
        <caption class="sr-only">Fields the Zap reads or writes</caption>
        <thead><tr><th scope="col">App</th><th scope="col">Field</th><th scope="col">How it is used</th></tr></thead>
        <tbody>
          {z.fields.map((f) => (
            <tr><td>{f.app}</td><td><code>{f.field}</code></td><td>{f.use}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="n-cred-note">{z.owner} owns this Zap and gets Zapier’s error emails. Autoreplay is {z.autoreplay ? 'on: a step that errors is tried again up to 5 times before anyone is emailed' : 'off for this Zap, because a step with an error handler deals with the failure itself'}. Every run is kept in Zap history with what each step received and returned.</p>
  </div>

  <div class="gx-note-panel gx-qa" role="tabpanel" id={`np-${uid}-qa`} aria-labelledby={`nt-${uid}-qa`} data-note-panel="qa" hidden>
    <ul class="gx-qa-list">
      {z.qa.map((q) => (
        <li><Icon name="check" size={16} /><span>{q}</span></li>
      ))}
    </ul>
  </div>

  {coded.length > 0 && (
    <div class="gx-note-panel gx-snips" role="tabpanel" id={`np-${uid}-snips`} aria-labelledby={`nt-${uid}-snips`} data-note-panel="snips" hidden>
      <div class="gx-snip-grid">
        {coded.map((x) => (
          <div class="g-snippet">
            <div class="g-snippet-head">
              <h6>Step {numbers.get(x.id)} · {x.title}</h6>
              <button type="button" class="g-copy" data-copy aria-label={`Copy the code for ${x.title}`}><Icon name="copy" size={15} /><span aria-hidden="true">Copy</span></button>
            </div>
            <pre data-lang={x.code!.language}><code>{x.code!.source}</code></pre>
            <p>{x.summary}</p>
          </div>
        ))}
      </div>
    </div>
  )}

  <div class="gx-features">
    <p class="gx-features-title">Zapier features in this build</p>
    <ul class="tags">
      {z.features.map((f) => <li class="tag">{f}</li>)}
    </ul>
  </div>
</div>
