---
/** The closing "get in touch" band: a heading, one line, a button to Contact and one to the résumé. */
import { url } from '@/lib/url';

interface Props {
  title?: string;
  text?: string;
  label?: string;
  href?: string;
}
const {
  // The site is for hiring teams as well as project clients, so the default speaks to both.
  title = 'Hiring, or have a project in mind?',
  text = "Tell me about the role or what needs to run better, and I'll reply within one business day.",
  label = 'Get in touch',
  href = '/contact',
} = Astro.props;
---

<section class="section cta-band">
  <div class="container cta-inner">
    <div>
      <h2>{title}</h2>
      <p class="muted">{text}</p>
    </div>
    <div class="cta-actions">
      <a class="btn btn-primary" href={url(href)}>{label}</a>
      <a class="btn btn-secondary" href={url('/resume')}>Resume</a>
    </div>
  </div>
</section>

<style>
  /* The line keeps it apart from a grey section above it, e.g. a story's "Follow" band. */
  .cta-band {
    background: var(--bg-muted);
    border-top: 1px solid var(--border);
  }
  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .cta-inner h2 {
    margin-bottom: 0.25rem;
  }
  .cta-inner p {
    margin: 0;
  }
</style>
